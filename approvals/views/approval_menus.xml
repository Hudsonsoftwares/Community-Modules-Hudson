<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="approval_menu_root" name="Approvals" web_icon="approvals,static/description/icon.png"
              sequence="120"/>

    <menuitem id="approval_menu_dashboard" name="Dashboard"
              parent="approval_menu_root" action="approval_category_action" sequence="10"/>

    <!-- My Approvals Menu Structure -->
    <menuitem id="approval_menu_my_approvals" name="My Approvals"
              parent="approval_menu_root" sequence="20"/>
              
    <menuitem id="approval_menu_my_requests" name="My Requests"
              parent="approval_menu_my_approvals" action="approval_request_action_my" sequence="10"/>

    <!-- Manager Menu Structure -->
    <menuitem id="approval_menu_manager" name="Manager"
              parent="approval_menu_root" sequence="30"/>
              
    <menuitem id="approval_menu_to_review" name="Approvals to Review"
              parent="approval_menu_manager" action="approval_request_action_to_approve" sequence="10"/>

    <menuitem id="approval_menu_all_requests" name="All Approvals" groups="approvals.group_approval_manager"
              parent="approval_menu_manager" action="approval_request_action_all" sequence="20"/>

    <menuitem id="approval_menu_configuration" name="Configuration"
              parent="approval_menu_root" groups="approvals.group_approval_manager" sequence="100"/>

    <menuitem id="approval_menu_categories" name="Approval Categories"
              parent="approval_menu_configuration" action="approval_category_action_config" sequence="10"/>

    <menuitem id="approval_menu_product_parent" name="Products"
              parent="approval_menu_configuration" sequence="20"/>

    <menuitem id="approval_menu_product" name="Products"
              parent="approval_menu_product_parent" action="product.product_template_action" sequence="10"/>
</odoo>
