<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form" model="ir.ui.view">
        <field name="name">approval.category.form</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <form string="Approval Category">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="list_alt">
                            <field name="approval_request_count" widget="statinfo" string="Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Approval Category"/>
                        <h1><field name="name" placeholder="e.g. Purchase Approval"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="create_rfq"/>
                        <field name="automated_sequence"/>
                    </group>
                    <notebook>
                        <page string="Options" name="options">
                            <group>
                                <group string="CONFIGURATION">
                                    <field name="requirer_document" string="Document" widget="radio" options="{'horizontal': true}"/>
                                    <field name="has_partner" string="Contact" widget="radio" options="{'horizontal': true}"/>
                                    <field name="date" widget="radio" options="{'horizontal': true}"/>
                                    <field name="date_start" string="Period" widget="radio" options="{'horizontal': true}"/>
                                    <field name="line_type" string="Product" widget="radio" options="{'horizontal': true}" readonly="create_rfq" force_save="1"/>
                                    <field name="quantity" widget="radio" options="{'horizontal': true}" readonly="create_rfq" force_save="1"/>
                                    <field name="amount" widget="radio" options="{'horizontal': true}"/>
                                    <field name="reference" widget="radio" options="{'horizontal': true}"/>
                                    <field name="location" widget="radio" options="{'horizontal': true}"/>
                                </group>
                                <group string="APPROVERS">
                                    <field name="is_manager_approver"/>
                                    <field name="user_ids" nolabel="1" colspan="2">
                                        <list editable="bottom">
                                            <field name="user_id"/>
                                            <field name="required"/>
                                        </list>
                                    </field>
                                    <field name="approval_minimum"/>
                                    <field name="invalid_minimum" invisible="1"/>
                                    <div colspan="2" class="text-warning mt-2 mb-2" invisible="not invalid_minimum">
                                        <i class="fa fa-warning"/> Your minimum approval exceeds the total of default approvers.
                                    </div>
                                    <field name="approval_type" widget="radio"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_category_view_list" model="ir.ui.view">
        <field name="name">approval.category.list</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <list string="Approval Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approval_type"/>
                <field name="approval_minimum"/>
                <field name="approval_request_count" string="Requests"/>
            </list>
        </field>
    </record>

    <record id="approval_category_view_kanban" model="ir.ui.view">
        <field name="name">approval.category.kanban</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" on_create="approvals.approval_request_action_new" records_clickable="0" action="action_dummy" type="object">
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="request_to_validate_count"/>
                <field name="approval_request_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <style>
                            .o_kanban_record { cursor: default !important; }
                        </style>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="d-flex p-2 h-100">
                                <!-- Image Container -->
                                <div class="me-3 bg-white d-flex align-items-center justify-content-center rounded" style="width: 64px; height: 64px; border: 1px solid rgba(0,0,0,0.1);">
                                    <t t-if="record.image.raw_value">
                                        <field name="image" widget="image" class="o_image_64_max"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-folder-o fa-2x text-muted" title="No Image"/>
                                    </t>
                                </div>
                                <!-- Content Container -->
                                <div class="d-flex flex-column justify-content-between flex-grow-1">
                                    <!-- Top Row: Title & Ellipsis -->
                                    <div class="d-flex justify-content-between align-items-start">
                                        <strong class="o_kanban_record_title fs-6"><field name="name"/></strong>
                                        <div class="o_dropdown_kanban dropdown" groups="approvals.group_approval_manager" style="cursor: pointer; visibility: visible !important;">
                                            <a class="dropdown-toggle btn btn-link text-muted px-2 o-no-caret" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                                <i class="fa fa-ellipsis-v"/>
                                            </a>
                                            <div class="dropdown-menu" role="menu">
                                                <a role="menuitem" type="object" name="action_edit" class="dropdown-item">Edit</a>
                                                <a t-if="record.active.raw_value" role="menuitem" type="archive" class="dropdown-item">Archive</a>
                                                <a t-if="!record.active.raw_value" role="menuitem" type="unarchive" class="dropdown-item">Restore</a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Bottom Row: Buttons -->
                                    <div class="d-flex justify-content-between align-items-end mt-3">
                                        <button name="create_request" type="object" class="btn btn-primary btn-sm">New Request</button>
                                        <button name="action_view_requests" type="object" class="btn btn-secondary btn-sm" style="opacity: 0.85;">To Review: <t t-out="record.request_to_validate_count.value"/></button>
                                    </div>
                                </div>
                            </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="approval_category_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <record id="approval_category_action_config" model="ir.actions.act_window">
        <field name="name">Approval Categories</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
