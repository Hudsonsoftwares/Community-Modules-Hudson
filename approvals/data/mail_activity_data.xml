<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Reuses mail.mail_activity_data_todo as the default activity type
         scheduled for approvers. Kept here in case a dedicated
         "To Approve" activity type is wanted later. -->
    <record id="mail_activity_type_approval" model="mail.activity.type">
        <field name="name">To Approve</field>
        <field name="icon">fa-check-square-o</field>
        <field name="category">default</field>
        <field name="sequence">100</field>
    </record>
</odoo>
