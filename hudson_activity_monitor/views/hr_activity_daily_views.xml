<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_activity_daily_view_list" model="ir.ui.view">
        <field name="name">hr.activity.daily.list</field>
        <field name="model">hr.activity.daily</field>
        <field name="arch" type="xml">
            <list string="Daily Activity" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="hide"/>
                <field name="first_seen" optional="show"/>
                <field name="last_seen" optional="show"/>
                <field name="attendance_hours" widget="float_time" sum="Total" optional="show"/>
                <field name="active_hours" widget="float_time" sum="Total"/>
                <field name="idle_hours" widget="float_time" sum="Total"/>
                <field name="locked_hours" widget="float_time" sum="Total" optional="hide"/>
                <field name="productive_hours" widget="float_time" sum="Total" optional="show"/>
                <field name="unproductive_hours" widget="float_time" sum="Total" optional="hide"/>
                <field name="activity_pct" widget="progressbar" optional="show"/>
                <field name="productivity_pct" widget="progressbar" optional="show"/>
                <field name="top_app_id" optional="show"/>
                <button name="action_open_timeline" type="object" icon="schedule" title="Timeline"/>
            </list>
        </field>
    </record>

    <record id="hr_activity_daily_view_form" model="ir.ui.view">
        <field name="name">hr.activity.daily.form</field>
        <field name="model">hr.activity.daily</field>
        <field name="arch" type="xml">
            <form string="Daily Activity" create="0" edit="0" delete="0">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_timeline" type="object" class="oe_stat_button" icon="schedule">
                            <div class="o_stat_info"><span class="o_stat_text">Timeline</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <h3><field name="date" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Time">
                            <field name="attendance_hours" widget="float_time"/>
                            <field name="active_hours" widget="float_time"/>
                            <field name="idle_hours" widget="float_time"/>
                            <field name="locked_hours" widget="float_time"/>
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                        </group>
                        <group string="Productivity">
                            <field name="productive_hours" widget="float_time"/>
                            <field name="neutral_hours" widget="float_time"/>
                            <field name="unproductive_hours" widget="float_time"/>
                            <field name="activity_pct" widget="progressbar"/>
                            <field name="productivity_pct" widget="progressbar"/>
                            <field name="top_app_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_activity_daily_view_pivot" model="ir.ui.view">
        <field name="name">hr.activity.daily.pivot</field>
        <field name="model">hr.activity.daily</field>
        <field name="arch" type="xml">
            <pivot string="Daily Activity" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="active_hours" type="measure" widget="float_time"/>
                <field name="idle_hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="hr_activity_daily_view_graph" model="ir.ui.view">
        <field name="name">hr.activity.daily.graph</field>
        <field name="model">hr.activity.daily</field>
        <field name="arch" type="xml">
            <graph string="Daily Activity" type="bar" stacked="1" sample="1">
                <field name="date" interval="day"/>
                <field name="employee_id"/>
                <field name="active_hours" type="measure" widget="float_time"/>
            </graph>
        </field>
    </record>

    <record id="hr_activity_daily_view_search" model="ir.ui.view">
        <field name="name">hr.activity.daily.search</field>
        <field name="model">hr.activity.daily</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel view_types="list,pivot,graph">
                    <field name="employee_id" icon="person" enable_counters="1"/>
                    <field name="department_id" icon="group" enable_counters="1"/>
                </searchpanel>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="yesterday" string="Yesterday"
                        domain="[('date', '=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_30_days" string="Last 30 Days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_date" string="Date" date="date"/>
                <separator/>
                <filter name="my_team" string="My Team" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="group_week" string="Week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_activity_daily" model="ir.actions.act_window">
        <field name="name">Daily Summary</field>
        <field name="res_model">hr.activity.daily</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_last_7_days': 1, 'search_default_group_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity recorded yet</p>
            <p>Open an employee, go to the Activity Monitoring tab and click "Pair Device".</p>
        </field>
    </record>

    <record id="action_hr_activity_daily_my" model="ir.actions.act_window">
        <field name="name">My Activity</field>
        <field name="res_model">hr.activity.daily</field>
        <field name="view_mode">list,graph,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_last_30_days': 1}</field>
    </record>

    <record id="action_hr_activity_daily_refresh" model="ir.actions.server">
        <field name="name">Recompute last 31 days</field>
        <field name="model_id" ref="model_hr_activity_daily"/>
        <field name="binding_model_id" ref="model_hr_activity_daily"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_activity_admin'))]"/>
        <field name="state">code</field>
        <field name="code">model.action_refresh_all()</field>
    </record>
</odoo>
