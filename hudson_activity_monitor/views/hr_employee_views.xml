<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_activity" model="ir.ui.view">
        <field name="name">hr.employee.form.activity.monitor</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_activity" type="object" class="oe_stat_button" icon="timer"
                        groups="hudson_activity_monitor.group_activity_admin" invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="activity_today_hours" widget="float_time"/></span>
                        <span class="o_stat_text">Active Today</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="before">
                <page name="activity_monitoring" string="Activity Monitoring"
                      groups="hudson_activity_monitor.group_activity_admin">
                    <group>
                        <group>
                            <field name="activity_monitoring_enabled" widget="boolean_toggle"/>
                            <field name="activity_consent_date"/>
                        </group>
                        <group>
                            <field name="activity_status" widget="badge"
                                   decoration-success="activity_status == 'active'"
                                   decoration-warning="activity_status in ('idle', 'locked', 'paused')"
                                   decoration-danger="activity_status == 'revoked'"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_activity_pair_device" type="object" string="Pair Device"
                                class="btn-primary" icon="link" invisible="not id"/>
                    </div>
                    <field name="activity_device_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-warning="status in ('idle', 'locked', 'paused')"
                                   decoration-danger="status == 'revoked'"
                                   decoration-info="status == 'pending'"/>
                            <field name="last_seen"/>
                            <field name="os_name"/>
                            <field name="agent_version" optional="hide"/>
                            <field name="state" column_invisible="1"/>
                            <button name="action_revoke" type="object" icon="link_off" title="Revoke"
                                    invisible="state == 'revoked'"
                                    confirm="The agent on this computer will stop tracking. Continue?"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
