<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_activity_device_view_list" model="ir.ui.view">
        <field name="name">hr.activity.device.list</field>
        <field name="model">hr.activity.device</field>
        <field name="arch" type="xml">
            <list string="Devices">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status in ('idle', 'locked', 'paused')"
                       decoration-danger="status == 'revoked'"
                       decoration-info="status == 'pending'"/>
                <field name="last_seen"/>
                <field name="os_name" optional="show"/>
                <field name="os_user" optional="hide"/>
                <field name="agent_version" optional="show"/>
                <field name="paired_on" optional="hide"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_activity_device_view_form" model="ir.ui.view">
        <field name="name">hr.activity.device.form</field>
        <field name="model">hr.activity.device</field>
        <field name="arch" type="xml">
            <form string="Device" edit="0">
                <header>
                    <button name="action_new_code" type="object" string="New Pairing Code"
                            invisible="state != 'pending'" groups="hudson_activity_monitor.group_activity_admin"/>
                    <button name="action_revoke" type="object" string="Revoke Device" class="btn-secondary"
                            invisible="state == 'revoked'" groups="hudson_activity_monitor.group_activity_admin"
                            confirm="The agent on this computer will stop tracking until it is paired again. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'pending'">
                        <h4>Pair the Hudson Activity agent</h4>
                        <p class="mb-2">Install and start the agent on the employee's computer, then enter:</p>
                        <table class="table table-sm table-borderless mb-2 w-auto">
                            <tr>
                                <td class="fw-bold pe-3">Server URL</td>
                                <td><field name="server_url" widget="CopyClipboardChar" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold pe-3">Pairing code</td>
                                <td><h2 class="mb-0"><field name="pairing_code" widget="CopyClipboardChar" readonly="1"/></h2></td>
                            </tr>
                            <tr>
                                <td class="fw-bold pe-3">Valid until</td>
                                <td><field name="pairing_expiry" readonly="1"/></td>
                            </tr>
                        </table>
                        <p class="mb-0 small">The code works once. For silent installation:
                            <code>HudsonActivity.exe --pair-url "&lt;Server URL&gt;" --pair-code &lt;code&gt;</code></p>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="id" options="{'no_create': True}"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-warning="status in ('idle', 'locked', 'paused')"
                                   decoration-danger="status == 'revoked'"/>
                            <field name="last_seen"/>
                            <field name="paired_on"/>
                        </group>
                        <group>
                            <field name="os_name"/>
                            <field name="os_user"/>
                            <field name="agent_version"/>
                            <field name="device_uid" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_activity_device_view_search" model="ir.ui.view">
        <field name="name">hr.activity.device.search</field>
        <field name="model">hr.activity.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <filter name="paired" string="Paired" domain="[('state', '=', 'paired')]"/>
                <filter name="pending" string="Waiting for pairing" domain="[('state', '=', 'pending')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_os" string="Operating System" context="{'group_by': 'os_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_activity_device" model="ir.actions.act_window">
        <field name="name">Live Status</field>
        <field name="res_model">hr.activity.device</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_paired': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No device paired yet</p>
            <p>Click "New", choose the employee and save to get a pairing code for the agent.</p>
        </field>
    </record>
</odoo>
