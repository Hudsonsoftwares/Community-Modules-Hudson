<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shown on the user form (Settings > Users > Access Rights) as "Activity Monitor": User / Administrator -->
    <record id="res_groups_privilege_activity" model="res.groups.privilege">
        <field name="name">Activity Monitor</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_activity_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can be monitored. Does not see the Activity Monitor app; can only open their own activity (the agent's "Open my activity" link).</field>
    </record>

    <record id="group_activity_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[(4, ref('group_activity_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sees the Activity Monitor app with everybody's activity (including window titles), pairs devices and manages the settings.</field>
    </record>
</odoo>
