<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_eco_type_view_form" model="ir.ui.view">
        <field name="name">mrp.eco.type.view.form</field>
        <field name="model">mrp.eco.type</field>
        <field name="arch" type="xml">
            <form string="ECO Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_eco_type_view_tree" model="ir.ui.view">
        <field name="name">mrp.eco.type.view.tree</field>
        <field name="model">mrp.eco.type</field>
        <field name="arch" type="xml">
            <list string="ECO Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="mrp_eco_type_view_kanban" model="ir.ui.view">
        <field name="name">mrp.eco.type.view.kanban</field>
        <field name="model">mrp.eco.type</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_mrp_eco_kanban" create="0" color="color">
                <field name="name"/>
                <field name="eco_count"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <a type="action" name="%(mrp_eco_action_main)d" context="{'search_default_type_id': id, 'default_type_id': id}">
                                            <field name="name"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content mt-4">
                                <div class="row">
                                    <div class="col-12 o_kanban_primary_left">
                                        <button class="btn btn-primary" name="%(mrp_eco_action_main)d" type="action" context="{'search_default_type_id': id, 'default_type_id': id}">
                                            <field name="eco_count"/> Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mrp_eco_type_action_config" model="ir.actions.act_window">
        <field name="name">ECO Types</field>
        <field name="res_model">mrp.eco.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="mrp_eco_type_action_dashboard" model="ir.actions.act_window">
        <field name="name">PLM Overview</field>
        <field name="res_model">mrp.eco.type</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <menuitem id="menu_mrp_eco_types_config"
              name="ECO Types"
              parent="menu_mrp_eco_types"
              action="mrp_eco_type_action_config"
              sequence="10"/>

    <menuitem id="menu_plm_overview_action"
              name="Overview"
              parent="menu_plm_overview"
              action="mrp_eco_type_action_dashboard"
              sequence="10"/>
</odoo>
