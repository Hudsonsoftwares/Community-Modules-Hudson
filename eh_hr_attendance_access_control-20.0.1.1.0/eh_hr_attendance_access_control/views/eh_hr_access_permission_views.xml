<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_hr_access_permission_list" model="ir.ui.view">
            <field name="name">eh.hr.access.permission.list</field>
            <field name="model">eh.hr.access.permission</field>
            <field name="arch" type="xml">
                <list string="Access permissions" sample="1" editable="bottom" decoration-muted="not active">
                    <field name="employee_id"/>
                    <field name="zone_id"/>
                    <field name="valid_from"/>
                    <field name="valid_to"/>
                    <field name="active"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="action_eh_hr_access_permission" model="ir.actions.act_window">
            <field name="name">Access permissions</field>
            <field name="res_model">eh.hr.access.permission</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
