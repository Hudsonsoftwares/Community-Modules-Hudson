<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hudson_sign_item_type_view_tree" model="ir.ui.view">
            <field name="name">hudson.sign.item.type.list</field>
            <field name="model">hudson.sign.item.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="item_type"/>
                    <field name="linked_to"/>
                    <field name="linked_field"/>
                    <field name="update_field"/>
                </list>
            </field>
        </record>

        <record id="hudson_sign_item_type_view_form" model="ir.ui.view">
            <field name="name">hudson.sign.item.type.form</field>
            <field name="model">hudson.sign.item.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="item_type" widget="radio" options="{'horizontal': true}" nolabel="1" colspan="2"/>
                        </group>
                        <group>
                            <field name="name" placeholder="Field Name" nolabel="1" colspan="2" style="font-size: 1.5em; border-bottom: 2px solid #00a09d;"/>
                        </group>
                        
                        <h4 class="mt-4 mb-3 text-uppercase text-muted" style="font-size: 12px; font-weight: bold;">Default Values</h4>
                        <group>
                            <group>
                                <field name="placeholder"/>
                                <field name="tip"/>
                                <field name="mandatory"/>
                                <field name="is_read_only"/>
                                <field name="is_shared"/>
                            </group>
                            <group>
                                <field name="linked_to" placeholder="Autocomplete this field"/>
                                <field name="linked_field" invisible="not linked_to"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hudson_sign_item_type" model="ir.actions.act_window">
            <field name="name">Fields</field>
            <field name="res_model">hudson.sign.item.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hudson_sign_fields_action"
                  parent="menu_hudson_sign_configuration"
                  action="action_hudson_sign_item_type"
                  sequence="20"/>
    </data>
</odoo>
