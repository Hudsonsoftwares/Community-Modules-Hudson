<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_exec_sum">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <!-- Header -->
                    <div class="row mb-3">
                        <div class="col-8">
                            <h2 style="font-weight:bold; color:#2c3e50;">Executive Summary</h2>
                            <h4 t-esc="company.name" style="color:#7f8c8d;"/>
                            <p class="text-muted">
                                <t t-esc="data.get('date_from')"/> — <t t-esc="data.get('date_to')"/>
                                <t t-if="data.get('comparison')">
                                    &#160;|&#160; vs &#160;<t t-esc="data.get('compare_date_from')"/> — <t t-esc="data.get('compare_date_to')"/>
                                </t>
                            </p>
                        </div>
                    </div>
                    <hr/>

                    <!-- ===== KPI CARDS ===== -->
                    <t t-set="c" t-value="data.get('current', {})"/>
                    <t t-set="p" t-value="data.get('comparison') or {}"/>

                    <div class="row text-center mb-4">
                        <!-- Revenue -->
                        <div class="col-3" style="border:1px solid #bdc3c7; border-radius:8px; margin:4px; padding:12px; background:#eaf4fb;">
                            <div style="font-size:11px; color:#7f8c8d; font-weight:bold; text-transform:uppercase;">Revenue</div>
                            <div style="font-size:18px; font-weight:bold; color:#2980b9;">
                                <span t-esc="c.get('revenue', 0)"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </div>
                            <t t-if="p">
                                <div style="font-size:11px; color:#95a5a6;">
                                    vs <span t-esc="p.get('revenue', 0)"
                                             t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </div>
                            </t>
                        </div>
                        <!-- Gross Profit -->
                        <div class="col-3" style="border:1px solid #bdc3c7; border-radius:8px; margin:4px; padding:12px; background:#eafaf1;">
                            <div style="font-size:11px; color:#7f8c8d; font-weight:bold; text-transform:uppercase;">Gross Profit</div>
                            <div style="font-size:18px; font-weight:bold; color:#27ae60;">
                                <span t-esc="c.get('gross_profit', 0)"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </div>
                            <div style="font-size:11px; color:#7f8c8d;">
                                Margin: <t t-esc="c.get('gross_margin', 0)"/>%
                            </div>
                        </div>
                        <!-- Net Profit -->
                        <div class="col-3" style="border:1px solid #bdc3c7; border-radius:8px; margin:4px; padding:12px; background:#fef9e7;">
                            <div style="font-size:11px; color:#7f8c8d; font-weight:bold; text-transform:uppercase;">Net Profit</div>
                            <div t-attf-style="font-size:18px; font-weight:bold; color:{{ '#27ae60' if c.get('net_profit', 0) >= 0 else '#e74c3c' }};">
                                <span t-esc="c.get('net_profit', 0)"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </div>
                            <div style="font-size:11px; color:#7f8c8d;">
                                Margin: <t t-esc="c.get('net_margin', 0)"/>%
                            </div>
                        </div>
                        <!-- Cash -->
                        <div class="col-3" style="border:1px solid #bdc3c7; border-radius:8px; margin:4px; padding:12px; background:#f5eef8;">
                            <div style="font-size:11px; color:#7f8c8d; font-weight:bold; text-transform:uppercase;">Cash &amp; Bank</div>
                            <div style="font-size:18px; font-weight:bold; color:#8e44ad;">
                                <span t-esc="c.get('cash', 0)"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </div>
                        </div>
                    </div>

                    <!-- ===== DETAILED P&L TABLE ===== -->
                    <h5 style="color:#2c3e50; font-weight:bold;">Income Statement Summary</h5>
                    <table class="table table-sm table-reports" style="font-size:13px;">
                        <thead>
                            <tr style="background:#2c3e50; color:white;">
                                <th style="width:50%;">Item</th>
                                <th class="text-end">Current Period</th>
                                <t t-if="data.get('comparison')">
                                    <th class="text-end">Comparison Period</th>
                                    <th class="text-end">Change</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Revenue</td>
                                <td class="text-end"><span t-esc="c.get('revenue', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="p.get('revenue', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="c.get('revenue', 0) - p.get('revenue', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                            <tr>
                                <td>Other Income</td>
                                <td class="text-end"><span t-esc="c.get('other_income', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="p.get('other_income', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="c.get('other_income', 0) - p.get('other_income', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                            <tr>
                                <td>Cost of Revenue (COGS)</td>
                                <td class="text-end"><span t-esc="-c.get('cogs', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="-p.get('cogs', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="-(c.get('cogs', 0) - p.get('cogs', 0))" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                            <tr style="background:#d5e8d4; font-weight:bold;">
                                <td>Gross Profit</td>
                                <td class="text-end"><span t-esc="c.get('gross_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="p.get('gross_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="c.get('gross_profit', 0) - p.get('gross_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                            <tr>
                                <td>Operating Expenses</td>
                                <td class="text-end"><span t-esc="-c.get('opex', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="-p.get('opex', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="-(c.get('opex', 0) - p.get('opex', 0))" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                            <tr style="background:#2c3e50; color:white; font-weight:bold;">
                                <td>Net Profit / (Loss)</td>
                                <td class="text-end"><span t-esc="c.get('net_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <t t-if="data.get('comparison')">
                                    <td class="text-end"><span t-esc="p.get('net_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-esc="c.get('net_profit', 0) - p.get('net_profit', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </t>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ===== BALANCE SHEET KPIs ===== -->
                    <div class="row mt-3">
                        <div class="col-6">
                            <h5 style="color:#2c3e50; font-weight:bold;">Balance Sheet Highlights</h5>
                            <table class="table table-sm table-reports" style="font-size:13px;">
                                <tbody>
                                    <tr>
                                        <td>Accounts Receivable</td>
                                        <td class="text-end"><span t-esc="c.get('ar', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Accounts Payable</td>
                                        <td class="text-end"><span t-esc="c.get('ap', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Current Assets</td>
                                        <td class="text-end"><span t-esc="c.get('current_assets', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Current Liabilities</td>
                                        <td class="text-end"><span t-esc="c.get('current_liabilities', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6">
                            <h5 style="color:#2c3e50; font-weight:bold;">Key Ratios</h5>
                            <table class="table table-sm table-reports" style="font-size:13px;">
                                <tbody>
                                    <tr>
                                        <td>Gross Profit Margin</td>
                                        <td class="text-end"><strong><t t-esc="c.get('gross_margin', 0)"/>%</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Net Profit Margin</td>
                                        <td class="text-end"><strong><t t-esc="c.get('net_margin', 0)"/>%</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Current Ratio</td>
                                        <td class="text-end">
                                            <strong><t t-esc="c.get('current_ratio', 0)"/> : 1</strong>
                                            <span style="font-size:11px; color:#7f8c8d;"> (≥ 1.5 healthy)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Quick Ratio</td>
                                        <td class="text-end">
                                            <strong><t t-esc="c.get('quick_ratio', 0)"/> : 1</strong>
                                            <span style="font-size:11px; color:#7f8c8d;"> (≥ 1.0 healthy)</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
