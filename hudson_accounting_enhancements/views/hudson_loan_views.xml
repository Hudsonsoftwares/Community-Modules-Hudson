<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- hudson.loan List View -->
    <record id="view_hudson_loan_tree" model="ir.ui.view">
        <field name="name">hudson.loan.tree</field>
        <field name="model">hudson.loan</field>
        <field name="arch" type="xml">
            <list string="Loans">
                <field name="name"/>
                <field name="date"/>
                <field name="amount_borrowed"/>
                <field name="outstanding_balance"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'running'"/>
            </list>
        </field>
    </record>

    <!-- hudson.loan Form View -->
    <record id="view_hudson_loan_form" model="ir.ui.view">
        <field name="name">hudson.loan.form</field>
        <field name="model">hudson.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_compute" string="Compute" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object" class="oe_stat_button" icon="fa-bars" invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Loan Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Loan name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="amount_borrowed"/>
                            <field name="interest"/>
                            <field name="outstanding_balance"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="duration"/>
                            <field name="asset_group"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amortization schedule" name="schedule">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Amortization schedule" editable="bottom" decoration-muted="is_posted == True">
                                    <field name="date"/>
                                    <field name="principal" sum="Total Principal"/>
                                    <field name="interest" sum="Total Interest"/>
                                    <field name="payment" sum="Total Payments"/>
                                    <field name="balance"/>
                                    <field name="is_posted" readonly="1" widget="boolean_toggle"/>
                                    <field name="move_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Loan Settings" name="settings">
                            <group>
                                <field name="receive_disbursement" readonly="state != 'draft'"/>
                                <field name="disbursement_account_id" invisible="not receive_disbursement" required="receive_disbursement" readonly="state != 'draft'"/>
                                <field name="long_term_account_id" readonly="state != 'draft'"/>
                                <field name="short_term_account_id" readonly="state != 'draft'"/>
                                <field name="expense_account_id" readonly="state != 'draft'"/>
                                <field name="journal_id" readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- hudson.loan Action -->
    <record id="action_hudson_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">hudson.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Loan
            </p>
        </field>
    </record>

    <!-- Menu Item (Assuming there is a top-level or standard accounting menu, we will place it under accounting root or similar. If account_asset is not installed, we can put it under Accounting -> Management) -->
    <!-- Loans root menu under the existing Assets & Liabilities menu -->
    <menuitem id="menu_hudson_loan_root" name="Loans" parent="hudson_accounting_enhancements.menu_assets_and_liabilities" sequence="20" action="action_hudson_loan"/>

</odoo>
