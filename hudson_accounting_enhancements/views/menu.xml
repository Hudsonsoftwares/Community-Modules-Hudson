        <field name="name">Balance Sheet</field>
        <field name="model_id" ref="accounting_pdf_reports.model_accounting_report"/>
        <field name="state">code</field>
        <field name="code">
report_id = env.ref('accounting_pdf_reports.account_financial_report_balancesheet0').id
wiz = env['accounting.report'].create({'account_report_id': report_id})
data = wiz.read()[0]
action = {'name': 'Balance Sheet', 'type': 'ir.actions.client', 'tag': 'hudson_dynamic_reports.dynamic_report', 'params': {'model_name': 'accounting.report', 'wizard_id': wiz.id, 'data': data}}
        </field>
    </record>
    <record id="accounting_pdf_reports.menu_account_report_bs" model="ir.ui.menu">
        <field name="action" ref="action_server_report_bs"/>
        <field name="parent_id" ref="account.account_reports_legal_statements_menu"/>
        <field name="sequence">10</field>
