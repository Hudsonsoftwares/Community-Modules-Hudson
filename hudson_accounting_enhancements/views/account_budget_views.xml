<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_crossovered_budget_lines_pivot_view" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">crossovered.budget.lines</field>
        <field name="view_mode">pivot,list,form,graph</field>
        <field name="view_id" eval="False"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Click to create a new budget line.
          </p>
        </field>
    </record>

    <record id="view_crossovered_budget_form_inherit" model="ir.ui.view">
        <field name="name">crossovered.budget.form.inherit</field>
        <field name="model">crossovered.budget</field>
        <field name="inherit_id" ref="om_account_budget.crossovered_budget_view_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons -->
            <xpath expr="//header" position="replace">
                <header>
                    <button string="Confirm" name="action_budget_confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button string="Approve" name="action_budget_validate" type="object" invisible="state != 'confirm'" class="oe_highlight"/>
                    <button string="Reset to Draft" name="action_budget_draft" invisible="state != 'cancel'" type="object"/>
                    <button name="action_revise_budget" string="Revise" type="object" invisible="state not in ['draft', 'validate', 'done', 'cancel']"/>
                    <button string="Done" name="action_budget_done" type="object" invisible="state != 'validate'" class="oe_highlight"/>
                    <button string="Cancel Budget" name="action_budget_cancel" invisible="state not in ('confirm', 'validate')" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validate,done"/>
                </header>
            </xpath>

            <!-- Add button box with Budget Report smart button -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" name="%(hudson_accounting_enhancements.act_crossovered_budget_lines_pivot_view)d" type="action" icon="fa-bar-chart" context="{'search_default_crossovered_budget_id': id, 'default_crossovered_budget_id': id}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Budget Report</span>
                        </div>
                    </button>
                </div>
            </xpath>

            <!-- Title: Budget Name -->
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <label for="name" string="Budget Name"/>
                    <h1>
                        <field name="name" readonly="state != 'draft'" placeholder="e.g. Budget 2027"/>
                    </h1>
                </div>
            </xpath>

            <!-- Form layout: Responsible, Budget Type, Period, Company -->
            <xpath expr="//sheet/group" position="replace">
                <group>
                    <group>
                        <field name="user_id" string="Responsible" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                        <field name="budget_type" string="Budget Type" readonly="state != 'draft'"/>
                    </group>
                    <group>
                        <label for="date_from" string="Period"/>
                        <div class="d-flex align-items-center">
                            <field name="date_from" class="oe_inline" readonly="state != 'draft'"/>
                            <span class="mx-2">-</span>
                            <field name="date_to" class="oe_inline" readonly="state != 'draft'" nolabel="1"/>
                        </div>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>

            <!-- Replace Budget Lines list view with Analytic Plans + Commitment only -->
            <xpath expr="//field[@name='crossovered_budget_line']/list" position="replace">
                <list string="Budget Lines" editable="bottom">
                    <field name="account_id" string="Project Plan" domain="[('plan_id', 'child_of', 1)]" optional="show"/>
                    <field name="x_plan2_id" string="Departments" domain="[('plan_id', 'child_of', 2)]" optional="show"/>
                    <field name="x_plan3_id" string="Internal" domain="[('plan_id', 'child_of', 3)]" optional="show"/>
                    <field name="x_plan4_id" string="Hudson" domain="[('plan_id', 'child_of', 4)]" optional="show"/>
                    <field name="x_plan5_id" string="Hyperbaric Chamber" domain="[('plan_id', 'child_of', 5)]" optional="show"/>
                    <field name="date_from" column_invisible="True"/>
                    <field name="date_to" column_invisible="True"/>
                    <field name="planned_amount" string="Commitment" sum="Commitment"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </xpath>

            <!-- Replace Budget Lines form view -->
            <xpath expr="//field[@name='crossovered_budget_line']/form" position="replace">
                <form string="Budget Lines">
                    <group>
                        <group>
                            <field name="account_id" string="Project Plan" domain="[('plan_id', 'child_of', 1)]"/>
                            <field name="x_plan2_id" string="Departments" domain="[('plan_id', 'child_of', 2)]"/>
                            <field name="x_plan3_id" string="Internal" domain="[('plan_id', 'child_of', 3)]"/>
                            <field name="x_plan4_id" string="Hudson" domain="[('plan_id', 'child_of', 4)]"/>
                            <field name="x_plan5_id" string="Hyperbaric Chamber" domain="[('plan_id', 'child_of', 5)]"/>
                            <field name="date_from" invisible="1"/>
                            <field name="date_to" invisible="1"/>
                            <field name="planned_amount" string="Commitment"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </form>
            </xpath>
        </field>
    </record>

    <!-- Update pivot view strings to match enterprise terminology -->
    <record id="view_crossovered_budget_line_pivot_inherit" model="ir.ui.view">
        <field name="name">crossovered.budget.line.pivot.inherit</field>
        <field name="model">crossovered.budget.lines</field>
        <field name="inherit_id" ref="om_account_budget.view_crossovered_budget_line_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='planned_amount']" position="attributes">
                <attribute name="string">Commitment</attribute>
            </xpath>
            <xpath expr="//field[@name='theoritical_amount']" position="attributes">
                <attribute name="string">Liquidation</attribute>
            </xpath>
            <xpath expr="//field[@name='practical_amount']" position="attributes">
                <attribute name="string">Achieved</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- Also update the standalone tree view of budget lines -->
    <record id="view_crossovered_budget_line_tree_inherit" model="ir.ui.view">
        <field name="name">crossovered.budget.line.list.inherit</field>
        <field name="model">crossovered.budget.lines</field>
        <field name="inherit_id" ref="om_account_budget.view_crossovered_budget_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='general_budget_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position="before">
                <field name="analytic_plan_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_from']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='paid_date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='percentage']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='planned_amount']" position="attributes">
                <attribute name="string">Commitment</attribute>
            </xpath>
            <xpath expr="//field[@name='theoritical_amount']" position="attributes">
                <attribute name="string">Expected</attribute>
            </xpath>
            <xpath expr="//field[@name='practical_amount']" position="attributes">
                <attribute name="string">Achieved</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add Budgets tab to Analytic Account form view matching Enterprise layout -->
    <record id="view_account_analytic_account_form_inherit_hudson_budget" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.hudson.budget</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//page[field[@name='crossovered_budget_line']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Budgets" name="budgets">
                    <field name="crossovered_budget_line" readonly="1">
                        <list string="Budgets" create="0" delete="0" edit="0">
                            <field name="crossovered_budget_id" string="Budget Analytic"/>
                            <field name="date_from" string="Start Date"/>
                            <field name="date_to" string="End Date"/>
                            <field name="planned_amount" string="Commitment"/>
                            <field name="theoritical_amount" string="Expected"/>
                            <field name="practical_amount" string="Achieved"/>
                            <field name="budget_state" string="Budget State" widget="badge" decoration-info="budget_state == 'draft'" decoration-success="budget_state in ('validate', 'done')" decoration-danger="budget_state == 'cancel'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
