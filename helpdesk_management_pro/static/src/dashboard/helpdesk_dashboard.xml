<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="helpdesk_management_pro.DashboardKanbanRenderer" owl="1">
        <div class="o_helpdesk_dashboard_kanban_renderer h-100 d-flex flex-column">
            <HelpdeskDashboard />
            <div class="o_kanban_view position-relative flex-grow-1">
                <t t-call="web.KanbanRenderer"/>
            </div>
        </div>
    </t>

    <t t-name="helpdesk_management_pro.HelpdeskDashboard" owl="1">
        <div class="o_helpdesk_dashboard border-bottom" t-if="state.metrics">
            <div class="container-fluid px-4 py-3">
                <div class="row o_dashboard_action">
                    
                    <!-- My Tickets Section -->
                    <div class="col-12 col-xl-7 mb-3 mb-xl-0 pe-xl-4 border-end">
                        <div class="d-flex align-items-center mb-2">
                            <h5 class="mb-0 fw-bold">Helpdesk Tickets</h5>
                        </div>
                        <div class="o_dashboard_card row g-0 text-center bg-white shadow-sm">
                            
                            <!-- Col 1: Labels -->
                            <div class="col-3 border-end d-flex flex-column text-start">
                                <div class="p-3 flex-grow-1 d-flex flex-column justify-content-center text-muted cursor-pointer hover-opacity" t-on-click="openMyTickets">
                                    <div class="o_dashboard_label">Open Tickets</div>
                                </div>
                                <div class="p-2 border-top text-muted d-flex align-items-center">
                                    <div class="o_dashboard_label">Avg Open Hours</div>
                                </div>
                                <div class="p-2 border-top text-muted d-flex align-items-center cursor-pointer hover-opacity" t-on-click="openFailed">
                                    <div class="o_dashboard_label">Failed Tickets</div>
                                </div>
                            </div>
                            
                            <!-- Col 2: Tickets -->
                            <div class="col-3 border-end d-flex flex-column cursor-pointer hover-opacity" t-on-click="openMyTickets">
                                <div t-attf-class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center #{state.metrics.my_tickets > 0 ? 'bg-purple text-white' : 'bg-light text-muted'}">
                                    <div class="o_dashboard_value fw-bold fs-4"><t t-esc="state.metrics.my_tickets"/></div>
                                    <div class="o_dashboard_label">Tickets</div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.avg_open_hours"/></div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.failed_tickets"/></div>
                                </div>
                            </div>

                            <!-- Col 3: High Priority -->
                            <div class="col-3 border-end d-flex flex-column cursor-pointer hover-opacity" t-on-click="openHighPriority">
                                <div t-attf-class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center position-relative #{state.metrics.high_priority > 0 ? 'bg-purple text-white' : 'bg-white text-muted'}">
                                    <div t-attf-class="position-absolute top-0 start-0 mt-2 ms-2 #{state.metrics.high_priority > 0 ? 'text-warning' : 'text-warning opacity-50'}"><i class="fa fa-star"></i><i class="fa fa-star"></i></div>
                                    <div class="o_dashboard_value fw-bold fs-4 mt-2"><t t-esc="state.metrics.high_priority"/></div>
                                    <div class="o_dashboard_label">High Priority</div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.hp_avg_open_hours || '0h'"/></div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.hp_failed_tickets || '0'"/></div>
                                </div>
                            </div>

                            <!-- Col 4: Urgent -->
                            <div class="col-3 d-flex flex-column cursor-pointer hover-opacity" t-on-click="openUrgent">
                                <div t-attf-class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center position-relative #{state.metrics.urgent > 0 ? 'bg-purple text-white' : 'bg-white text-muted'}">
                                    <div t-attf-class="position-absolute top-0 end-0 mt-2 me-2 #{state.metrics.urgent > 0 ? 'text-warning' : 'text-warning opacity-50'}"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></div>
                                    <div class="o_dashboard_value fw-bold fs-4 mt-2"><t t-esc="state.metrics.urgent"/></div>
                                    <div class="o_dashboard_label">Urgent</div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.urg_avg_open_hours || '50h'"/></div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.urg_failed_tickets || '0'"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- My Performance Section -->
                    <div class="col-12 col-xl-5 ps-xl-4">
                        <div class="d-flex align-items-center mb-2">
                            <h5 class="mb-0 fw-bold">Overall Performance</h5>
                        </div>
                        <div class="o_dashboard_card row g-0 text-center bg-white shadow-sm">
                            
                            <!-- Col 1: Labels -->
                            <div class="col-3 border-end d-flex flex-column text-start">
                                <div class="p-3 flex-grow-1 d-flex flex-column justify-content-center text-muted">
                                    <div class="o_dashboard_label">Today</div>
                                </div>
                                <div class="p-2 border-top text-muted d-flex align-items-center">
                                    <div class="o_dashboard_label">Avg Last 7 days</div>
                                </div>
                                <div class="p-2 border-top text-muted d-flex align-items-center">
                                    <div class="o_dashboard_label">Daily Target</div>
                                </div>
                            </div>

                            <!-- Col 2: Closed Tickets -->
                            <div class="col-3 border-end d-flex flex-column cursor-pointer hover-opacity" t-on-click="openClosed">
                                <div class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center bg-white text-muted">
                                    <div class="o_dashboard_value fw-bold fs-4 text-dark"><t t-esc="state.metrics.today"/></div>
                                    <div class="o_dashboard_label">Closed Tickets</div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.avg_last_7_days"/></div>
                                </div>
                                <div class="p-2 border-top bg-white">
                                    <input type="number" class="o_dashboard_value text-danger border-0 text-center w-100 bg-transparent p-0 m-0 fw-bold" t-att-value="state.metrics.daily_target_value || '1'" t-on-change="(ev) => this.updateTarget('closed', ev)" title="Daily Target"/>
                                </div>
                            </div>

                            <!-- Col 3: SLA Success Rate -->
                            <div class="col-3 border-end d-flex flex-column">
                                <div class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center bg-light text-muted">
                                    <div class="o_dashboard_value fw-bold fs-4 text-dark"><t t-esc="state.metrics.sla_success_rate"/></div>
                                    <div class="o_dashboard_label">SLA Success Rate</div>
                                </div>
                                <div class="p-2 border-top bg-light">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.sla_success_rate_7d || '/ %'"/></div>
                                </div>
                                <div class="p-2 border-top bg-white d-flex justify-content-center align-items-center">
                                    <input type="number" min="0" max="100" class="o_dashboard_value text-dark border-0 text-end bg-transparent p-0 m-0 fw-bold" style="width: 3.5rem;" t-att-value="state.metrics.daily_target_success_val || '85'" t-on-change="(ev) => this.updateTarget('success', ev)" title="Daily Target"/>
                                    <span class="o_dashboard_value text-dark">%</span>
                                </div>
                            </div>

                            <!-- Col 4: Average Rating -->
                            <div class="col-3 d-flex flex-column">
                                <div class="p-2 flex-grow-1 d-flex flex-column justify-content-center align-items-center bg-light text-muted">
                                    <div class="o_dashboard_value fw-bold fs-4 text-dark"><t t-esc="state.metrics.average_rating"/></div>
                                    <div class="o_dashboard_label">Average Rating</div>
                                </div>
                                <div class="p-2 border-top bg-light">
                                    <div class="o_dashboard_value text-dark"><t t-esc="state.metrics.average_rating_7d || '/'"/></div>
                                </div>
                                <div class="p-2 border-top bg-white d-flex justify-content-center align-items-center">
                                    <input type="number" min="0" max="5" step="0.1" class="o_dashboard_value text-dark border-0 text-end bg-transparent p-0 m-0 fw-bold" style="width: 2.5rem;" t-att-value="state.metrics.daily_target_rating_val || '4.5'" t-on-change="(ev) => this.updateTarget('rating', ev)" title="Daily Target"/>
                                    <span class="o_dashboard_value text-dark ms-1">/ 5</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
