<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Team Action -->
    <record id="helpdesk_management_pro_action_teams" model="ir.actions.act_window">
        <field name="name">Helpdesk Teams</field>
        <field name="res_model">helpdesk.management.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first team!
            </p>
        </field>
    </record>

    <!-- Team Form View -->
    <record id="helpdesk_management_pro_view_team_form" model="ir.ui.view">
        <field name="name">helpdesk.management.team.form</field>
        <field name="model">helpdesk.management.team</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(helpdesk_management_pro.helpdesk_management_pro_action_all_tickets)d" type="action"
                                class="oe_stat_button" icon="fa-life-ring"
                                context="{'search_default_team_id': id, 'default_team_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="ticket_count"/></span>
                                <span class="o_stat_text"> Tickets</span>
                            </div>
                        </button>
                        <button name="%(helpdesk_management_pro.helpdesk_management_pro_action_sla)d" type="action"
                                class="oe_stat_button" icon="fa-calendar"
                                context="{'search_default_team_id': id, 'default_team_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="sla_policy_count"/></span>
                                <span class="o_stat_text"> SLA Policies</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Customer Care"/>
                        </h1>
                    </div>
                    <group>
                        <group colspan="2">
                            <field name="description" placeholder="We provide 24/7 support..." nolabel="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                        </group>
                    </group>

                    <h2>Visibility &amp; Assignment</h2>
                    <div class="row mt16 o_settings_container">
                        <!-- Visibility -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="visibility_member_type"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Visibility"/>
                                <div class="text-muted">People to whom this team and its tickets will be visible</div>
                                <div class="mt-2">
                                    <field name="visibility_member_type" widget="radio"/>
                                </div>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-lightbulb-o"/> Grant portal users access to your helpdesk team or tickets by adding them as followers. Customers automatically get access to their tickets in their portal.
                                </div>
                            </div>
                        </div>
                        <!-- Assignment & Followers -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Follow All Team's Tickets</span>
                                <div class="text-muted">Receive notifications whenever tickets are created, rated or discussed on in this team</div>
                                <div class="mt-2 mb-2">
                                    <span class="o_form_label fw-bold">Followers</span>
                                    <div class="mt-1">
                                        <field name="follower_ids" widget="many2many_tags" placeholder="Add followers..." class="w-100"/>
                                    </div>
                                </div>
                                <div class="d-flex mt-4">
                                    <field name="auto_assignment" class="me-2 mt-1"/>
                                    <div>
                                        <label for="auto_assignment" class="fw-bold"/>
                                        <div class="text-muted">Automate the assignment of new tickets to the right people, and make sure all tickets are being handled</div>
                                    </div>
                                </div>
                                <div class="mt-2 ms-4" invisible="auto_assignment == False">
                                    <field name="assignment_method" widget="radio"/>
                                    <div class="d-flex align-items-center mt-3">
                                        <label for="member_ids" string="Team Members" class="fw-bold me-2"/>
                                        <field name="member_ids" widget="many2many_avatar_user" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Channels -->
                    <h2>Channels</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="use_alias">
                            <div class="o_setting_left_pane">
                                <field name="use_alias"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_alias"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Email Alias"/>
                                <div class="text-muted">Create tickets by sending an email to an alias</div>
                                <div class="mt-3" invisible="not use_alias">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="alias_name" string="Alias" class="fw-bold me-2" style="min-width: 150px;"/>
                                        <field name="alias_name" class="w-100"/>
                                    </div>
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="alias_name" string="Domain" class="fw-bold me-2" style="min-width: 150px;"/>
                                        <span class="text-muted">@ e.g. mycompany.com</span>
                                    </div>
                                    <div class="d-flex align-items-baseline mb-3">
                                        <label for="alias_contact" string="Alias Contact Security" class="fw-bold me-2" style="min-width: 150px;"/>
                                        <field name="alias_contact" class="w-100"/>
                                    </div>
                                    <div class="text-muted mt-2">
                                        <i class="fa fa-lightbulb-o"/> To use an email alias, the first step is to configure an Alias Domain. You can achieve this by navigating to the General Settings and configuring the corresponding field.
                                    </div>
                                    <div class="mt-1">
                                        <button name="%(base_setup.action_general_configuration)d" type="action" class="btn-link" icon="fa-arrow-right">
                                            <span>Set an Alias Domain</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_livechat"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_livechat"/>
                                <div class="text-muted">Get in touch with your website visitors, and engage them with scripted chatbot conversations. Create and search tickets from your conversations.</div>
                                <div class="mt-3" invisible="not use_livechat">
                                    <div class="mt-2">
                                        <button name="%(im_livechat.im_livechat_channel_action)d" type="action" class="btn-link" icon="fa-arrow-right">
                                            <span>Configure Live Chat Channel</span>
                                        </button>
                                    </div>
                                    <div class="mt-2">
                                        <button name="%(im_livechat.chatbot_script_action)d" type="action" class="btn-link" icon="fa-arrow-right">
                                            <span>Configure Chatbots</span>
                                        </button>
                                    </div>
                                    <div class="text-muted mt-3">
                                        <div><i class="fa fa-lightbulb-o"/> Type <strong>/ticket</strong> to create tickets</div>
                                        <div style="margin-left: 17px;">Type <strong>/search_tickets</strong> to find tickets</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Help Center -->
                    <h2>Help Center</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_website_helpdesk_form"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_website_helpdesk_form"/>
                                <div class="text-muted">Get tickets through an online form</div>
                                <div class="mt-3" invisible="not use_website_helpdesk_form">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="website_id" class="fw-bold me-2" style="min-width: 80px;"/>
                                        <field name="website_id" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_website_helpdesk_knowledge"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_website_helpdesk_knowledge"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Knowledge"/>
                                <div class="text-muted">Centralize, manage, share and grow your knowledge library. Allow customers to search your articles in the help center for answers to their questions.</div>
                                <div class="mt-3" invisible="not use_website_helpdesk_knowledge">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="article_id" class="fw-bold me-2" style="min-width: 80px;"/>
                                        <field name="article_id" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_website_helpdesk_forum"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_website_helpdesk_forum"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Community Forum"/>
                                <div class="text-muted">Allow customers to help each other on a forum. Share answers from your tickets directly.</div>
                                <div class="mt-3" invisible="not use_website_helpdesk_forum">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="forum_id" class="fw-bold me-2" style="min-width: 80px;"/>
                                        <field name="forum_id" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_website_helpdesk_elearning"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_website_helpdesk_elearning"/>
                                <span class="fa fa-question-circle text-info ms-1" title="eLearning"/>
                                <div class="text-muted">Share presentations and videos, and organize them into courses. Allow customers to search your eLearning courses in the help center for answers to their questions.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Track & Bill Time -->
                    <h2>Track &amp; Bill Time</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_helpdesk_timesheet"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_helpdesk_timesheet"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Timesheets"/>
                                <div class="text-muted">Track the time spent on tickets</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_helpdesk_sale_timesheet"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_helpdesk_sale_timesheet"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Time Billing"/>
                                <div class="text-muted">Bill the time spent on your tickets to your customers</div>
                            </div>
                        </div>
                    </div>

                    <!-- Performance -->
                    <h2>Performance</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_sla"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_sla"/>
                                <span class="fa fa-question-circle text-info ms-1" title="SLA Policies"/>
                                <div class="text-muted">Make sure tickets are handled on time</div>
                                <div class="mt-2" invisible="not use_sla">
                                    <div class="d-flex align-items-baseline">
                                        <label for="resource_calendar_id" class="me-2"/>
                                        <span class="fa fa-question-circle text-info me-2" title="Working Hours"/>
                                        <field name="resource_calendar_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_rating"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_rating"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Customer Ratings"/>
                                <div class="text-muted">Track customer satisfaction on tickets</div>
                                <div class="mt-3" invisible="not use_rating">
                                    <button name="%(helpdesk_management_pro.helpdesk_management_pro_action_stages)d" type="action" class="btn-link" icon="fa-arrow-right">
                                        <span>Set an email template on stages</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Self-Service -->
                    <h2>Self-Service</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_closure_by_customer"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_closure_by_customer"/>
                                <span class="fa fa-question-circle text-info ms-1" title="Closure by Customers"/>
                                <div class="text-muted">Allow your customers to close their own tickets</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_auto_close"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_auto_close"/>
                                <div class="text-muted">Close inactive tickets automatically</div>
                                <div class="mt-3" invisible="use_auto_close == False">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="auto_close_stage_id" class="fw-bold me-2" style="min-width: 110px;"/>
                                        <field name="auto_close_stage_id" class="w-100"/>
                                    </div>
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="auto_close_ticket_days" class="fw-bold me-2" style="min-width: 110px;"/>
                                        <field name="auto_close_ticket_days" class="oe_inline text-center me-2" style="width: 4rem;"/>
                                        <span> days of inactivity</span>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <label for="auto_close_in_stage_ids" class="fw-bold me-2" style="min-width: 110px;"/>
                                        <field name="auto_close_in_stage_ids" widget="many2many_tags" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Auto-Close Reminder -->
                        <div class="col-12 col-lg-6 o_setting_box" invisible="use_auto_close == False">
                            <div class="o_setting_left_pane">
                                <field name="use_auto_close_reminder"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_auto_close_reminder"/>
                                <div class="text-muted">Send an automatic reminder email to customers before their ticket is closed due to inactivity</div>
                                <div class="mt-3" invisible="use_auto_close_reminder == False">
                                    <div class="d-flex align-items-baseline mb-2">
                                        <label for="auto_close_reminder_template_id" class="fw-bold me-2" style="min-width: 110px;"/>
                                        <field name="auto_close_reminder_template_id" class="w-100"/>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <label for="auto_close_reminder_days" class="fw-bold me-2" style="min-width: 110px;"/>
                                        <field name="auto_close_reminder_days" class="oe_inline text-center me-2" style="width: 4rem;"/>
                                        <span> days before closure</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- After-Sales -->
                    <h2>After-Sales</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_credit_notes"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_credit_notes"/>
                                <div class="text-muted">Issue credits notes</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_gift_cards"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_gift_cards"/>
                                <div class="text-muted">Reimburse customers with a voucher code for future purchases</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_coupons"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_coupons"/>
                                <div class="text-muted">Grant discounts, free products or free shipping</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_product_returns"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_product_returns"/>
                                <div class="text-muted">Return faulty products</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_product_replacements"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_product_replacements"/>
                                <div class="text-muted">Send customers a replacement for a lost, damaged, or returned item</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_product_repairs"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_product_repairs"/>
                                <div class="text-muted">Send broken products for repair</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_fsm"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_fsm"/>
                                <div class="text-muted">Plan onsite interventions</div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <!-- chatter removed as requested -->
            </form>
        </field>
    </record>

    <!-- Team Tree View -->
    <record id="helpdesk_management_pro_view_team_tree" model="ir.ui.view">
        <field name="name">helpdesk.management.team.tree</field>
        <field name="model">helpdesk.management.team</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Teams">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Team Kanban View -->
    <record id="helpdesk_management_pro_view_team_kanban" model="ir.ui.view">
        <field name="name">helpdesk.management.team.kanban</field>
        <field name="model">helpdesk.management.team</field>
        <field name="arch" type="xml">
            <kanban js_class="helpdesk_dashboard_kanban" class="o_kanban_dashboard o_helpdesk_kanban" create="0" sample="1">
                <field name="name"/>
                <field name="color"/>
                <field name="ticket_count"/>
                <field name="open_ticket_count"/>
                <field name="unassigned_count"/>
                <field name="urgent_ticket_count"/>
                <field name="failed_ticket_count"/>
                <field name="closed_ticket_count"/>
                <field name="sla_success_rate"/>
                <field name="average_rating"/>
                <templates>
                    <t t-name="kanban-menu">
                        <div class="o_kanban_card_manage_section">
                            <div role="menuitem" class="o_kanban_card_manage_title">
                                <span>Tickets</span>
                            </div>
                            <div role="menuitem">
                                <a name="%(helpdesk_management_pro.helpdesk_management_pro_action_all_tickets)d" type="action" context="{'search_default_team_id': id, 'default_team_id': id}">All Tickets</a>
                            </div>
                            <div role="menuitem">
                                <a name="%(helpdesk_management_pro.helpdesk_management_pro_action_teams)d" type="action">Configuration</a>
                            </div>
                        </div>
                        <a role="menuitem" class="dropdown-item" name="%(helpdesk_management_pro.helpdesk_management_pro_action_teams)d" type="action">Settings</a>
                        <div role="separator" class="dropdown-divider"/>
                        <ul role="menuitem" class="oe_kanban_colorpicker" data-field="color"/>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_content">
                                <div class="o_kanban_primary_left pb-2 border-bottom border-dark">
                                    <div class="o_primary mb-2 font-weight-bold">
                                        <span><t t-esc="record.name.value"/></span>
                                    </div>
                                </div>
                                <div class="kanban-middle-row d-flex justify-content-between align-items-center mt-3 mb-3">
                                    <div class="left-action">
                                        <button class="btn btn-tickets bg-purple text-white" name="%(helpdesk_management_pro.helpdesk_management_pro_action_all_tickets)d" type="action" context="{'search_default_team_id': id, 'default_team_id': id}">
                                            Tickets
                                        </button>
                                    </div>
                                    <div class="right-stats text-end">
                                        <div class="stat-line d-flex justify-content-between">
                                            <span class="stat-label text-success me-4">Tickets Closed</span>
                                            <span class="stat-value text-success"><t t-esc="record.closed_ticket_count.value"/></span>
                                        </div>
                                        <div class="stat-line d-flex justify-content-between">
                                            <span class="stat-label text-success me-4">SLA Success Rate</span>
                                            <span class="stat-value text-success"><t t-esc="record.sla_success_rate.value"/> %</span>
                                        </div>
                                        <div class="stat-line d-flex justify-content-between">
                                            <span class="stat-label text-success me-4">Average Rating</span>
                                            <span class="stat-value text-success">
                                                <t t-if="record.average_rating.raw_value &lt; 4.0">
                                                    <i class="fa fa-frown-o text-warning me-1"></i>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-smile-o text-success me-1"></i>
                                                </t>
                                                <t t-esc="Math.round(record.average_rating.raw_value)"/> / 5
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_bottom">
                                <div class="kanban-stats-row w-100">
                                    <div class="stat-col">
                                        <div class="count"><t t-esc="record.open_ticket_count.value"/></div>
