<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_management_pro_view_fsm_order_form_inherit" model="ir.ui.view">
        <field name="name">field.service.order.form.helpdesk.inherit</field>
        <field name="model">field.service.order</field>
        <field name="inherit_id" ref="hudson_field_service.field_service_order_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="helpdesk_ticket_id" readonly="1" invisible="not helpdesk_ticket_id"/>
            </xpath>
        </field>
    </record>
</odoo>
