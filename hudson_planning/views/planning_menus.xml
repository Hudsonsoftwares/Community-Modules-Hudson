<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ROOT MENU                                                     -->
    <!-- ============================================================ -->

    <menuitem
        name="Planning"
        id="menu_planning_root"
        groups="hudson_planning.group_planning_user"
        web_icon="hudson_planning,static/description/icon.png"
        sequence="56"
    />

    <!-- ============================================================ -->
    <!-- PLANNING                                                      -->
    <!-- ============================================================ -->

    <record id="action_fs_planning_slot_list" model="ir.actions.act_window">
        <field name="name">All Shifts</field>
        <field name="res_model">fs.planning.slot</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="fs_planning_slot_view_search"/>
    </record>

    <menuitem
        name="Schedule"
        id="menu_planning_schedule"
        parent="menu_planning_root"
        sequence="5"
    >
        <menuitem
            name="By Resource"
            id="menu_planning_board"
            action="action_fs_planning_schedule"
            groups="hudson_planning.group_planning_manager"
            sequence="1"
        />
        <menuitem
            name="Generate Shifts"
            id="menu_fs_generate_shifts"
            action="action_fs_shift_template_apply_wizard"
            sequence="10"
            groups="hudson_planning.group_planning_manager"
        />
        <menuitem
            name="All Shifts"
            id="menu_fs_all_shifts"
            action="action_fs_planning_slot_list"
            sequence="15"
        />
    </menuitem>

    <!-- ============================================================ -->
    <!-- CONFIGURATION                                                 -->
    <!-- ============================================================ -->

    <menuitem
        name="Configuration"
        id="menu_planning_config"
        parent="menu_planning_root"
        groups="hudson_planning.group_planning_manager"
        sequence="100"
    >
        <menuitem
            name="Roles"
            id="menu_fs_planning_roles"
            action="action_fs_planning_role"
            sequence="30"
        />
        <menuitem
            name="Shift Templates"
            id="menu_fs_shift_templates"
            action="action_fs_shift_template"
            sequence="40"
        />
    </menuitem>

</odoo>
