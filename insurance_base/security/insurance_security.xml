<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_insurance" model="ir.module.category">
        <field name="name">Insurance</field>
        <field name="description">Patient health insurance</field>
        <field name="sequence">61</field>
    </record>

    <record id="res_groups_privilege_insurance" model="res.groups.privilege">
        <field name="name">Insurance</field>
        <field name="sequence">61</field>
        <field name="category_id" ref="insurance_base.module_category_insurance"/>
    </record>

    <!-- Front desk / clinicians: record policies, check eligibility -->
    <record id="group_insurance_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="insurance_base.res_groups_privilege_insurance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Records patient policies and runs eligibility checks.</field>
    </record>

    <!-- Managers: insurers, TPAs, plans and coverage rules -->
    <record id="group_insurance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="insurance_base.res_groups_privilege_insurance"/>
        <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sets up insurance companies, TPAs, plans and coverage rules.</field>
    </record>
</odoo>
