<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_dental_sign" model="ir.ui.view">
        <field name="name">product.template.form.dental.sign</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="dental_catalog.view_product_template_form_inherit_dental"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_consent_required']" position="after">
                <field name="consent_template_id" invisible="not is_consent_required" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
