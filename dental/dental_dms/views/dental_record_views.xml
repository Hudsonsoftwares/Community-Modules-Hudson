<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Patient ============ -->
    <record id="view_partner_form_dental_dms" model="ir.ui.view">
        <field name="name">res.partner.form.dental.dms</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="is_dental_patient" invisible="1"/>
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not is_dental_patient" groups="base.group_user">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document" invisible="not is_dental_patient" groups="base.group_user"/>
            </div>
        </field>
    </record>

    <!-- ============ Dental Case (consultation file + odontogram) ============ -->
    <record id="view_dental_case_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.case.form.dental.dms</field>
        <field name="model">dental.case</field>
        <field name="inherit_id" ref="dental_core.view_dental_case_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Smart button once the case has files; uploading is in the Actions menu -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not dental_document_count">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Actions (cog) menu of the case form: clinical tools (sequence 20-29) -->
    <record id="action_server_dental_case_upload_document" model="ir.actions.server">
        <field name="name">Upload Document</field>
        <field name="model_id" ref="dental_core.model_dental_case"/>
        <field name="binding_model_id" ref="dental_core.model_dental_case"/>
        <field name="binding_view_types">form</field>
        <field name="sequence">22</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = record.action_dental_add_document()</field>
    </record>

    <!-- ============ Consultation / Clinical Examination ============ -->
    <record id="view_dental_clinical_examination_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.clinical.examination.form.dental.dms</field>
        <field name="model">dental.clinical.examination</field>
        <field name="inherit_id" ref="dental_core.view_dental_clinical_examination_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                        <field name="dental_document_count" widget="statinfo" string="Documents"/>
                    </button>
                    <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                            string="Add Document"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============ Treatment Plan (+ consent) ============ -->
    <record id="view_dental_treatment_plan_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form.dental.dms</field>
        <field name="model">dental.treatment.plan</field>
        <field name="inherit_id" ref="dental_core.view_dental_treatment_plan_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dental_add_consent" type="object" string="Add Signed Consent" icon="fa-pencil-square-o"
                        invisible="not dental_consent_required or dental_consent_count"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="dental_consent_required" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not dental_consent_required or dental_consent_count">
                    <i class="fa fa-exclamation-triangle me-1"/>This plan contains treatments that require a signed patient consent,
                    and no signed consent form has been filed yet.
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-file-signature"
                        context="{'dental_dms_consent_only': True}" invisible="not dental_consent_required">
                    <field name="dental_consent_count" widget="statinfo" string="Consents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Treatment Session ============ -->
    <record id="view_dental_treatment_session_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.treatment.session.form.dental.dms</field>
        <field name="model">dental.treatment.session</field>
        <field name="inherit_id" ref="dental_core.view_dental_treatment_session_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Appointment ============ -->
    <record id="view_dental_appointment_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.appointment.form.dental.dms</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="dental_appointment.view_dental_appointment_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Tooth Finding (odontogram) ============ -->
    <record id="view_dental_tooth_finding_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.tooth.finding.form.dental.dms</field>
        <field name="model">dental.tooth.finding</field>
        <field name="inherit_id" ref="dental_core.view_dental_tooth_finding_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                        <field name="dental_document_count" widget="statinfo" string="Documents"/>
                    </button>
                    <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                            string="Add Document"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============ Billing ============ -->
    <record id="view_move_form_dental_dms" model="ir.ui.view">
        <field name="name">account.move.form.dental.dms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not dental_document_count">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ============ Employees ============ -->
    <record id="view_employee_form_dental_dms" model="ir.ui.view">
        <field name="name">hr.employee.form.dental.dms</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        groups="hr.group_hr_user,dental_base.group_dental_admin">
                    <field name="dental_document_count" widget="statinfo" string="Staff Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document" groups="hr.group_hr_user,dental_base.group_dental_admin"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Purchase ============ -->
    <record id="view_purchase_order_form_dental_dms" model="ir.ui.view">
        <field name="name">purchase.order.form.dental.dms</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not dental_document_count">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ============ CRM Lead (Dental Enquiry) ============ -->
    <record id="view_crm_lead_form_dental_dms" model="ir.ui.view">
        <field name="name">crm.lead.form.dental.dms</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not patient_id and not dental_document_count">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document" invisible="not patient_id"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Previous Records & X-Rays Record ============ -->
    <record id="view_dental_patient_document_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.patient.document.form.dental.dms</field>
        <field name="model">dental.patient.document</field>
        <field name="inherit_id" ref="dental_core.view_dental_patient_document_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                        <field name="dental_document_count" widget="statinfo" string="DMS File"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Patient Form: Navigation action in Previous Records & X-Rays tab -->
    <record id="view_partner_form_dental_dms_tab" model="ir.ui.view">
        <field name="name">res.partner.form.dental.dms.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="dental_core.view_res_partner_form_inherit_dental_core"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='patient_documents']" position="inside">
                <div class="mt-3 d-flex gap-2">
                    <button name="action_dental_documents" type="object" class="btn btn-outline-primary" icon="fa-folder-open" string="Open Patient Documents in DMS"/>
                    <button name="action_dental_add_document" type="object" class="btn btn-primary" icon="fa-upload" string="Upload Document to DMS"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
