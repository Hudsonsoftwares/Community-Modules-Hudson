<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Recurring invoices are generated by hudson_subscriptions' own cron; this one only
             handles dental lifecycle: expiry, renewal reminders and overdue payment reminders. -->
        <record id="ir_cron_dental_subscription_lifecycle" model="ir.cron">
            <field name="name">Dental Memberships: Expiry &amp; Payment Reminders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_dental_subscription_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
