<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_subscription_benefit_list" model="ir.ui.view">
        <field name="name">dental.subscription.benefit.list</field>
        <field name="model">dental.subscription.benefit</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="order_id"/>
                <field name="partner_id" optional="show"/>
                <field name="name"/>
                <field name="benefit_type"/>
                <field name="discount" invisible="benefit_type != 'discount'"/>
                <field name="quantity_limit" string="Allowed"/>
                <field name="limit_period"/>
                <field name="period_label" optional="show"/>
                <field name="used_qty"/>
                <field name="remaining_qty" invisible="is_unlimited"/>
                <field name="is_unlimited" column_invisible="1"/>
                <field name="total_used_qty" optional="hide"/>
                <field name="subscription_state" widget="badge" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_view_usage" type="object" string="Usage" icon="fa-list"/>
            </list>
        </field>
    </record>

    <record id="view_dental_subscription_benefit_form" model="ir.ui.view">
        <field name="name">dental.subscription.benefit.form</field>
        <field name="model">dental.subscription.benefit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="total_used_qty" widget="statinfo" string="Uses"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="order_id" readonly="id"/>
                            <field name="partner_id"/>
                            <field name="treatment_id" options="{'no_create': True}" invisible="treatment_plan_id"/>
                            <field name="treatment_category_id" options="{'no_create': True}" invisible="treatment_plan_id"/>
                            <field name="treatment_plan_id" readonly="1" invisible="not treatment_plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="benefit_type"/>
                            <field name="discount" invisible="benefit_type != 'discount'" required="benefit_type == 'discount'"/>
                            <field name="quantity_limit"/>
                            <field name="limit_period"/>
                            <field name="period_label"/>
                            <field name="used_qty"/>
                            <field name="is_unlimited" invisible="1"/>
                            <field name="remaining_qty" invisible="is_unlimited"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_subscription_benefit_search" model="ir.ui.view">
        <field name="name">dental.subscription.benefit.search</field>
        <field name="model">dental.subscription.benefit</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="treatment_id"/>
                <filter name="filter_running" string="Running Subscriptions"
                        domain="[('order_id.subscription_state', 'in', ('3_progress', '4_paused', '5_renew'))]"/>
                <filter name="filter_covered" string="Fully Covered" domain="[('benefit_type', '=', 'covered')]"/>
                <filter name="filter_discount" string="Discounts" domain="[('benefit_type', '=', 'discount')]"/>
                <group>
                    <filter name="group_order" string="Subscription" context="{'group_by': 'order_id'}"/>
                    <filter name="group_treatment" string="Treatment" context="{'group_by': 'treatment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_subscription_benefits" model="ir.actions.act_window">
        <field name="name">Member Benefits</field>
        <field name="res_model">dental.subscription.benefit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_running': 1}</field>
    </record>

    <!-- Benefit usage = the invoice lines that applied a benefit -->
    <record id="view_benefit_usage_list" model="ir.ui.view">
        <field name="name">account.move.line.dental.benefit.usage</field>
        <field name="model">account.move.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id" string="Invoice"/>
                <field name="partner_id" string="Patient"/>
                <field name="product_id" string="Treatment"/>
                <field name="name" optional="hide"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="dental_subscription_id"/>
                <field name="dental_subscription_benefit_id"/>
                <field name="parent_state" widget="badge" decoration-muted="parent_state == 'cancel'"
                       decoration-success="parent_state == 'posted'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_benefit_usage_search" model="ir.ui.view">
        <field name="name">account.move.line.dental.benefit.usage.search</field>
        <field name="model">account.move.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Patient"/>
                <field name="dental_subscription_id"/>
                <field name="product_id" string="Treatment"/>
                <filter name="filter_not_cancelled" string="Not Cancelled" domain="[('parent_state', '!=', 'cancel')]"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_subscription" string="Subscription" context="{'group_by': 'dental_subscription_id'}"/>
                    <filter name="group_product" string="Treatment" context="{'group_by': 'product_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_benefit_usage" model="ir.actions.act_window">
        <field name="name">Benefit Usage</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_benefit_usage_list"/>
        <field name="search_view_id" ref="view_benefit_usage_search"/>
        <field name="domain">[('dental_subscription_benefit_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_not_cancelled': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No membership benefit used yet</p>
            <p>When a visit or treatment of a member is billed, covered or discounted lines appear here.</p>
        </field>
    </record>
</odoo>
