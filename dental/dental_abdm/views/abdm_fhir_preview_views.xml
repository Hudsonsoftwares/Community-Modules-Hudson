<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abdm_fhir_preview_view_form" model="ir.ui.view">
        <field name="name">abdm.fhir.preview.form</field>
        <field name="model">abdm.fhir.preview</field>
        <field name="arch" type="xml">
            <form string="ABDM Records">
                <p class="text-muted">
                    These are the health records ABDM receives when the patient approves a request.
                    Each line is one record (FHIR document).
                </p>
                <field name="summary" nolabel="1" class="fw-bold"/>
                <field name="content" widget="code" options="{'mode': 'javascript'}" nolabel="1"/>
                <footer>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
