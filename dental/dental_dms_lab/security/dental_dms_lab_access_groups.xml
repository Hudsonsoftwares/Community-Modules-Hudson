<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dms_group_laboratory" model="dms.access.group">
            <field name="name">Dental - Laboratory</field>
            <field name="group_ids" eval="[(4, ref('dental_lab.group_dental_lab_technician')), (4, ref('dental_lab.group_dental_lab_user')), (4, ref('dental_lab.group_dental_lab_manager'))]"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="dental_lab.group_dental_lab_technician" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dental_lab.group_dental_lab_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
    </data>
</odoo>
