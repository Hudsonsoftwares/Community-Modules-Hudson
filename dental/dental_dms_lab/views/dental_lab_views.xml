<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_order_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.lab.order.form.dental.dms</field>
        <field name="model">dental.lab.order</field>
        <field name="inherit_id" ref="dental_lab.view_dental_lab_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document"/>
            </xpath>
        </field>
    </record>

    <!-- Documents Menu in Dental Lab App -->
    <menuitem id="menu_dental_lab_documents"
              name="Lab Documents"
              parent="dental_lab.menu_dental_lab_root"
              action="dental_dms.action_dental_documents_clinical"
              sequence="85"
              groups="dental_lab.group_dental_lab_technician,dental_lab.group_dental_lab_user,dental_lab.group_dental_lab_manager"/>
</odoo>
