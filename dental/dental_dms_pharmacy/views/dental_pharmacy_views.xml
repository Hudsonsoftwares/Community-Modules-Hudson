<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_prescription_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.prescription.form.dental.dms</field>
        <field name="model">dental.prescription</field>
        <field name="inherit_id" ref="dental_pharmacy.view_dental_prescription_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_dental_add_document" type="object" class="oe_stat_button" icon="fa-upload"
                        string="Add Document"/>
            </xpath>
        </field>
    </record>

    <record id="view_dental_pharmacy_dispense_form_dental_dms" model="ir.ui.view">
        <field name="name">dental.pharmacy.dispense.form.dental.dms</field>
        <field name="model">dental.pharmacy.dispense</field>
        <field name="inherit_id" ref="dental_pharmacy.view_dental_pharmacy_dispense_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dental_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                    <field name="dental_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
