<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dms_group_pharmacy" model="dms.access.group">
            <field name="name">Dental - Pharmacy</field>
            <field name="group_ids" eval="[(4, ref('dental_pharmacy.group_dental_pharmacist')), (4, ref('dental_pharmacy.group_dental_pharmacy_manager'))]"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="dental_pharmacy.group_dental_pharmacist" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dental_pharmacy.group_dental_pharmacy_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
    </data>
</odoo>
