<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_dental_pharmacy_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dental.pharmacy.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dental_pharmacy.res_config_settings_view_form_inherit_dental_pharmacy"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='dental_has_pharmacy_setting']" position="after">
                <setting id="dental_dispense_mode_setting" string="Dispensing Mode" invisible="not dental_has_pharmacy"
                         help="Where this branch dispenses and bills prescribed medicines. Point of Sale Counter: the pharmacist loads the prescription at a POS pharmacy counter, takes the payment and the counter invoices it; the dispense record and the prescription are updated automatically.">
                    <field name="dental_dispense_mode" widget="radio"/>
                    <div class="text-muted small mt-1" invisible="dental_dispense_mode != 'pos'">
                        Mark a Point of Sale as <b>Pharmacy Counter</b> (Point of Sale &gt; Configuration &gt; Point of Sales).
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Point of Sale > Configuration > Settings: mark the selected shop as a pharmacy counter -->
    <record id="res_config_settings_view_form_inherit_pos_dental_pharmacy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.dental.pharmacy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="before">
                <block title="Dental Pharmacy" id="pos_dental_pharmacy_section">
                    <setting id="pos_dental_pharmacy_counter" string="Pharmacy Counter"
                             help="Load the doctors' prescriptions at this shop (Prescriptions button), warn about allergies, sell the earliest-expiring batch and invoice every sale. Reload the open POS screen after saving.">
                        <field name="pos_dental_pharmacy_counter"/>
                        <div class="content-group mt16" invisible="not pos_dental_pharmacy_counter">
                            <div class="row mb-2">
                                <label string="Walk-in Customer" for="pos_dental_walkin_partner_id" class="col-lg-4 o_light_label"/>
                                <field name="pos_dental_walkin_partner_id" required="pos_dental_pharmacy_counter" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label string="Prescriptions of the last (days)" for="pos_dental_rx_lookback_days" class="col-lg-4 o_light_label"/>
                                <field name="pos_dental_rx_lookback_days"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
