<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clinic Configuration: does this clinic have its own pharmacy? -->
    <record id="view_res_company_dental_configuration_pharmacy" model="ir.ui.view">
        <field name="name">res.company.dental.configuration.pharmacy</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dental_base.view_res_company_dental_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='operations_main']" position="inside">
                <group string="Prescriptions &amp; Pharmacy" name="operations_pharmacy">
                    <field name="dental_has_pharmacy"/>
                    <div colspan="2" class="text-muted small">
                        On: prescriptions go to the pharmacy queue as a sales order.
                        Off: prescriptions are printed / emailed to the patient to buy outside.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Clinic Branch Form: pharmacy setting -->
    <record id="view_res_company_dental_branch_pharmacy" model="ir.ui.view">
        <field name="name">res.company.dental.branch.form.pharmacy</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dental_base.view_dental_clinic_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='operations_main']" position="inside">
                <group string="Prescriptions &amp; Pharmacy" name="operations_pharmacy">
                    <field name="dental_has_pharmacy"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
