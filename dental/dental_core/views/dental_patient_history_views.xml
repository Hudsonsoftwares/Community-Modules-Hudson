<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only, cross-branch: rows from other branches are highlighted and cannot be opened as records -->
    <record id="view_dental_patient_history_list" model="ir.ui.view">
        <field name="name">dental.patient.history.list</field>
        <field name="model">dental.patient.history</field>
        <field name="arch" type="xml">
            <list string="Clinical Timeline (All Branches)" create="0" edit="0" delete="0" decoration-info="other_branch">
                <field name="other_branch" column_invisible="1"/>
                <field name="event_time" string="When" widget="datetime"/>
                <field name="date" optional="hide"/>
                <field name="record_type" widget="badge"
                       decoration-primary="record_type == 'visit'"
                       decoration-danger="record_type == 'diagnosis'"
                       decoration-success="record_type in ('session', 'prescription')"
                       decoration-warning="record_type in ('plan', 'lab')"
                       decoration-info="record_type in ('consultation', 'finding')"/>
                <field name="reference"/>
                <field name="tooth" optional="show"/>
                <field name="description" optional="show"/>
                <field name="status" optional="show"/>
                <field name="doctor_name" optional="show"/>
                <field name="branch_name" optional="show"/>
                <field name="case_reference" optional="hide"/>
                <field name="patient_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dental_patient_history_form" model="ir.ui.view">
        <field name="name">dental.patient.history.form</field>
        <field name="model">dental.patient.history</field>
        <field name="arch" type="xml">
            <form string="Treatment History" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="reference"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="record_type"/>
                            <field name="date"/>
                            <field name="tooth" invisible="not tooth"/>
                            <field name="status" invisible="not status"/>
                        </group>
                        <group>
                            <field name="branch_name"/>
                            <field name="doctor_name"/>
                            <field name="case_reference" invisible="not case_reference"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_patient_history_search" model="ir.ui.view">
        <field name="name">dental.patient.history.search</field>
        <field name="model">dental.patient.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="reference"/>
                <field name="tooth"/>
                <field name="description"/>
                <field name="doctor_name"/>
                <field name="branch_name"/>
                <filter string="Visits" name="visits" domain="[('record_type', '=', 'visit')]"/>
                <filter string="Examinations &amp; Notes" name="consultations" domain="[('record_type', 'in', ('case', 'consultation'))]"/>
                <filter string="Diagnoses" name="diagnoses" domain="[('record_type', '=', 'diagnosis')]"/>
                <filter string="Odontogram" name="findings" domain="[('record_type', '=', 'finding')]"/>
                <filter string="Treatments" name="treatments" domain="[('record_type', 'in', ('plan', 'session'))]"/>
                <filter string="Prescriptions" name="prescriptions" domain="[('record_type', '=', 'prescription')]"/>
                <filter string="Lab Orders" name="lab_orders" domain="[('record_type', '=', 'lab')]"/>
                <filter string="Records / X-Rays" name="documents" domain="[('record_type', '=', 'document')]"/>
                <separator/>
                <filter string="This Branch" name="this_branch" domain="[('branch_id', 'in', allowed_company_ids)]"/>
                <filter string="Other Branches" name="other_branches" domain="[('branch_id', 'not in', allowed_company_ids)]"/>
                <group>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_name'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'record_type'}"/>
                    <filter string="Case" name="group_by_case" context="{'group_by': 'case_reference'}"/>
                    <filter string="Day" name="group_by_day" context="{'group_by': 'event_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_patient_timeline" model="ir.actions.act_window">
        <field name="name">Clinical Timeline</field>
        <field name="res_model">dental.patient.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dental_patient_history_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No clinical history recorded yet.</p></field>
    </record>
</odoo>
