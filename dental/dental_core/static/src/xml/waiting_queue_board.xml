<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dental_core.WaitingQueueBoard">
        <div class="dental-queue-display-container" t-att-class="{'tv-fullscreen-mode': this.state.is_tv_mode}">
            <!-- 1. Top Clinic & TV Display Header -->
            <header class="queue-tv-header">
                <div class="header-left">
                    <div class="clinic-brand-mark">
                        <i class="fa fa-stethoscope"/>
                    </div>
                    <div class="clinic-info">
                        <div class="clinic-title-row">
                            <h1 class="clinic-name"><t t-out="this.state.clinic_name"/></h1>
                            <span class="live-status-pill">
                                <span class="pulse-dot"></span>
                                LIVE
                            </span>
                        </div>
                        <div class="clinic-address-row">
                            <i class="fa fa-map-marker me-1 text-primary opacity-75"/>
                            <span><t t-out="this.state.clinic_address"/></span>
                        </div>
                    </div>
                </div>

                <div class="header-center">
                    <div class="tv-stats-bar">
                        <div class="stat-pill stat-total">
                            <i class="fa fa-users me-1 text-primary"/>
                            <span class="stat-val"><t t-out="this.state.stats.total_patients_today"/></span>
                            <span class="stat-lbl">Patients Today</span>
                        </div>
                        <div class="stat-pill stat-serving">
                            <i class="fa fa-user-md me-1 text-info"/>
                            <span class="stat-val"><t t-out="this.state.stats.now_serving_count"/></span>
                            <span class="stat-lbl">Now Serving</span>
                        </div>
                        <div class="stat-pill stat-waiting">
                            <i class="fa fa-clock-o me-1 text-warning"/>
                            <span class="stat-val"><t t-out="this.state.stats.waiting_count"/></span>
                            <span class="stat-lbl">Waiting Queue</span>
                        </div>
                    </div>
                </div>

                <div class="header-right">
                    <div class="tv-clock-widget">
                        <div class="clock-time"><t t-out="this.state.currentTimeStr"/></div>
                        <div class="clock-date"><t t-out="this.state.currentDateStr"/></div>
                    </div>

                    <div class="header-action-btns">
                        <!-- Sound Alert Toggle -->
                        <button class="btn-tv-control" 
                                t-att-class="{'active': this.state.sound_enabled}"
                                t-on-click="() => this.toggleSound()"
                                title="Toggle Audio Call Chime">
                            <i t-attf-class="fa #{this.state.sound_enabled ? 'fa-bell text-warning' : 'fa-bell-slash text-muted'}"/>
                        </button>

                        <!-- Refresh Button -->
                        <button class="btn-tv-control" 
                                t-on-click="() => this.loadQueueData(true)"
                                title="Refresh Queue Data">
                            <i class="fa fa-refresh text-primary"/>
                        </button>

                        <!-- Table / List View Switcher -->
                        <button class="btn-tv-control btn-switch-list" 
                                t-on-click="() => this.switchToList()"
                                title="Switch to List/Table View">
                            <i class="fa fa-list me-1"/>
                            <span>List View</span>
                        </button>

                        <!-- TV Fullscreen Toggle -->
                        <button class="btn-tv-control btn-fullscreen-toggle" 
                                t-on-click="() => this.toggleFullscreen()"
                                title="Toggle TV Fullscreen Mode">
                            <i t-attf-class="fa #{this.state.is_tv_mode ? 'fa-compress' : 'fa-television me-1'}"/>
                            <span t-if="!this.state.is_tv_mode">TV Display</span>
                        </button>
                    </div>
                </div>
            </header>

            <!-- 2. Main Operatory Columns Display -->
            <main class="queue-operatory-board">
                <t t-if="this.state.loading">
                    <div class="queue-loading-state">
                        <div class="spinner-grow text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading queue...</span>
                        </div>
                        <h4 class="mt-3 text-secondary fw-semibold">Syncing Real-Time Clinic Queue...</h4>
                    </div>
                </t>

                <t t-elif="!this.state.doctors || this.state.doctors.length === 0">
                    <div class="queue-empty-board">
                        <div class="empty-icon-box">
                            <i class="fa fa-user-md fa-3x text-muted"/>
                        </div>
                        <h3 class="mt-3 fw-bold text-dark">No Active Operatories Today</h3>
                        <p class="text-secondary max-w-500">
                            No doctors currently scheduled or checked in. Appointments scheduled for today will appear here as doctors and patients arrive.
                        </p>
                    </div>
                </t>

                <t t-else="">
                    <div class="operatory-columns-grid" t-attf-style="grid-template-columns: repeat(#{Math.min(this.state.doctors.length, 4)}, minmax(320px, 1fr));">
                        <t t-foreach="this.state.doctors" t-as="doc" t-key="doc.doctor_id">
                            <div class="operatory-column-card shadow-sm" t-att-style="'--accent-color: ' + doc.accent_color + '; --bg-tint: ' + doc.bg_tint + '; --border-color: ' + doc.border_color">
                                <!-- Operatory & Doctor Header -->
                                <div class="operatory-card-header">
                                    <div class="doctor-badge-info">
                                        <div class="doctor-avatar-circle">
                                            <img t-att-src="doc.avatar_url" alt="Doctor" onerror="this.src='/web/static/img/placeholder.png'"/>
                                        </div>
                                        <div class="doctor-meta">
                                            <h2 class="doctor-heading-name" t-att-style="'color: ' + doc.accent_color">
                                                <t t-out="doc.doctor_name"/>
                                            </h2>
                                            <div class="operatory-sub-tag">
                                                <t t-out="doc.operatory_title"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="queue-count-pill" t-att-style="'background: ' + doc.bg_tint + '; color: ' + doc.accent_color + '; border-color: ' + doc.border_color">
                                        <span class="count-num"><t t-out="doc.waiting_count"/></span>
                                        <span class="count-txt">WAITING</span>
                                    </div>
                                </div>

                                <!-- NOW SERVING SECTION (Hero Token Area) -->
                                <div class="now-serving-container">
                                    <div class="serving-header-label">
                                        <span class="serving-dot"></span>
                                        NOW SERVING
                                    </div>

                                    <t t-if="doc.now_serving">
                                        <div class="hero-token-card">
                                            <div class="hero-token-number" t-att-style="'color: ' + doc.accent_color">
                                                <t t-out="doc.now_serving.token"/>
                                            </div>
                                            <div class="hero-patient-name">
                                                <span class="p-name"><t t-out="doc.now_serving.patient_name"/></span>
                                                <span class="p-demo ms-1" t-if="doc.now_serving.demographics"><t t-out="doc.now_serving.demographics"/></span>
                                            </div>
                                            <div class="hero-treatment-badge">
                                                <i class="fa fa-check-circle me-1"/>
                                                <t t-out="doc.now_serving.treatment_name"/>
                                                <span class="elapsed-time ms-2" t-if="doc.now_serving.elapsed_mins > 0">
                                                    (<t t-out="doc.now_serving.elapsed_mins"/>m in visit)
                                                </span>
                                            </div>

                                            <!-- Receptionist Quick Action (hidden in TV Mode) -->
                                            <div class="hero-action-row" t-if="!this.state.is_tv_mode">
                                                <button class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 shadow-sm"
                                                        t-on-click="() => this.completeVisit(doc.now_serving)">
                                                    <i class="fa fa-check me-1"/> Mark Completed
                                                </button>
                                            </div>
                                        </div>
                                    </t>

                                    <t t-else="">
                                        <div class="hero-token-card hero-token-idle">
                                            <div class="idle-token-placeholder">— — —</div>
                                            <div class="idle-message">Doctor Ready • Operatory Available</div>
                                            <div class="idle-action-box" t-if="!this.state.is_tv_mode and doc.waiting_queue.length > 0">
                                                <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-sm"
                                                        t-att-style="'background: ' + doc.accent_color + '; border-color: ' + doc.accent_color"
                                                        t-on-click="() => this.callNextPatient(doc.waiting_queue[0])">
                                                    <i class="fa fa-bullhorn me-1"/> Call Next Patient
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <!-- WAITING QUEUE LIST SECTION -->
                                <div class="waiting-queue-section">
                                    <div class="section-title-bar">
                                        <span class="section-title">WAITING QUEUE</span>
                                        <span class="section-count-badge badge rounded-pill bg-light text-dark border">
                                            <t t-out="doc.waiting_count"/> in line
                                        </span>
                                    </div>

                                    <div class="waiting-queue-scroll-area">
                                        <t t-if="doc.waiting_queue and doc.waiting_queue.length > 0">
                                            <div class="waiting-patients-list">
                                                <t t-foreach="doc.waiting_queue" t-as="item" t-key="item.id">
                                                    <div class="queue-row-item" t-att-class="{'is-next-item': item.is_next, 'is-emergency-item': item.is_emergency}">
                                                        <!-- Token and Next Badge -->
                                                        <div class="queue-token-cell">
                                                            <span class="token-code-pill" t-att-class="{'token-next-pill': item.is_next}" t-att-style="item.is_next ? ('color: ' + doc.accent_color + '; border-color: ' + doc.accent_color) : ''">
                                                                <t t-out="item.token"/>
                                                            </span>
                                                            <span class="next-badge-chip" t-if="item.is_next" t-att-style="'background: ' + doc.accent_color">
                                                                NEXT
                                                            </span>
                                                            <span class="emergency-badge-chip badge bg-danger text-white ms-1" t-if="item.is_emergency">
                                                                EMERGENCY
                                                            </span>
                                                        </div>

                                                        <!-- Patient Demographics -->
                                                        <div class="queue-patient-cell">
                                                            <div class="queue-patient-name-row">
                                                                <span class="q-patient-name"><t t-out="item.patient_name"/></span>
                                                                <span class="q-patient-demo ms-1" t-if="item.demographics"><t t-out="item.demographics"/></span>
                                                            </div>
                                                            <div class="queue-treatment-sub">
                                                                <t t-out="item.treatment_name"/>
                                                                <span class="q-wait-time text-muted ms-2" t-if="item.waiting_mins > 0">
                                                                    • <t t-out="item.waiting_mins"/>m wait
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- Quick Call Button for Receptionist -->
                                                        <div class="queue-action-cell" t-if="!this.state.is_tv_mode">
                                                            <button class="btn btn-sm btn-action-call rounded-pill"
                                                                    t-att-style="'color: ' + doc.accent_color + '; border-color: ' + doc.accent_color"
                                                                    t-on-click="() => this.callNextPatient(item)"
                                                                    title="Call to Operatory">
                                                                <i class="fa fa-bullhorn me-1"/> Call
                                                            </button>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>

                                        <t t-else="">
                                            <div class="queue-empty-substate">
                                                <i class="fa fa-check-circle-o fa-2x text-success opacity-50 mb-2"/>
                                                <div class="text-muted fw-semibold">No patients currently waiting</div>
                                            </div>
                                        </t>
                                    </div>
                                </div>

                                <!-- UPCOMING / SCHEDULED PREVIEW SECTION -->
                                <t t-if="doc.upcoming_list and doc.upcoming_list.length > 0">
                                    <div class="upcoming-preview-section" t-if="!this.state.is_tv_mode">
                                        <div class="upcoming-header">
                                            <span class="upcoming-title">UPCOMING TODAY (<t t-out="doc.upcoming_list.length"/>)</span>
                                        </div>
                                        <div class="upcoming-items-list">
                                            <t t-foreach="doc.upcoming_list.slice(0, 3)" t-as="up" t-key="up.id">
                                                <div class="upcoming-row-compact">
                                                    <span class="badge bg-light text-dark border me-2"><t t-out="up.scheduled_time"/></span>
                                                    <span class="up-p-name text-truncate"><t t-out="up.patient_name"/> <span class="text-muted" t-if="up.demographics"><t t-out="up.demographics"/></span></span>
                                                    <button class="btn btn-xs btn-outline-primary rounded-pill ms-auto px-2 py-0"
                                                            t-on-click="() => this.checkInPatient(up)">
                                                        Check In
                                                    </button>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </main>

            <!-- 3. TV Mode Floating Quick Exit Button -->
            <button class="btn-floating-tv-exit" 
                    t-if="this.state.is_tv_mode"
                    t-on-click="() => this.toggleFullscreen()"
                    title="Exit Fullscreen Mode">
                <i class="fa fa-times me-1"/> Exit TV Mode (ESC)
            </button>
        </div>
    </t>
</templates>
