<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_core.DentistDashboard">
        <div class="o_action o_dentist_dashboard_view w-100 h-100 overflow-auto">
            <div class="doctor-dashboard-container">
                
                <!-- TOP HEADER -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div class="greeting-header-box">
                        <h2 class="greeting-title fw-bold text-dark mb-1">
                            <t t-out="this.state.doctorInfo.greeting"/>
                        </h2>
                        <p class="greeting-subtitle text-muted mb-0">
                            <t t-out="this.state.doctorInfo.subtitle"/>
                        </p>
                    </div>
                    <div class="header-action-buttons d-flex align-items-center gap-3">
                        <button class="btn btn-primary-royal d-flex align-items-center gap-2 fw-semibold shadow-sm"
                                t-on-click="() => this.addAppointment()">
                            <span class="fs-5 lh-1">+</span> Add Appointment
                        </button>
                        <button class="btn btn-outline-clean d-flex align-items-center gap-2 fw-semibold shadow-sm"
                                t-on-click="() => this.generateInvoice()">
                            <span class="sparkle-icon">✦</span> Generate Invoice
                        </button>
                    </div>
                </div>

                <!-- TOP ROW: APPOINTMENTS OVERVIEW (LEFT) + 3 TOP KPI CARDS (RIGHT) -->
                <div class="row g-4 mb-4">
                    
                    <!-- Left: Appointments Overview Bar Chart Card -->
                    <div class="col-lg-5 col-md-12">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overview-chart-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-bold text-dark mb-0 fs-6">Appointments Overview</h5>
                                <div class="period-toggle-pills d-inline-flex p-1 rounded-pill">
                                    <button t-attf-class="period-pill #{this.state.chartPeriod === 'week' ? 'active' : ''}"
                                            t-on-click="() => this.setChartPeriod('week')">Week</button>
                                    <button t-attf-class="period-pill #{this.state.chartPeriod === 'month' ? 'active' : ''}"
                                            t-on-click="() => this.setChartPeriod('month')">Month</button>
                                    <button t-attf-class="period-pill #{this.state.chartPeriod === 'year' ? 'active' : ''}"
                                            t-on-click="() => this.setChartPeriod('year')">Year</button>
                                </div>
                            </div>

                            <!-- Bar Chart Visualizer -->
                            <div class="chart-visual-wrapper d-flex align-items-end pt-2 pb-2">
                                <!-- Y Axis Labels -->
                                <div class="chart-y-axis d-flex flex-column justify-content-between pe-3">
                                    <span>200</span>
                                    <span>150</span>
                                    <span>100</span>
                                    <span>50</span>
                                    <span>0</span>
                                </div>

                                <!-- Bars Columns -->
                                <div class="chart-bars-area d-flex justify-content-between align-items-end flex-grow-1 h-100">
                                    <t t-foreach="this.currentChartBars" t-as="bar" t-key="bar.label">
                                        <div class="chart-bar-column d-flex flex-column align-items-center">
                                            <!-- Track with fill inside -->
                                            <div class="bar-track position-relative" t-att-title="bar.label + ': ' + bar.count + ' appointments'">
                                                <div class="bar-fill" t-attf-style="height: #{bar.height_pct}%;"></div>
                                            </div>
                                            <!-- X Axis Label -->
                                            <span class="bar-x-label mt-2"><t t-out="bar.label"/></span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: 3 Metric KPI Cards (New Patients, Appointments Today, Treatment Today) -->
                    <div class="col-lg-7 col-md-12">
                        <div class="row g-3 h-100">
                            
                            <!-- 1. New Patients -->
                            <div class="col-md-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 kpi-metric-card p-3 d-flex flex-column justify-content-between"
                                     t-on-click="() => this.viewTotalPatients()">
                                    <div>
                                        <div class="kpi-card-title fw-bold text-dark mb-1">New Patients</div>
                                        <div class="kpi-card-subtext text-muted mb-2">Here is the number of total new patients today!</div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div class="kpi-main-number text-primary-royal fw-bold">
                                            <t t-out="this.state.kpiStats.new_patients_today"/>
                                        </div>
                                        <div class="kpi-illustration-box">
                                            <img src="/dental_core/static/src/img/kpi_tooth_new.png"
                                                 alt="New Patients Tooth"
                                                 class="kpi-3d-img" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Appointments Today -->
                            <div class="col-md-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 kpi-metric-card p-3 d-flex flex-column justify-content-between"
                                     t-on-click="() => this.viewAllAppointments()">
                                    <div>
                                        <div class="kpi-card-title fw-bold text-dark mb-1">Appointments Today</div>
                                        <div class="kpi-card-subtext text-muted mb-2">Here is the number of total appointments today!</div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div class="kpi-main-number text-cyan-modern fw-bold">
                                            <t t-out="this.state.kpiStats.appointments_today"/>
                                        </div>
                                        <div class="kpi-illustration-box">
                                            <img src="/dental_core/static/src/img/kpi_dental_chair.png"
                                                 alt="Dental Chair"
                                                 class="kpi-3d-img chair-img" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Treatment Today -->
                            <div class="col-md-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 kpi-metric-card p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="kpi-card-title fw-bold text-dark mb-1">Treatment Today</div>
                                        <div class="kpi-card-subtext text-muted mb-2">Here is the number of total treatment today!</div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div class="kpi-main-number text-dark-slate fw-bold">
                                            <t t-out="this.state.kpiStats.treatment_today"/>
                                        </div>
                                        <div class="kpi-illustration-box">
                                            <img src="/dental_core/static/src/img/kpi_treatment_tools_hd.png"
                                                 alt="Treatment Tools"
                                                 class="kpi-3d-img" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- MIDDLE / MAIN ROW: DOCTORS CARDS (LEFT) + UPCOMING APPOINTMENTS TABLE (RIGHT) -->
                <div class="row g-4 mb-4">
                    
                    <!-- Left: Current Doctor Profile Card -->
                    <div class="col-lg-5 col-md-12">
                        <div class="card border-0 shadow-sm rounded-4 doctor-hero-profile-card h-100 p-4 d-flex flex-column justify-content-between position-relative overflow-hidden">
                            <!-- Background decorative glow -->
                            <div class="doctor-card-bg-glow position-absolute"></div>
                            
                            <!-- Top: Avatar, Name, Specialization, On Duty status -->
                            <div class="d-flex flex-column align-items-center text-center position-relative z-1 pt-2">
                                <div class="doctor-photo-wrap position-relative mb-3">
                                    <img t-att-src="this.state.doctorInfo.avatar_url"
                                         t-att-alt="this.state.doctorInfo.name"
                                         class="doctor-portrait-img rounded-circle shadow" />
                                    <span class="doctor-online-pulse position-absolute" title="On Duty"></span>
                                </div>
                                <h4 class="doctor-card-name fw-bold mb-1 text-white">
                                    <t t-out="this.state.doctorInfo.display_name || this.state.doctorInfo.name"/>
                                </h4>
                                <span class="doctor-card-spec badge bg-white bg-opacity-25 text-white fw-medium px-3 py-1 rounded-pill mb-2">
                                    <t t-out="this.state.doctorInfo.specialization"/>
                                </span>
                                <div class="text-white-50 fs-8 d-flex align-items-center gap-1 justify-content-center">
                                    <i class="fa fa-hospital-o"></i>
                                    <span>Main Dental Clinic · Room 1</span>
                                </div>
                            </div>

                            <!-- Middle: Today's Metrics for This Doctor -->
                            <div class="doctor-performance-strip rounded-4 p-3 my-3 position-relative z-1 d-flex justify-content-around text-center">
                                <div class="perf-metric-item">
                                    <div class="perf-val fw-bold text-white fs-4">
                                        <t t-out="this.state.doctorInfo.today_appointments !== undefined ? this.state.doctorInfo.today_appointments : this.state.kpiStats.appointments_today"/>
                                    </div>
                                    <div class="perf-lbl text-white-50 fs-8">Visits Today</div>
                                </div>
                                <div class="vr bg-white opacity-25"></div>
                                <div class="perf-metric-item">
                                    <div class="perf-val fw-bold text-white fs-4">
                                        <t t-out="this.state.doctorInfo.completed_today !== undefined ? this.state.doctorInfo.completed_today : this.state.kpiStats.treatment_today"/>
                                    </div>
                                    <div class="perf-lbl text-white-50 fs-8">Completed</div>
                                </div>
                                <div class="vr bg-white opacity-25"></div>
                                <div class="perf-metric-item">
                                    <div class="perf-val fw-bold text-white fs-4">
                                        <t t-out="this.state.doctorInfo.waiting_today !== undefined ? this.state.doctorInfo.waiting_today : 0"/>
                                    </div>
                                    <div class="perf-lbl text-white-50 fs-8">Waiting</div>
                                </div>
                            </div>

                            <!-- Bottom: Quick Action Shortcuts -->
                            <div class="d-flex gap-2 position-relative z-1">
                                <button class="btn btn-light-glass btn-sm rounded-pill w-100 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2"
                                        t-on-click="() => this.openPatientQueue()">
                                    <i class="fa fa-users"></i> Patient Queue
                                </button>
                                <button class="btn btn-white-solid btn-sm rounded-pill w-100 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2"
                                        t-on-click="() => this.openMyAppointments()">
                                    <i class="fa fa-calendar-check-o"></i> My Schedule
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Upcoming Appointments Card -->
                    <div class="col-lg-7 col-md-12">
                        <div class="card border-0 shadow-sm rounded-4 upcoming-appointments-card p-4 h-100 d-flex flex-column justify-content-between">
                            
                            <div>
                                <!-- Header -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold text-dark mb-0 fs-6">Upcoming Appointments</h5>
                                    <button class="btn btn-view-all btn-sm rounded-pill fw-semibold px-3"
                                            t-on-click="() => this.viewAllAppointments()">
                                        View All
                                    </button>
                                </div>

                                <!-- Table -->
                                <div class="table-responsive upcoming-table-wrap">
                                    <table class="table table-borderless align-middle mb-0">
                                        <thead>
                                            <tr class="table-header-row">
                                                <th class="ps-2">Patient Name</th>
                                                <th>Treatment</th>
                                                <th>Doctor Name</th>
                                                <th>Time</th>
                                                <th class="text-end pe-2">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="this.state.upcomingAppointments.length === 0">
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-4">
                                                        No upcoming appointments found.
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="this.state.upcomingAppointments" t-as="appt" t-key="appt.id">
                                                <tr class="appointment-row cursor-pointer" t-on-click="() => this.openAppointment(appt.id)">
                                                    <td class="ps-2 fw-semibold text-dark">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="patient-text-name"><t t-out="appt.patient_name"/></span>
                                                        </div>
                                                    </td>
                                                    <td class="text-muted-dark">
                                                        <t t-out="appt.treatment"/>
                                                    </td>
                                                    <td class="text-muted-dark">
                                                        <t t-out="appt.doctor_name"/>
                                                    </td>
                                                    <td class="text-muted-dark">
                                                        <t t-out="appt.time"/>
                                                    </td>
                                                    <td class="text-end pe-2">
                                                        <span t-attf-class="status-text fw-bold #{appt.status_color}">
                                                            <t t-out="appt.status_label"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- BOTTOM ROW: 3 METRIC CARDS (TOTAL REVENUE, TOTAL PATIENTS, UPCOMING PATIENTS) -->
                <div class="row g-4">
                    
                    <!-- Left: Placeholder / Alignment for Left Column -->
                    <div class="col-lg-5 col-md-12 d-none d-lg-block">
                        <!-- Spacing column aligns with Doctors on top -->
                    </div>

                    <!-- Right Column: 3 Bottom KPI Cards aligned under Upcoming Appointments -->
                    <div class="col-lg-7 col-md-12">
                        <div class="row g-3">
                            
                            <!-- Total Revenue -->
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 bottom-kpi-card p-3">
                                    <div class="text-muted fs-7 mb-1">Total Revenue</div>
                                    <h4 class="fw-bold text-dark mb-0"><t t-out="this.state.kpiStats.total_revenue"/></h4>
                                </div>
                            </div>

                            <!-- Total Patients -->
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 bottom-kpi-card p-3 cursor-pointer"
                                     t-on-click="() => this.viewTotalPatients()">
                                    <div class="text-muted fs-7 mb-1">Total Patients</div>
                                    <div class="d-flex align-items-baseline gap-1">
                                        <h4 class="fw-bold text-dark mb-0"><t t-out="this.state.kpiStats.total_patients"/></h4>
                                        <span class="text-muted fs-8">/month</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Upcoming Patients -->
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 bottom-kpi-card p-3 d-flex flex-row justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted fs-7 mb-1">Upcoming Patients</div>
                                        <h4 class="fw-bold text-dark mb-0"><t t-out="this.state.kpiStats.upcoming_patients"/></h4>
                                    </div>
                                    <!-- Mini Sparkline Bars Indicator -->
                                    <div class="sparkline-bars d-flex align-items-end gap-1">
                                        <span class="spark-bar" style="height: 12px;"></span>
                                        <span class="spark-bar" style="height: 18px;"></span>
                                        <span class="spark-bar active" style="height: 24px;"></span>
                                        <span class="spark-bar" style="height: 15px;"></span>
                                        <span class="spark-bar active" style="height: 22px;"></span>
                                        <span class="spark-bar" style="height: 14px;"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </t>
</templates>
