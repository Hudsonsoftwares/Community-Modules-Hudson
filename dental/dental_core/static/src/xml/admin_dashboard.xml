<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_core.AdminDashboard">
        <div class="o_action o_dental_executive_dashboard">
            
            <!-- Main Dashboard Layout Body (Violet Navbar above is preserved, sub-navbar & left sidebar removed) -->
            <div class="dashboard-layout-body">
                
                <!-- Center Main Dashboard Area -->
                <main class="dashboard-main-content">
                    
                    <!-- Content Title Header -->
                    <div class="content-header">
                        <div>
                            <h1 class="title-heading">Dental Hospital Overview</h1>
                            <p class="subtitle-desc">Real-time view of clinic operations, patients and resources</p>
                        </div>
                        <div class="date-picker-badge">
                            <i class="fa fa-calendar-o me-1"/>
                            <span><t t-out="this.state.data.header.date_str"/></span>
                            <i class="fa fa-chevron-down ms-2 fs-8"/>
                        </div>
                    </div>

                    <!-- 3D Clinic Isometric Floorplan (Clean render without baked-in badges) -->
                    <div class="floorplan-card-container">
                        <img src="/dental_core/static/src/img/clinic_floorplan_clean_v2.png?v=2" 
                             alt="Dental Hospital 3D Layout" 
                             class="floorplan-image"/>

                        <!-- Interactive Overlaid Room Badges (Covering original image badges seamlessly) -->
                        <!-- 1. OPD -->
                        <div class="room-badge badge-opd" t-on-click="() => this.onRoomClick('opd')" title="Open OPD Queue">
                            <div class="badge-icon-wrap bg-purple"><i class="fa fa-users"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">OPD</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.opd.count"/> / <t t-out="this.state.data.floorplan.opd.capacity"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- 2. Dental Chairs -->
                        <div class="room-badge badge-chairs" t-on-click="() => this.onRoomClick('chairs')" title="View Active Dental Chairs">
                            <div class="badge-icon-wrap bg-blue"><i class="fa fa-wheelchair"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Dental Chairs</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.chairs.occupied"/> / <t t-out="this.state.data.floorplan.chairs.total"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- 3. Radiology (X-Ray) -->
                        <div class="room-badge badge-radiology" t-on-click="() => this.onRoomClick('radiology')" title="View Digital X-Rays">
                            <div class="badge-icon-wrap bg-teal"><i class="fa fa-picture-o"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Radiology (X-Ray)</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.radiology.count"/> / <t t-out="this.state.data.floorplan.radiology.capacity"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- 4. Laboratory -->
                        <div class="room-badge badge-lab" t-on-click="() => this.onRoomClick('lab')" title="View Dental Lab Orders">
                            <div class="badge-icon-wrap bg-amber"><i class="fa fa-flask"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Laboratory</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.lab.count"/> / <t t-out="this.state.data.floorplan.lab.capacity"/></span>
                            </div>
                            <span class="status-dot dot-amber"/>
                        </div>

                        <!-- 5. Reception -->
                        <div class="room-badge badge-reception" t-on-click="() => this.onRoomClick('reception')" title="Front Desk Check-in &amp; Queue">
                            <div class="badge-icon-wrap bg-blue"><i class="fa fa-user-circle-o"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Reception</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.reception.label"/></span>
                            </div>
                            <span class="status-dot dot-blue"/>
                        </div>

                        <!-- 6. Clinical -->
                        <div class="room-badge badge-clinical" t-on-click="() => this.onRoomClick('clinical')" title="Clinical Examination &amp; Cases">
                            <div class="badge-icon-wrap bg-blue"><i class="fa fa-stethoscope"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Clinical</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.clinical.active"/> / <t t-out="this.state.data.floorplan.clinical.capacity"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- 7. Pharmacy -->
                        <div class="room-badge badge-pharmacy" t-on-click="() => this.onRoomClick('pharmacy')" title="Pharmacy Dispensary">
                            <div class="badge-icon-wrap bg-rose"><i class="fa fa-medkit"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Pharmacy</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.pharmacy.status"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- 8. Sterilization -->
                        <div class="room-badge badge-sterilization" t-on-click="() => this.onRoomClick('sterilization')" title="Sterilization Status">
                            <div class="badge-icon-wrap bg-emerald"><i class="fa fa-check-circle"/></div>
                            <div class="badge-text-group">
                                <span class="badge-label">Sterilization</span>
                                <span class="badge-val"><t t-out="this.state.data.floorplan.sterilization.status"/></span>
                            </div>
                            <span class="status-dot dot-green"/>
                        </div>

                        <!-- Hospital Front Entrance Sign -->
                        <div class="clinic-front-banner">
                            <i class="fa fa-plus-square text-primary"/>
                            <span>DENTAL HOSPITAL</span>
                        </div>
                    </div>

                    <!-- Bottom Grid of 4 Cards -->
                    <div class="bottom-cards-grid">
                        
                        <!-- Card 1: Today's Patient Flow -->
                        <div class="dashboard-panel-card">
                            <div class="panel-card-header">
                                <h3 class="panel-title">
                                    <i class="fa fa-line-chart"/> Today's Patient Flow
                                </h3>
                                <div class="filter-dropdown-btn">
                                    <span>Today</span> <i class="fa fa-angle-down ms-1"/>
                                </div>
                            </div>

                            <!-- Interactive Smooth Flow Chart -->
                            <div class="patient-flow-chart-container">
                                <svg viewBox="0 0 360 100" preserveAspectRatio="none">
                                    <defs>
                                        <linearGradient id="patientFlowGradient" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.32"/>
                                            <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.0"/>
                                        </linearGradient>
                                    </defs>
                                    <!-- Area Fill -->
                                    <path t-att-d="this.state.data.patient_flow.area_path" fill="url(#patientFlowGradient)"/>
                                    <!-- Smooth Line -->
                                    <path t-att-d="this.state.data.patient_flow.line_path" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round"/>
                                    <!-- Peak Indicator Line -->
                                    <line t-att-x1="this.state.data.patient_flow.peak_x" y1="20" t-att-x2="this.state.data.patient_flow.peak_x" y2="100" stroke="#8b5cf6" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.6"/>
                                    <!-- Indicator Peak Dot -->
                                    <circle t-att-cx="this.state.data.patient_flow.peak_x" t-att-cy="this.state.data.patient_flow.peak_y" r="4.5" fill="#8b5cf6" stroke="#ffffff" stroke-width="2"/>
                                </svg>

                                <!-- Floating Tooltip Badge -->
                                <div class="chart-tooltip-badge" t-attf-style="left: #{this.state.data.patient_flow.peak_pct}%;">
                                    <div class="tooltip-val"><t t-out="this.state.data.patient_flow.peak_count"/> Patients</div>
                                    <div class="tooltip-time"><t t-out="this.state.data.patient_flow.peak_time"/></div>
                                </div>
                            </div>

                            <!-- Bottom 4 Flow Summary Stats -->
                            <div class="flow-stats-row">
                                <div class="flow-stat-col">
                                    <span class="stat-number c-purple"><t t-out="this.state.data.patient_flow.opd_visits"/></span>
                                    <span class="stat-title">OPD Visits</span>
                                </div>
                                <div class="flow-stat-col">
                                    <span class="stat-number c-green"><t t-out="this.state.data.patient_flow.new_patients"/></span>
                                    <span class="stat-title">New Patients</span>
                                </div>
                                <div class="flow-stat-col">
                                    <span class="stat-number c-orange"><t t-out="this.state.data.patient_flow.follow_ups"/></span>
                                    <span class="stat-title">Follow Ups</span>
                                </div>
                                <div class="flow-stat-col">
                                    <span class="stat-number c-red"><t t-out="this.state.data.patient_flow.cancellations"/></span>
                                    <span class="stat-title">Cancellations</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Today's Appointments -->
                        <div class="dashboard-panel-card">
                            <div class="panel-card-header">
                                <h3 class="panel-title">
                                    <i class="fa fa-calendar"/> Today's Appointments
                                </h3>
                                <button class="view-all-pill-btn" t-on-click="() => this.navigateTo('appointments')">
                                    View All
                                </button>
                            </div>

                            <div class="appointment-list-wrapper">
                                <t t-if="this.state.data.today_appointments.length === 0">
                                    <div class="text-center text-muted py-3">No appointments scheduled for today.</div>
                                </t>
                                <t t-foreach="this.state.data.today_appointments" t-as="appt" t-key="appt.id || appt.patient_name">
                                    <div class="appt-row-item" t-on-click="() => this.openAppointment(appt.id)">
                                        <div class="appt-time"><t t-out="appt.time"/></div>
                                        <div class="appt-avatar">
                                            <t t-out="appt.patient_name[0]"/>
                                        </div>
                                        <div class="appt-details">
                                            <div class="patient-name"><t t-out="appt.patient_name"/></div>
                                            <div class="treatment-service"><t t-out="appt.treatment"/></div>
                                        </div>
                                        <span t-attf-class="status-badge-pill #{appt.status_class}">
                                            <t t-out="appt.status_label"/>
                                        </span>
                                        <div class="more-action-dots">
                                            <i class="fa fa-ellipsis-v"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Card 3: Recent Patients -->
                        <div class="dashboard-panel-card">
                            <div class="panel-card-header">
                                <h3 class="panel-title">
                                    <i class="fa fa-user-plus"/> Recent Patients
                                </h3>
                                <button class="view-all-pill-btn" t-on-click="() => this.navigateTo('patients')">
                                    View All
                                </button>
                            </div>

                            <div class="recent-patients-wrapper">
                                <t t-if="this.state.data.recent_patients.length === 0">
                                    <div class="text-center text-muted py-3">No registered patients found.</div>
                                </t>
                                <t t-foreach="this.state.data.recent_patients" t-as="pat" t-key="pat.id">
                                    <div class="recent-patient-row" t-on-click="() => this.openPatient(pat.id)">
                                        <div class="patient-avatar">
                                            <t t-out="pat.name[0]"/>
                                        </div>
                                        <div class="patient-info">
                                            <div class="patient-name"><t t-out="pat.name"/></div>
                                            <div class="patient-reason"><t t-out="pat.treatment"/></div>
                                        </div>
                                        <div class="visit-time"><t t-out="pat.time"/></div>
                                        <div class="dept-badge">
                                            <i class="fa fa-hospital-o"/> OPD
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Card 4: Quick Actions -->
                        <div class="dashboard-panel-card">
                            <div class="panel-card-header">
                                <h3 class="panel-title">
                                    <i class="fa fa-bolt"/> Quick Actions
                                </h3>
                            </div>

                            <div class="quick-actions-grid">
                                <!-- Action 1: New Appointment -->
                                <div class="quick-action-tile tile-new-appt" t-on-click="() => this.actionNewAppointment()">
                                    <i class="fa fa-calendar-plus-o action-icon-circle"/>
                                    <div class="action-title-group">
                                        <span>New Appointment</span>
                                        <i class="fa fa-arrow-right"/>
                                    </div>
                                </div>

                                <!-- Action 2: New Patient -->
                                <div class="quick-action-tile tile-new-patient" t-on-click="() => this.actionNewPatient()">
                                    <i class="fa fa-user-plus action-icon-circle"/>
                                    <div class="action-title-group">
                                        <span>New Patient</span>
                                        <i class="fa fa-arrow-right"/>
                                    </div>
                                </div>

                                <!-- Action 3: Create Prescription -->
                                <div class="quick-action-tile tile-prescription" t-on-click="() => this.actionCreatePrescription()">
                                    <i class="fa fa-medkit action-icon-circle"/>
                                    <div class="action-title-group">
                                        <span>Create Prescription</span>
                                        <i class="fa fa-arrow-right"/>
                                    </div>
                                </div>

                                <!-- Action 4: Record X-Ray -->
                                <div class="quick-action-tile tile-xray" t-on-click="() => this.actionRecordXRay()">
                                    <i class="fa fa-file-image-o action-icon-circle"/>
                                    <div class="action-title-group">
                                        <span>Record X-Ray</span>
                                        <i class="fa fa-arrow-right"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </main>

                <!-- Right Stats Column -->
                <aside class="dashboard-right-sidebar">
                    
                    <!-- Branch Selector -->
                    <div class="right-branch-selector">
                        <div class="branch-left">
                            <i class="fa fa-map-marker"/>
                            <span><t t-out="this.state.data.header.current_branch_name"/></span>
                        </div>
                        <i class="fa fa-angle-down text-muted fs-8"/>
                    </div>

                    <!-- 1. OPD Patients Today -->
                    <div class="kpi-stat-card" t-on-click="() => this.navigateTo('opd')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-opd"><i class="fa fa-users"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">OPD Patients Today</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.opd_patients.val"/></span>
                                    <span class="trend-badge"><i class="fa fa-arrow-up"/> <t t-out="this.state.data.kpis.opd_patients.trend_pct"/>%</span>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.opd_patients.trend_label"/></div>
                            </div>
                        </div>
                        <div class="kpi-sparkline">
                            <t t-foreach="this.state.data.kpis.opd_patients.sparkline" t-as="h" t-key="h_index">
                                <span class="spark-bar bar-purple" t-attf-style="height: #{h}px;"/>
                            </t>
                        </div>
                    </div>

                    <!-- 2. Appointments Today -->
                    <div class="kpi-stat-card" t-on-click="() => this.navigateTo('appointments')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-appt"><i class="fa fa-calendar-check-o"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">Appointments Today</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.appointments.val"/></span>
                                    <span class="trend-badge"><i class="fa fa-arrow-up"/> <t t-out="this.state.data.kpis.appointments.trend_pct"/>%</span>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.appointments.trend_label"/></div>
                            </div>
                        </div>
                        <div class="kpi-sparkline">
                            <t t-foreach="this.state.data.kpis.appointments.sparkline" t-as="h" t-key="h_index">
                                <span class="spark-bar bar-indigo" t-attf-style="height: #{h}px;"/>
                            </t>
                        </div>
                    </div>

                    <!-- 3. Dental Chairs Occupancy -->
                    <div class="kpi-stat-card" t-on-click="() => this.onRoomClick('chairs')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-chairs"><i class="fa fa-wheelchair"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">Dental Chairs Occupancy</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.chairs_occupancy.pct"/>%</span>
                                </div>
                                <div class="chair-progress-bar-wrap">
                                    <div class="chair-progress-fill" t-attf-style="width: #{this.state.data.kpis.chairs_occupancy.pct}%;"/>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.chairs_occupancy.label"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Prescriptions Today -->
                    <div class="kpi-stat-card" t-on-click="() => this.navigateTo('pharmacy')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-rx"><i class="fa fa-medkit"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">Prescriptions Today</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.prescriptions.val"/></span>
                                    <span class="trend-badge"><i class="fa fa-arrow-up"/> <t t-out="this.state.data.kpis.prescriptions.trend_pct"/>%</span>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.prescriptions.trend_label"/></div>
                            </div>
                        </div>
                        <div class="kpi-sparkline">
                            <t t-foreach="this.state.data.kpis.prescriptions.sparkline" t-as="h" t-key="h_index">
                                <span class="spark-bar bar-rose" t-attf-style="height: #{h}px;"/>
                            </t>
                        </div>
                    </div>

                    <!-- 5. Lab Tests Today -->
                    <div class="kpi-stat-card" t-on-click="() => this.navigateTo('laboratory')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-lab"><i class="fa fa-flask"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">Lab Tests Today</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.lab_tests.val"/></span>
                                    <span class="trend-badge"><i class="fa fa-arrow-up"/> <t t-out="this.state.data.kpis.lab_tests.trend_pct"/>%</span>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.lab_tests.trend_label"/></div>
                            </div>
                        </div>
                        <div class="kpi-sparkline">
                            <t t-foreach="this.state.data.kpis.lab_tests.sparkline" t-as="h" t-key="h_index">
                                <span class="spark-bar bar-amber" t-attf-style="height: #{h}px;"/>
                            </t>
                        </div>
                    </div>

                    <!-- 6. Radiology (X-Ray) Today -->
                    <div class="kpi-stat-card" t-on-click="() => this.navigateTo('radiology')">
                        <div class="kpi-left-group">
                            <div class="kpi-icon-box icon-xray"><i class="fa fa-picture-o"/></div>
                            <div class="kpi-info">
                                <div class="kpi-label">Radiology (X-Ray) Today</div>
                                <div class="kpi-value-row">
                                    <span class="kpi-number"><t t-out="this.state.data.kpis.radiology.val"/></span>
                                    <span class="trend-badge"><i class="fa fa-arrow-up"/> <t t-out="this.state.data.kpis.radiology.trend_pct"/>%</span>
                                </div>
                                <div class="trend-subtext"><t t-out="this.state.data.kpis.radiology.trend_label"/></div>
                            </div>
                        </div>
                        <div class="kpi-sparkline">
                            <t t-foreach="this.state.data.kpis.radiology.sparkline" t-as="h" t-key="h_index">
                                <span class="spark-bar bar-sky" t-attf-style="height: #{h}px;"/>
                            </t>
                        </div>
                    </div>

                </aside>

            </div>

        </div>
    </t>
</templates>
