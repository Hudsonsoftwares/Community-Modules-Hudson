<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_follow_up_tree" model="ir.ui.view">
        <field name="name">dental.follow_up.tree</field>
        <field name="model">dental.follow.up</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'" decoration-primary="state == 'booked'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="treatment_id"/>
                <field name="date" string="Follow-up Date"/>
                <field name="reason"/>
                <field name="booked_appointment_id" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-info="state == 'booked'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                <button name="action_done" string="Mark Done" type="object" class="btn btn-outline-success btn-sm" icon="fa-check" invisible="state not in ('pending', 'booked')"/>
            </list>
        </field>
    </record>

    <record id="view_dental_follow_up_search" model="ir.ui.view">
        <field name="name">dental.follow_up.search</field>
        <field name="model">dental.follow.up</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="treatment_id"/>
                <field name="reason"/>
                
                <filter string="Pending Follow-ups" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Today's Due" name="filter_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '=', 'pending')]"/>
                <separator/>
                <filter string="Booked" name="filter_booked" domain="[('state', '=', 'booked')]"/>
                <filter string="Completed" name="filter_done" domain="[('state', '=', 'done')]"/>
                
                <group>
                    <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Treatment" name="group_treatment" context="{'group_by': 'treatment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dental_follow_up_form" model="ir.ui.view">
        <field name="name">dental.follow_up.form</field>
        <field name="model">dental.follow.up</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Mark Done" type="object" class="btn-success" invisible="state not in ('pending', 'booked')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,booked,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="patient_id" placeholder="Patient Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Patient &amp; Appointment">
                            <field name="appointment_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group string="Follow-up Details">
                            <field name="date"/>
                            <field name="treatment_id"/>
                        </group>
                    </group>
                    <group string="Clinical Notes &amp; Instructions">
                        <field name="reason" placeholder="Clinical reason for follow-up..."/>
                        <field name="notes" placeholder="Additional notes or doctor instructions..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_follow_up" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">dental.follow.up</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>
</odoo>
