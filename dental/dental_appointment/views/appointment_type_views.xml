<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================================= -->
    <!-- APPOINTMENT TYPE VIEWS                                                    -->
    <!-- ========================================================================= -->
    <record id="view_dental_appointment_type_tree" model="ir.ui.view">
        <field name="name">dental.appointment.type.tree</field>
        <field name="model">dental.appointment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="icon" string="Icon" optional="show"/>
                <field name="icon_type" optional="hide"/>
                <field name="duration" widget="float_time"/>
                <field name="price"/>
                <field name="required_equipment_category_ids" widget="many2many_tags" optional="show"/>
                <field name="required_equipment_ids" widget="many2many_tags" optional="hide"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dental_appointment_type_form" model="ir.ui.view">
        <field name="name">dental.appointment.type.form</field>
        <field name="model">dental.appointment.type</field>
        <field name="arch" type="xml">
            <form string="Appointment Type">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"
                           invisible="icon_type != 'image'"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Root Canal Treatment, Comprehensive Oral Examination..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Configuration">
                            <field name="duration" widget="float_time"/>
                            <field name="price"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Visual Representation">
                            <field name="icon_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="appointment_icon_id"
                                   options="{'no_create_edit': False}"
                                   invisible="icon_type != 'icon'"
                                   placeholder="Quick select or create preset icon..."/>
                            <field name="icon" widget="dental_icon_picker" string="Icon"
                                   invisible="icon_type != 'icon'"/>
                            <field name="image" widget="image" string="Upload Custom Image"
                                   invisible="icon_type != 'image'"/>
                        </group>
                    </group>
                    <group string="Required Equipment &amp; Resources">
                        <group>
                            <field name="required_equipment_category_ids" widget="many2many_tags"
                                   placeholder="Select required categories (e.g. Dental Chairs, X-ray Machines)..."/>
                        </group>
                        <group>
                            <field name="required_equipment_ids" widget="many2many_tags"
                                   placeholder="Select specific equipment items (if mandatory)..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Internal or patient-facing description of this appointment type..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">dental.appointment.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first dental appointment type!
            </p>
            <p>
                Configure visit categories (Emergency, Comprehensive Exam, Cleaning, Root Canal, Orthodontics, etc.)
                with custom duration, estimated fees, and visual icons.
            </p>
        </field>
    </record>

    <!-- ========================================================================= -->
    <!-- DENTAL APPOINTMENT ICON VIEWS (Icon Library & Custom Images)               -->
    <!-- ========================================================================= -->
    <record id="view_dental_appointment_icon_tree" model="ir.ui.view">
        <field name="name">dental.appointment.icon.tree</field>
        <field name="model">dental.appointment.icon</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon_class" placeholder="e.g. fa-tooth"/>
                <field name="category"/>
                <field name="image" widget="image" class="oe_avatar" options="{'size': [32, 32]}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dental_appointment_icon_form" model="ir.ui.view">
        <field name="name">dental.appointment.icon.form</field>
        <field name="model">dental.appointment.icon</field>
        <field name="arch" type="xml">
            <form string="Appointment Icon">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Tooth Inspection, Oral Surgery, Aligner..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Icon Settings">
                            <field name="icon_class" placeholder="e.g. fa-stethoscope or fa-tooth"/>
                            <field name="category"/>
                        </group>
                        <group string="Display &amp; Status">
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_appointment_icon_kanban" model="ir.ui.view">
        <field name="name">dental.appointment.icon.kanban</field>
        <field name="model">dental.appointment.icon</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-3 p-2">
                            <t t-if="record.image.raw_value">
                                <field name="image" widget="image" class="rounded" style="width: 44px; height: 44px; object-fit: contain;"/>
                            </t>
                            <t t-else="">
                                <div class="d-flex align-items-center justify-content-center bg-light border rounded text-primary" style="width: 44px; height: 44px; font-size: 1.4rem;">
                                    <i t-attf-class="fa #{record.icon_class.raw_value}"/>
                                </div>
                            </t>
                            <div>
                                <field name="name" class="fw-bold fs-6"/>
                                <div class="text-muted small"><field name="category"/></div>
                                <div class="badge text-bg-light border font-monospace mt-1"><field name="icon_class"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dental_appointment_icon" model="ir.actions.act_window">
        <field name="name">Appointment Icons</field>
        <field name="res_model">dental.appointment.icon</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add custom dental icons or upload clinic image graphics!
            </p>
            <p>
                Icons created here are automatically made available inside the Visual Icon Picker
                when creating or editing dental appointment types.
            </p>
        </field>
    </record>
</odoo>