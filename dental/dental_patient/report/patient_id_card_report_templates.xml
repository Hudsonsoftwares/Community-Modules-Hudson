<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_patient_id_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="margin: 0; padding: 0; background: transparent; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                    <!-- Outer Card Container matching CR80 Dimensions (85.6mm x 54mm) -->
                    <div style="width: 85.6mm; height: 53.98mm; box-sizing: border-box; background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%); border: 1.2px solid #cbd5e1; border-radius: 12px; padding: 3.5mm 4.5mm; position: relative; overflow: hidden; page-break-inside: avoid; page-break-after: always;">
                        
                        <!-- 1. Header Row: HOSPITAL PATIENT CARD + Blue Cross Caduceus Emblem -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 2mm;">
                            <tr>
                                <td style="vertical-align: middle; text-align: left;">
                                    <div style="font-size: 10.5pt; font-weight: 800; color: #0f172a; letter-spacing: 0.4px; text-transform: uppercase; font-family: Arial, Helvetica, sans-serif; line-height: 1.1;">
                                        HOSPITAL PATIENT CARD
                                    </div>
                                    <div t-if="doc.active_clinic_id or doc.company_id" style="font-size: 6.5pt; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; line-height: 1; margin-top: 0.5mm;">
                                        <t t-out="(doc.active_clinic_id or doc.company_id).name"/>
                                    </div>
                                </td>
                                <td style="vertical-align: middle; text-align: right; width: 30px;">
                                    <!-- Medical Cross with Caduceus Emblem (Vector SVG matching card design) -->
                                    <svg width="28" height="28" viewBox="0 0 100 100" style="display: inline-block;">
                                        <!-- Solid Blue Cross with subtle rounded corners -->
                                        <path d="M35 5 C35 2.2 37.2 0 40 0 L60 0 C62.8 0 65 2.2 65 5 L65 35 L95 35 C97.8 35 100 37.2 100 40 L100 60 C100 62.8 97.8 65 95 65 L65 65 L65 95 C65 97.8 62.8 100 60 100 L40 100 C37.2 100 35 97.8 35 95 L35 65 L5 65 C2.2 65 0 62.8 0 60 L0 40 C0 37.2 2.2 35 5 35 L35 35 Z" fill="#2563eb"/>
                                        <!-- Caduceus / Medical Staff in Crisp White -->
                                        <circle cx="50" cy="18" r="3.5" fill="#ffffff"/>
                                        <rect x="48.5" y="21" width="3" height="60" rx="1.5" fill="#ffffff"/>
                                        <!-- Wings -->
                                        <path d="M50 24 C41 17 29 21 25 28 C33 28 42 29 50 34 C58 29 67 28 75 28 C71 21 59 17 50 24 Z" fill="#ffffff"/>
                                        <!-- Double Entwined Serpents -->
                                        <path d="M41 38 C41 30 59 30 59 38 C59 46 41 48 41 56 C41 64 59 66 59 74" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round"/>
                                        <path d="M59 38 C59 30 41 30 41 38 C41 46 59 48 59 56 C59 64 41 66 41 74" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round"/>
                                    </svg>
                                </td>
                            </tr>
                        </table>

                        <!-- 2. Middle Section: Patient Photo + Patient Information Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 2mm;">
                            <tr>
                                <!-- Left Column: Patient Photo Box -->
                                <td style="width: 23mm; vertical-align: top; padding-right: 3mm;">
                                    <div style="width: 22.5mm; height: 26mm; border-radius: 8px; overflow: hidden; background: #bfdbfe; border: 1px solid #93c5fd; text-align: center; position: relative;">
                                        <t t-if="doc.image_1920">
                                            <img t-att-src="image_data_uri(doc.image_1920)" style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 7px;"/>
                                        </t>
                                        <t t-else="">
                                            <!-- Friendly Portrait Silhouette -->
                                            <svg width="100%" height="100%" viewBox="0 0 80 92" preserveAspectRatio="none" style="display: block; background: linear-gradient(180deg, #dbeafe 0%, #bfdbfe 100%);">
                                                <circle cx="40" cy="34" r="18" fill="#60a5fa"/>
                                                <path d="M12 88 C12 62 26 56 40 56 C54 56 68 62 68 88 Z" fill="#3b82f6"/>
                                            </svg>
                                        </t>
                                    </div>
                                </td>

                                <!-- Right Column: Patient Details -->
                                <td style="vertical-align: top; padding-left: 1mm;">
                                    <div style="font-size: 7pt; color: #475569; font-weight: 500; line-height: 1; margin-bottom: 0.5mm;">
                                        Patient Name:
                                    </div>
                                    <div style="font-size: 11pt; font-weight: 800; color: #0f172a; line-height: 1.15; margin-bottom: 2.2mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 48mm;">
                                        <t t-out="doc.name"/>
                                    </div>

                                    <table style="border-collapse: collapse; font-size: 7.5pt; color: #334155; line-height: 1.35;">
                                        <tr>
                                            <td style="padding-bottom: 0.8mm; color: #475569; white-space: nowrap;">Patient ID:</td>
                                            <td style="padding-bottom: 0.8mm; padding-left: 2mm; font-weight: 700; color: #0f172a;">
                                                <t t-out="doc.dental_patient_id or ('PT-%05d' % doc.id)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding-bottom: 0.8mm; color: #475569; white-space: nowrap;">Date of Birth:</td>
                                            <td style="padding-bottom: 0.8mm; padding-left: 2mm; font-weight: 700; color: #0f172a;">
                                                <t t-if="doc.date_of_birth" t-out="doc.date_of_birth.strftime('%d/%m/%Y')"/>
                                                <t t-else="">-</t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color: #475569; white-space: nowrap;">Blood Type:</td>
                                            <td style="padding-left: 2mm; font-weight: 700; color: #0f172a;">
                                                <t t-out="doc.blood_group or '-'"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 3. Bottom Section: Barcode + Security Metallic Strip -->
                        <table style="width: 100%; border-collapse: collapse; position: absolute; bottom: 3mm; left: 4.5mm; right: 4.5mm; width: calc(100% - 9mm);">
                            <tr>
                                <!-- Left: Code128 Barcode -->
                                <td style="vertical-align: bottom; text-align: left;">
                                    <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=320&amp;height=65' % (doc.dental_patient_id or ('PT-%05d' % doc.id))" 
                                         style="width: 38mm; height: 8mm; display: block;" 
                                         alt="Barcode"/>
                                </td>

                                <!-- Right: Silver Metallic Security Chip / Strip -->
                                <td style="vertical-align: bottom; text-align: right;">
                                    <div style="display: inline-block; width: 25mm; height: 6.8mm; background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 45%, #94a3b8 100%); border-radius: 4px; border: 1px solid #94a3b8; box-shadow: inset 0 1px 2px rgba(255,255,255,0.8);"></div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
