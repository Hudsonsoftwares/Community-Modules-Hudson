<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: CR80 Standard ID Card (85.6mm x 53.98mm) -->
    <record id="paperformat_patient_id_card" model="report.paperformat">
        <field name="name">Patient ID Card (CR80 Standard)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">86</field>
        <field name="page_height">54</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report Action for Patient ID Card -->
    <record id="action_report_dental_patient_id_card" model="ir.actions.report">
        <field name="name">Patient ID Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dental_patient.report_patient_id_card_template</field>
        <field name="print_report_name">'Patient_ID_Card_%s' % (object.dental_patient_id or object.name).replace('/', '_')</field>
        <field name="paperformat_id" ref="dental_patient.paperformat_patient_id_card"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
