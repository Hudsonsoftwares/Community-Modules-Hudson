<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Dental Patients -->
    <record id="action_dental_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_dental_patient', '=', True)]</field>
        <field name="context">{'default_is_dental_patient': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new dental patient
            </p>
        </field>
    </record>

    <!-- Action for Patient History -->
    <record id="action_dental_patient_history" model="ir.actions.act_window">
        <field name="name">Patient History</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_dental_patient', '=', True)]</field>
        <field name="context">{'default_is_dental_patient': True}</field>
    </record>

    <!-- Menu Items for Dental Patients (under Dental Clinic root) -->
    <menuitem id="menu_dental_patients_root"
              name="Patients"
              parent="dental_base.menu_dental_root"
              sequence="20"
              groups="dental_base.group_dental_manager,dental_base.group_dental_admin"/>
    
    <menuitem id="menu_dental_patients"
              name="Patient List"
              parent="menu_dental_patients_root"
              action="action_dental_patient"
              sequence="10"/>

    <menuitem id="menu_dental_patient_history"
              name="Patient History"
              parent="menu_dental_patients_root"
              action="action_dental_patient_history"
              sequence="20"/>

    <!-- Form View Inheritance -->
    <record id="view_partner_form_dental" model="ir.ui.view">
        <field name="name">res.partner.form.dental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_print_patient_id_card" 
                            string="Print ID Card" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-id-card"
                            invisible="not is_dental_patient or not id"/>
                    <button name="action_book_appointment" 
                            string="Book Appointment" 
                            type="object" 
                            class="btn-secondary" 
                            icon="calendar_add_on"
                            invisible="not is_dental_patient or not id"/>
                </header>
            </xpath>
            <xpath expr="//h1" position="after">
                <h2 invisible="not is_dental_patient">
                    <field name="dental_patient_id"/>
                </h2>
            </xpath>
            
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_dental_patient" widget="boolean_toggle"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Dental Information" name="dental_info" invisible="not is_dental_patient">
                    <group>
                        <group string="Basic Details">
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                        </group>
                        <group string="Emergency Info">
                            <field name="guardian_id"/>
                            <field name="emergency_contact"/>
                            <field name="active_clinic_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Medical History">
                            <field name="allergy_status" widget="radio" options="{'horizontal': true}"/>
                            <field name="allergies" required="allergy_status == 'known'"
                                   placeholder="e.g. Penicillin (rash), Latex, Lidocaine"/>
                            <field name="allergy_verified_by" invisible="allergy_status == 'unknown'"/>
                            <field name="allergy_verified_date" invisible="allergy_status == 'unknown'"/>
                            <field name="existing_conditions"/>
                            <field name="current_medications"/>
                            <field name="previous_surgeries"/>
                            <field name="medical_history"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    
    <!-- Tree view customization for Patients Action -->
    <record id="view_partner_tree_dental" model="ir.ui.view">
        <field name="name">res.partner.tree.dental</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Dental Patients">
                <field name="dental_patient_id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="date_of_birth"/>
                <field name="age"/>
            </list>
        </field>
    </record>
    
    <!-- Patients are shared by all branches: find them by Patient ID or phone from any branch -->
    <record id="view_partner_search_dental" model="ir.ui.view">
        <field name="name">res.partner.search.dental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dental_patient_id" string="Patient ID"/>
                <field name="phone" string="Phone" filter_domain="[('phone', 'ilike', self)]"/>
            </field>
        </field>
    </record>

    <!-- Kanban opens first; the dental patient list stays the list view -->
    <record id="action_dental_patient_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="action_dental_patient"/>
    </record>

    <!-- Link specific tree to action -->
    <record id="action_dental_patient_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_tree_dental"/>
        <field name="act_window_id" ref="action_dental_patient"/>
    </record>
</odoo>
