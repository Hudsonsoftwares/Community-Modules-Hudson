<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_case_discuss_wizard_form" model="ir.ui.view">
        <field name="name">dental.case.discuss.wizard.form</field>
        <field name="model">dental.case.discuss.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Clinical Peer Consultation">
                <group>
                    <group>
                        <field name="case_id" readonly="1"/>
                        <field name="patient_id" readonly="1"/>
                        <field name="doctor_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="priority" widget="radio"/>
                        <field name="colleague_doctor_ids" widget="many2many_tags" placeholder="Select colleague doctors or specialists..."/>
                    </group>
                </group>
                <group string="Clinical Inquiry / Reason for Peer Review">
                    <field name="clinical_inquiry" placeholder="Describe the diagnostic dilemma, proposed treatment plan, or specific clinical question..." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_start_consultation" string="Open Consultation Channel" type="object" class="btn-primary" icon="fa-comments"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

