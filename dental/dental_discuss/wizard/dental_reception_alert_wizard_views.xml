<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_reception_alert_wizard_form" model="ir.ui.view">
        <field name="name">dental.reception.alert.wizard.form</field>
        <field name="model">dental.reception.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Front Desk to Doctor Alert">
                <group>
                    <group>
                        <field name="appointment_id" readonly="1"/>
                        <field name="patient_id" readonly="1"/>
                        <field name="doctor_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="alert_type" widget="radio"/>
                        <field name="priority" widget="radio"/>
                    </group>
                </group>
                <group invisible="alert_type != 'chair_ready'">
                    <field name="operatory_room"/>
                </group>
                <group invisible="alert_type != 'running_late'">
                    <field name="minutes_late"/>
                </group>
                <group>
                    <field name="notes" placeholder="Optional notes or details for the doctor..."/>
                </group>
                <footer>
                    <button name="action_send_alert" string="Dispatch Alert to Doctor" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dental_reception_alert_wizard" model="ir.actions.act_window">
        <field name="name">Front Desk Alert to Doctor</field>
        <field name="res_model">dental.reception.alert.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

