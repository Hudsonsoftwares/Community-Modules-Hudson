<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_form_inherit_discuss" model="ir.ui.view">
        <field name="name">dental.appointment.form.inherit.discuss</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="dental_appointment.view_dental_appointment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_reception_alert" string="Front Desk Alert" type="object"
                        class="btn-outline-info" icon="fa-bell"
                        invisible="state in ('completed', 'cancelled', 'no_show')"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_discuss_channel" type="object" class="oe_stat_button" icon="fa-comments">
                    <field name="discuss_channel_count" widget="statinfo" string="Discuss"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

