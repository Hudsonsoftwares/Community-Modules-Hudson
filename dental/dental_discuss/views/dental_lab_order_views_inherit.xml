<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_order_form_inherit_discuss" model="ir.ui.view">
        <field name="name">dental.lab.order.form.inherit.discuss</field>
        <field name="model">dental.lab.order</field>
        <field name="inherit_id" ref="dental_lab.view_dental_lab_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_lab_channel" string="Discuss with Lab" type="object"
                        class="btn-outline-primary" icon="fa-comments"
                        invisible="state in ('closed', 'cancelled')"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_lab_channel" type="object" class="oe_stat_button" icon="fa-comments">
                    <field name="discuss_channel_count" widget="statinfo" string="Lab Chat"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

