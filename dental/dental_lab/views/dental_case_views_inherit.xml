<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_case_form_inherit_dental_lab" model="ir.ui.view">
        <field name="name">dental.case.form.inherit.dental.lab</field>
        <field name="model">dental.case</field>
        <field name="inherit_id" ref="dental_core.view_dental_case_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='patient_history']/field[@name='patient_document_ids']" position="before">
                <separator string="Lab Orders (all cases)"/>
                <field name="history_lab_order_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0">
                        <field name="order_date"/>
                        <field name="name"/>
                        <field name="case_id"/>
                        <field name="tooth_summary"/>
                        <field name="lab_type"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
            </xpath>
            <!-- Smart button (the Treatment tab only holds the treatment plans) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_lab_orders" type="object" class="oe_stat_button" icon="science">
                    <field name="lab_order_count" widget="statinfo" string="Lab Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
