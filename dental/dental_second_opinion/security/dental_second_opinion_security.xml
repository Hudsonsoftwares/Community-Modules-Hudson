<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Creates a "Dental Second Opinion" dropdown row in Settings > Users.

          Dental Clinic          → [Clinic Manager ▼]   (dental_base) oversees every request of its branches
          Dental Dentist         → [Dentist        ▼]   (dental_core) requests second opinions on own cases
          Dental Second Opinion  → [Specialist     ▼]   ← this file

        A Specialist is a dentist who reviews cases referred by colleagues. While a referral is active the
        specialist can read the referred case's consultations, diagnoses and treatment plans (read only),
        through the referral-scoped rows in ir.access.csv. Branch isolation rows still apply on top.
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_dental_second_opinion">
        <field name="name">Dental Second Opinion</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="dental_base.module_category_dental_clinic"/>
    </record>

    <record id="group_dental_specialist" model="res.groups">
        <field name="name">Specialist</field>
        <field name="privilege_id" ref="dental_second_opinion.res_groups_privilege_dental_second_opinion"/>
        <field name="implied_ids" eval="[(4, ref('dental_base.group_dental_dentist'))]"/>
        <field name="comment">Reviews dental cases referred for a second opinion and submits findings and recommendations.</field>
    </record>
</odoo>
