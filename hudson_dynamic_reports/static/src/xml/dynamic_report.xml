<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hudson_dynamic_reports.DynamicReport" owl="1">
        <div class="o_dynamic_report_container">
            <div class="o_dynamic_report_header mb-4 mt-4 d-flex justify-content-between align-items-center px-3">
                <h2 class="text-primary fw-bold mb-0" t-esc="state.title"/>
                <div class="o_dynamic_report_buttons">
                    <button class="btn btn-secondary me-2" t-on-click="printView"><i class="fa fa-print me-1"></i> Print</button>
                    <button class="btn btn-danger me-2" t-on-click="exportPDF"><i class="fa fa-file-pdf-o me-1"></i> PDF</button>
                    <button class="btn btn-success me-2" t-on-click="exportCSV"><i class="fa fa-file-excel-o me-1"></i> CSV</button>
                    <button class="btn btn-info text-white" t-on-click="exportJSON"><i class="fa fa-file-code-o me-1"></i> JSON</button>
                </div>
            </div>
            
            <div class="o_dynamic_report_content table-responsive shadow-sm bg-white rounded p-3">
                <table class="table table-hover table-sm">
                    <thead class="table-light">
                        <tr>
                            <t t-foreach="state.columns" t-as="col" t-key="col.field">
                                <th t-att-class="col.type === 'monetary' ? 'text-end' : ''" t-esc="col.label"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.lines" t-as="line" t-key="line.id">
                            <tr t-if="isVisible(line)" 
                                t-att-class="{'fw-bold': line.level === 1, 'text-muted': line.level > 2}"
                                t-on-click="() => this.onLineClicked(line)"
                                t-att-style="'cursor: ' + (line.type === 'account' ? 'pointer' : 'default')">
                                <t t-foreach="state.columns" t-as="col" t-key="col.field">
                                    <td t-att-class="col.type === 'monetary' ? 'text-end' : ''">
                                        <t t-if="col.field === 'name'">
                                            <div t-att-style="'padding-left: ' + ((line.level - 1) * 20) + 'px'">
                                                <span t-if="hasChildren(line)" 
                                                      class="me-2 text-primary" 
                                                      style="cursor: pointer;"
                                                      t-on-click.stop="() => this.toggleExpand(line.id)">
                                                    <i t-att-class="state.expandedLines[line.id] ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                                </span>
                                                <span t-else="" class="me-3"/>
                                                <span t-esc="line[col.field]"/>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="col.type === 'monetary' ? formatMonetary(line[col.field]) : line[col.field]"/>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
