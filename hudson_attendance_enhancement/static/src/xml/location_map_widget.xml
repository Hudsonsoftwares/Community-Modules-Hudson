<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hudson_attendance_enhancement.LocationMapPickerWidget">
        <div class="hudson-map-picker-container w-100 my-3">
            <div class="card shadow-sm border-0 bg-light-subtle">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <div class="input-group flex-grow-1 position-relative">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="oi text-muted" data-icon="search"/>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0"
                                   placeholder="Search address, landmark, or city..."
                                   t-model.proxy="this.state.searchQuery"
                                   t-on-keydown="this.onSearchKeyDown"/>
                            <button class="btn btn-primary"
                                    type="button"
                                    t-on-click="this.onSearchClick"
                                    t-att-disabled="this.state.isSearching">
                                <span t-if="this.state.isSearching" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"/>
                                <span t-else="" class="oi me-1" data-icon="location_on"/>
                                Search
                            </button>
                            
                            <!-- Search Results Dropdown -->
                            <div t-if="this.state.searchResults.length &gt; 0" 
                                 class="hudson-search-dropdown position-absolute w-100 bg-white border rounded shadow-lg">
                                <div class="list-group list-group-flush">
                                    <t t-foreach="this.state.searchResults" t-as="result" t-key="result_index">
                                        <button type="button" 
                                                class="list-group-item list-group-item-action py-2 text-start"
                                                t-on-click="() => this.selectSearchResult(result)">
                                            <i class="oi text-danger me-2" data-icon="location_on"/>
                                            <span class="fw-semibold text-truncate" t-out="result.display_name"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-outline-secondary d-flex align-items-center"
                                type="button"
                                title="Locate my current position"
                                t-on-click="this.onUseCurrentLocation"
                                t-att-disabled="this.state.isLocating">
                            <i t-if="this.state.isLocating" class="spinner-border spinner-border-sm me-1" role="status"/>
                            <i t-else="" class="oi text-primary me-1" data-icon="my_location"/>
                            <span>My Location</span>
                        </button>
                    </div>

                    <!-- Map container -->
                    <div class="position-relative">
                        <div class="hudson-leaflet-map rounded border" t-ref="this.mapContainerRef"/>
                        <div class="position-absolute bottom-0 start-0 m-2 bg-white bg-opacity-75 p-2 rounded shadow-sm fs-7 text-muted" style="z-index: 1000;">
                            <span><i class="oi text-primary me-1" data-icon="info"/>Click or drag the marker to adjust location.</span>
                        </div>
                    </div>

                    <!-- Coordinates badge -->
                    <div class="d-flex justify-content-between align-items-center mt-2 text-muted small">
                        <div>
                            <strong>Selected Coordinates: </strong>
                            <span class="badge bg-secondary-subtle text-secondary me-2">
                                Lat: <t t-out="this.currentLat.toFixed(6)"/>
                            </span>
                            <span class="badge bg-secondary-subtle text-secondary me-2">
                                Lon: <t t-out="this.currentLon.toFixed(6)"/>
                            </span>
                            <span class="badge bg-primary-subtle text-primary">
                                Radius: <t t-out="this.currentRadius"/> m
                            </span>
                        </div>
                        <div class="fst-italic">
                            Powered by OpenStreetMap
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
