<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hudson_attendance_enhancement.CameraDialog" owl="1">
        <div class="modal d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Please take a photo for attendance</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" t-on-click="props.onClose"></button>
                    </div>
                    <div class="modal-body text-center">
                        <video t-ref="videoElement" autoplay="true" playsinline="true" style="width: 100%; max-width: 400px; border-radius: 10px; background: #000;"></video>
                        <canvas t-ref="canvasElement" style="display: none;"></canvas>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-secondary" t-on-click="props.onClose">Cancel</button>
                        <button type="button" class="btn btn-primary" t-on-click="capturePhoto">
                            <i class="fa fa-camera me-2"></i>Capture &amp; Confirm
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    </t>
</templates>
