<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hudson_attendance_enhancement.CameraDialog">
        <Dialog title="'Attendance Verification - Photo Required'" size="'md'">
            <div class="hudson-camera-dialog-content text-center p-2">
                <!-- Captured Photo Preview Mode -->
                <t t-if="state.photoCaptured">
                    <div class="position-relative d-inline-block w-100 mb-2">
                        <img t-att-src="'data:image/jpeg;base64,' + state.photoCaptured" 
                             class="img-fluid rounded border shadow-sm" 
                             style="max-height: 340px; width: 100%; object-fit: contain; background: #111;" 
                             alt="Attendance Verification Photo"/>
                        <div class="mt-2 text-success fw-bold small">
                            <i class="fa fa-check-circle me-1"/> Photo ready. Click Confirm to record your attendance.
                        </div>
                    </div>
                </t>

                <!-- Live Camera Mode -->
                <t t-else="">
                    <div class="position-relative w-100 rounded overflow-hidden bg-dark mb-2" style="min-height: 260px; max-height: 350px;">
                        <video t-ref="videoElement" 
                               autoplay="1" 
                               playsinline="1" 
                               muted="1" 
                               class="w-100 h-100 rounded" 
                               style="object-fit: cover; min-height: 260px; max-height: 350px; transform: scaleX(-1);"/>

                        <!-- Loading indicator -->
                        <div t-if="state.isStarting" 
                             class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white bg-dark bg-opacity-75">
                            <div class="spinner-border text-light mb-2" role="status"/>
                            <span>Connecting to camera...</span>
                        </div>

                        <!-- Error Banner Overlay -->
                        <div t-if="state.hasError" 
                             class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3 text-white bg-dark bg-opacity-90">
                            <i class="fa fa-exclamation-triangle text-warning fa-2x mb-2"/>
                            <p class="small text-center mb-3" t-out="state.errorMessage"/>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-light" t-on-click="startCamera">
                                    <i class="fa fa-refresh me-1"/> Retry Camera
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" t-on-click="triggerFileInput">
                                    <i class="fa fa-upload me-1"/> Upload Photo
                                </button>
                            </div>
                        </div>
                    </div>

                    <div t-if="state.isReady" class="text-muted small">
                        <i class="fa fa-info-circle text-primary me-1"/> Position your face clearly within the frame and click <strong>Capture Photo</strong>.
                    </div>
                </t>

                <!-- Hidden Canvas & File Input -->
                <canvas t-ref="canvasElement" class="d-none"/>
                <input type="file" t-ref="fileInputElement" accept="image/*" capture="user" class="d-none" t-on-change="onFileUpload"/>
            </div>

            <!-- Modal Footer -->
            <t t-set-slot="footer">
                <t t-if="state.photoCaptured">
                    <button type="button" class="btn btn-secondary me-2" t-on-click="retakePhoto">
                        <i class="fa fa-repeat me-1"/> Retake
                    </button>
                    <button type="button" class="btn btn-success" t-on-click="confirmPhoto">
                        <i class="fa fa-check me-1"/> Confirm Attendance
                    </button>
                </t>
                <t t-else="">
                    <button type="button" class="btn btn-secondary me-auto" t-on-click="cancelDialog">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-outline-secondary me-2" t-on-click="triggerFileInput" title="Upload an image from your device">
                        <i class="fa fa-upload me-1"/> Upload
                    </button>
                    <button type="button" class="btn btn-primary" t-att-disabled="!state.isReady" t-on-click="capturePhoto">
                        <i class="fa fa-camera me-1"/> Capture Photo
                    </button>
                </t>
            </t>
        </Dialog>
    </t>
</templates>
