<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='attendance_capture_check_in']]" position="after">
                <setting string="Take Pictures on Check-Out" company_dependent="1" help="Capture a photo at the time of check-out using the device camera (if available). It is stored on the attendance and posted in its chatter, like the check-in picture.">
                    <field name="attendance_capture_check_out"/>
                </setting>
            </xpath>
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Radius Punching" name="radius_punching_setting_container">
                    <setting help="Users can only mark attendance inside the radius of allowed locations" company_dependent="1">
                        <field name="attendance_radius_punching"/>
                        <div class="content-group" invisible="not attendance_radius_punching">
                            <div class="mt8">
                                <button name="%(action_hr_attendance_location)d" icon="arrow_forward" type="action" string="Configure Locations" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>

                <block title="Work From Home (WFH) Management" name="wfh_setting_container">
                    <setting help="Enable special attendance options, live location tracking, and flexible schedules for remote employees" company_dependent="1">
                        <field name="enable_work_from_home"/>
                        <div class="content-group" invisible="not enable_work_from_home">
                            <div class="row mt16">
                                <label for="wfh_tracking_interval" class="col-lg-4 o_light_label" string="Live Location Ping Interval"/>
                                <field name="wfh_tracking_interval" class="col-lg-4"/>
                            </div>
                            <div class="row mt8">
                                <div class="col-12">
                                    <field name="wfh_enforce_home_radius" class="oe_inline"/>
                                    <label for="wfh_enforce_home_radius" class="o_light_label ms-2" string="Enforce Home Radius Punching"/>
                                </div>
                            </div>
                            <div class="row mt8 ms-3" invisible="not wfh_enforce_home_radius">
                                <label for="wfh_home_radius" class="col-lg-4 o_light_label" string="Allowed Home Radius (meters)"/>
                                <field name="wfh_home_radius" class="col-lg-3"/>
                            </div>
                            <div class="row mt8 ms-3" invisible="not wfh_enforce_home_radius">
                                <div class="col-12">
                                    <field name="wfh_allow_offsite_with_reason" class="oe_inline"/>
                                    <label for="wfh_allow_offsite_with_reason" class="o_light_label ms-2" string="Allow Check-In Outside Home Radius with Justification"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
