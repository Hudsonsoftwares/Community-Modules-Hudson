<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_location_tree" model="ir.ui.view">
        <field name="name">hr.attendance.location.list</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <list string="Attendance Locations">
                <field name="name"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="radius"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_location_form" model="ir.ui.view">
        <field name="name">hr.attendance.location.form</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <form string="Attendance Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Location Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Head Office, Warehouse..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Coordinates &amp; Radius">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="radius"/>
                        </group>
                        <group string="Organization">
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Interactive Map &amp; Search Picker"/>
                    <div class="o_horizontal_separator text-uppercase fw-bolder small text-muted mb-2">
                        Select or search location to set coordinates automatically
                    </div>
                    <widget name="location_map_picker"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_location" model="ir.actions.act_window">
        <field name="name">Attendance Locations</field>
        <field name="res_model">hr.attendance.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_attendance_location" 
              name="Locations" 
              parent="hr_attendance.menu_hr_attendance_configuration" 
              action="action_hr_attendance_location" 
              sequence="20"/>
</odoo>
