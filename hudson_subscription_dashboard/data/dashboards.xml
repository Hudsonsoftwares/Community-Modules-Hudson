<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_dashboard_group_subscriptions" model="spreadsheet.dashboard.group">
        <field name="name">Subscriptions</field>
        <field name="sequence">170</field>
    </record>

    <record id="spreadsheet_dashboard_subscriptions" model="spreadsheet.dashboard">
        <field name="name">Subscriptions</field>
        <field name="spreadsheet_binary_data" type="bytes" file="hudson_subscription_dashboard/data/files/subscriptions_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('sale.model_sale_order')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_subscriptions"/>
        <field name="group_ids" eval="[Command.set([ref('hudson_subscriptions.group_subscription_manager')])]"/>
        <field name="sequence">100</field>
        <field name="is_published">True</field>
    </record>

    <record id="spreadsheet_dashboard_mrr_evolution" model="spreadsheet.dashboard">
        <field name="name">MRR Evolution</field>
        <field name="spreadsheet_binary_data" type="bytes" file="hudson_subscription_dashboard/data/files/mrr_evolution_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('model_sale_subscription_event_report')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_subscriptions"/>
        <field name="group_ids" eval="[Command.set([ref('hudson_subscriptions.group_subscription_manager')])]"/>
        <field name="sequence">200</field>
        <field name="is_published">True</field>
    </record>

    <record id="spreadsheet_dashboard_retention" model="spreadsheet.dashboard">
        <field name="name">Retention</field>
        <field name="spreadsheet_binary_data" type="bytes" file="hudson_subscription_dashboard/data/files/retention_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('model_sale_subscription_event_report')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_subscriptions"/>
        <field name="group_ids" eval="[Command.set([ref('hudson_subscriptions.group_subscription_manager')])]"/>
        <field name="sequence">300</field>
        <field name="is_published">True</field>
    </record>

    <record id="spreadsheet_dashboard_subscription_salesperson" model="spreadsheet.dashboard">
        <field name="name">Salesperson</field>
        <field name="spreadsheet_binary_data" type="bytes" file="hudson_subscription_dashboard/data/files/salesperson_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('model_sale_subscription_event_report')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_subscriptions"/>
        <field name="group_ids" eval="[Command.set([ref('hudson_subscriptions.group_subscription_user')])]"/>
        <field name="sequence">400</field>
        <field name="is_published">True</field>
    </record>

</odoo>
