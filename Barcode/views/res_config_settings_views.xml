<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.custom.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="inside">
                <setting id="custom_barcode_nomenclature_setting" title="Barcode Nomenclature" company_dependent="1" help="Switch between Default Nomenclature and Default GS1 Nomenclature.">
                    <field name="barcode_nomenclature_id" required="1"/>
                    <div class="mt16 d-flex flex-column align-items-start">
                        <button name="%(Barcode.action_product_barcodes)d" icon="arrow_forward" type="action" string="Configure Product Barcodes" class="btn-link fw-bold p-0"/>
                        <button name="%(Barcode.action_report_barcode_commands)d" icon="print" type="action" string="Print barcode commands and operation types" class="btn-link text-primary p-0"/>
                        <button name="%(Barcode.action_report_barcode_demo_sheet)d" icon="print" type="action" string="Print barcode demo sheet" class="btn-link text-primary p-0"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
