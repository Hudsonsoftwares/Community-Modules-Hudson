<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > Barcode > "Configure Product Barcodes": editable list of product variants -->
    <record id="product_product_barcode_list_view" model="ir.ui.view">
        <field name="name">product.product.barcode.list</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Product Barcodes" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="default_code" readonly="1"/>
                <field name="barcode"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_product_barcodes" model="ir.actions.act_window">
        <field name="name">Product Barcodes</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_product_barcode_list_view"/>
    </record>
</odoo>
