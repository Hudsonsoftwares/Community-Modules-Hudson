<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_barcode_commands_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <!-- Commands Section -->
                    <div class="mb-5">
                        <t t-set="commands" t-value="[
                            ('MAIN MENU', 'O-CMD.MAIN-MENU'),
                            ('DISCARD', 'O-CMD.DISCARD'),
                            ('VALIDATE', 'O-CMD.VALIDATE'),
                            ('CANCEL', 'O-CMD.CANCEL'),
                            ('PRINT PICKING OPERATION', 'O-CMD.PRINT-OP'),
                            ('PRINT DELIVERY SLIP', 'O-CMD.PRINT-SLIP'),
                            ('PUT IN PACK', 'O-CMD.PUT-IN-PACK'),
                            ('UNPACK', 'O-CMD.UNPACK'),
                            ('SCRAP', 'O-CMD.SCRAP'),
                            ('RECORD COMPONENTS', 'O-CMD.RECORD-COMP'),
                            ('RETURN', 'O-CMD.RETURN'),
                            ('WAIT A REVIEW', 'O-CMD.REVIEW')
                        ]"/>
                        <t t-foreach="commands" t-as="cmd">
                            <div class="mb-4 mt-4 text-center" style="width: 48%; display: inline-block; vertical-align: top;">
                                <div style="font-weight: bold; font-size: 14px; margin-bottom: 5px;" t-out="cmd[0]"/>
                                <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=100' % cmd[1]" style="width: 250px; height: 50px; max-width: 100%;" alt="Barcode"/>
                            </div>
                        </t>
                    </div>
                    
                    <!-- Page break for Operation Types -->
                    <p style="page-break-before:always;"> </p>
                    
                    <!-- Operation Types Section -->
                    <div class="row mt-4" style="display: flex; flex-wrap: wrap;">
                        <!-- repair operations are not handled by the Barcode app -->
                        <t t-set="picking_types" t-value="env['stock.picking.type'].search([('active', '=', True), ('code', '!=', 'repair_operation')])"/>
                        <t t-foreach="picking_types" t-as="pt">
                            <t t-if="pt.barcode">
                                <div class="col-3 mb-4 text-center" style="border: 1px solid black; padding: 10px; margin: 10px; width: 30%; display: inline-block;">
                                    <div style="font-weight: bold; font-size: 14px; margin-bottom: 5px;" t-out="pt.name"/>
                                    <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=100' % pt.barcode" style="width: 100%; height: 40px;" alt="Barcode"/>
                                    <div style="font-family: monospace; letter-spacing: 2px; margin-top: 5px;" t-out="pt.barcode"/>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
    
    <record id="action_report_barcode_commands" model="ir.actions.report">
        <field name="name">Barcode Commands &amp; Operations</field>
        <field name="model">stock.picking.type</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Barcode.report_barcode_commands_document</field>
        <field name="print_report_name">'Barcode_Commands'</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
