<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_barcode_scanner.HomeScreen" owl="1">
        <div class="h-100 d-flex flex-column bg-white">
            <WithSearch resModel="'stock.picking.type'" searchViewId="false" t-slot-scope="search">
                <!-- Custom Control Panel mimicking Odoo native -->
                <div class="o_control_panel d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="background-color: white; min-height: 56px;">
                        <div class="d-flex flex-column">
                            <div class="text-info small fw-bold cursor-pointer" style="font-size: 0.75rem; color: #017e84 !important; text-decoration: none;" t-on-click="props.onBack">Barcode</div>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-dark" style="font-size: 0.9rem;">Operations</span>
                                <i class="fa fa-cog ms-2 text-muted" style="font-size: 0.8rem;"/>
                            </div>
                        </div>
                    
                    <div class="o_cp_searchview flex-grow-1 mx-3" style="max-width: 500px;">
                        <SearchBar t-if="search.domain !== undefined" />
                    </div>
                    
                    <div class="o_cp_pager d-flex align-items-center text-muted" style="font-size: 0.85rem;">
                        <span class="me-3">
                            <t t-if="state.count > 0">1-<t t-esc="state.count"/></t>
                            <t t-else="">0-0</t>
                            / <t t-esc="state.count"/>
                        </span>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-light border-0 px-2 text-muted"><i class="fa fa-chevron-left"/></button>
                            <button class="btn btn-sm btn-light border-0 px-2 text-muted"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>
                </div>

                <!-- Kanban Tiles -->
                <HomeGrid domain="search.domain" onTypeClick="props.onTypeClick" onDataLoaded="(c) => state.count = c"/>
            </WithSearch>
        </div>
    </t>

    <t t-name="custom_barcode_scanner.HomeGrid" owl="1">
        <div class="o_barcode_kanban_container p-3 flex-grow-1" style="background-color: #f9f9f9;">
            <div class="row g-2">
                <t t-foreach="state.operationTypes" t-as="type" t-key="type.id">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="o_barcode_op_tile bg-white border d-flex justify-content-between align-items-center p-3 cursor-pointer" t-on-click="() => props.onTypeClick(type.id)" style="height: 70px;">
                            <span class="fw-bold text-uppercase" style="font-size: 0.8rem; color: #212529;"><t t-esc="type.name"/></span>
                            <span class="badge rounded-pill" style="background-color: #e9ecef; color: #495057; font-size: 0.75rem;"><t t-esc="type.count_picking_ready || 0"/></span>
                        </div>
                    </div>
                </t>
                <!-- Inventory Adjustments (only show if no active domain, to keep it simple) -->
                <div class="col-12 col-md-6 col-lg-3" t-if="!props.domain || props.domain.length === 0">
                    <div class="o_barcode_op_tile bg-white border d-flex justify-content-between align-items-center p-3 cursor-pointer" t-on-click="() => props.onTypeClick('inventory')" style="height: 70px;">
                        <span class="fw-bold text-uppercase" style="font-size: 0.8rem; color: #212529;">Inventory Adjustments</span>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
