<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_barcode_scanner.PickingListScreen" owl="1">
        <div class="h-100 d-flex flex-column bg-white">
            <WithSearch resModel="'stock.picking'" searchViewId="false" t-slot-scope="search">
                <!-- Custom Control Panel -->
                <div class="o_control_panel d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="background-color: white; min-height: 56px;">
                    <div class="o_cp_top_left d-flex align-items-center">
                        <button t-if="props.pickingTypeId !== 'inventory'" class="btn btn-sm text-white fw-bold me-3 px-3 py-1" style="background-color: #714B67; border-radius: 4px;" t-on-click="createNewPicking">New</button>
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center small fw-bold" style="font-size: 0.75rem; color: #017e84 !important;">
                                <span class="cursor-pointer me-1" t-on-click="() => props.onBack ? props.onBack() : null">...</span> /
                                <span class="cursor-pointer ms-1 me-1 text-info" t-on-click="() => props.onBack ? props.onBack() : null">Operations</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-dark" style="font-size: 0.9rem;">
                                    Hudson Custom Dev: <t t-esc="state.pickingTypeName"/>
                                </span>
                                <i class="fa fa-cog ms-2 text-muted" style="font-size: 0.8rem;"/>
                            </div>
                        </div>
                    </div>
                    
                    <div class="o_cp_searchview flex-grow-1 mx-3" style="max-width: 500px;">
                        <SearchBar t-if="search.domain !== undefined" />
                    </div>
                    
                    <div class="o_cp_pager d-flex align-items-center text-muted" style="font-size: 0.85rem;">
                        <span class="me-3">
                            <t t-if="state.count > 0">1-<t t-esc="state.count"/></t>
                            <t t-else="">0-0</t>
                            / <t t-esc="state.count"/>
                        </span>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-light border-0 px-2 text-muted"><i class="fa fa-chevron-left"/></button>
                            <button class="btn btn-sm btn-light border-0 px-2 text-muted"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>
                </div>
                
                <!-- Dark Banner -->
                <div class="text-white text-center py-2" style="background-color: #2C3E50; font-size: 0.85rem;">
                    Scan a <strong>transfer</strong>, a <strong>product</strong>, a <strong>lot</strong>, or a <strong>packaging</strong> to filter your records 
                    <i class="fa fa-barcode ms-2 fs-5 align-middle cursor-pointer" style="border: 1px dashed rgba(255,255,255,0.5); padding: 2px; border-radius: 2px;" t-on-click="toggleScanner"/>
                </div>
                
                <!-- Active Filter Badge -->
                <div t-if="state.barcodeFilter" class="bg-warning text-dark px-3 py-2 d-flex justify-content-between align-items-center fw-bold" style="font-size: 0.85rem;">
                    <span><i class="fa fa-filter me-2"/> Filtering by barcode: <t t-esc="state.barcodeFilter"/></span>
                    <i class="fa fa-times cursor-pointer fs-5" t-on-click="() => { state.barcodeFilter = ''; state.barcodeDomain = []; }"/>
                </div>
                
                <!-- Picking List Grid -->
                <PickingGrid domain="getGridDomain(search.domain)" pickingTypeId="props.pickingTypeId" onPickingClick="props.onPickingClick" onDataLoaded="(c) => state.count = c"/>
                
                <!-- Scanner Modal -->
                <t t-if="state.showScanner">
                    <!-- Backdrop -->
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0,0,0,0.5); z-index: 1040;" t-on-click="toggleScanner"></div>
                    
                    <!-- Modal Content -->
                    <div class="position-absolute top-50 start-50 translate-middle d-flex flex-column rounded shadow-lg overflow-hidden" style="background-color: #24242e; z-index: 1050; width: 90%; max-width: 600px; max-height: 90vh;">
                        <!-- Header -->
                        <div class="d-flex align-items-center p-3 text-white border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                            <i class="fa fa-arrow-left cursor-pointer me-3 fs-5" t-on-click="toggleScanner"/>
                            <span class="fs-5 fw-bold">Barcode Scanner</span>
                        </div>
                        
                        <!-- Video Area -->
                        <div class="position-relative d-flex justify-content-center align-items-center bg-dark" style="min-height: 350px;">
                            <video t-ref="videoElement" class="w-100 h-100 position-absolute" style="object-fit: cover;" playsinline="1" muted="1"/>
                            
                            <!-- Scanner Overlay (Crop box) -->
                            <div class="position-relative border border-white opacity-75" style="width: 70%; max-width: 400px; aspect-ratio: 16/9; border-width: 2px !important; z-index: 2;">
                                <i class="fa fa-crop position-absolute text-white" style="top: -10px; left: -10px;"/>
                            </div>
                        </div>
                        
                        <!-- Bottom Bar (Manual Input) -->
                        <div class="p-3" style="background-color: #1a1a24;">
                            <div class="d-flex bg-white rounded" style="padding: 2px;">
                                <input type="text" class="form-control border-0 shadow-none bg-transparent px-2" placeholder="Enter a barcode..." t-att-value="state.manualBarcode" t-on-input="onManualBarcodeInput" t-on-keyup="onKeyup" autofocus="1"/>
                                <button class="btn fw-bold px-4" style="color: white; background-color: #3d3d4e;" t-on-click="applyManualBarcode">Apply</button>
                            </div>
                        </div>
                    </div>
                </t>
            </WithSearch>
        </div>
    </t>

    <t t-name="custom_barcode_scanner.PickingGrid" owl="1">
        <div class="p-3 flex-grow-1 overflow-auto" style="background-color: #f9f9f9;">
                <t t-if="state.pickings.length === 0">
                    <div class="alert alert-info">No transfers found.</div>
                </t>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.5rem;">
                    <t t-foreach="state.pickings" t-as="picking" t-key="picking.id">
                        <div class="bg-white border d-flex flex-column justify-content-between p-2 cursor-pointer shadow-sm" style="height: 85px; border-radius: 4px;" t-on-click="() => props.onPickingClick(picking.id)">
                            <!-- Top Row -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-bold text-dark text-truncate" style="font-size: 0.85rem; max-width: 70%;">
                                    <i class="fa fa-star-o text-muted me-1"/> <t t-esc="picking.name"/>
                                </div>
                                <span class="badge rounded-pill" style="background-color: #28a745; font-size: 0.65rem; padding: 0.35em 0.65em;">
                                    <t t-esc="picking.state === 'assigned' ? 'Ready' : (picking.state === 'confirmed' ? 'Waiting' : picking.state)"/>
                                </span>
                            </div>
                            <!-- Bottom Row -->
                            <div class="d-flex justify-content-between align-items-end text-muted" style="font-size: 0.75rem;">
                                <div class="text-truncate" style="max-width: 65%;">
                                    <t t-esc="picking.partner_id ? picking.partner_id[1] : ' '"/>
                                </div>
                                <div class="text-end">
                                    <t t-esc="this.formatDate(picking.scheduled_date)"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                
                <!-- Load More Button -->
                <div t-if="state.hasMore" class="d-flex justify-content-center mt-3 mb-4">
                    <button class="btn btn-outline-secondary px-4 py-2" style="border-radius: 20px;" t-on-click="loadMore">
                        <i class="fa fa-refresh me-2"/> Load More
                    </button>
                </div>
            </div>
    </t>
</templates>
