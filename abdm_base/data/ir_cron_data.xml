<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_abdm_transaction_expire" model="ir.cron">
            <field name="name">ABDM: Expire Unanswered Transactions</field>
            <field name="model_id" ref="model_abdm_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_abdm_log_purge" model="ir.cron">
            <field name="name">ABDM: Purge Old API Logs</field>
            <field name="model_id" ref="model_abdm_api_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
