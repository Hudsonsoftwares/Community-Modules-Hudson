<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abdm_api_log_view_list" model="ir.ui.view">
        <field name="name">abdm.api.log.list</field>
        <field name="model">abdm.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'error'" decoration-muted="direction == 'incoming'">
                <field name="create_date" string="Date"/>
                <field name="direction"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="duration_ms" optional="show"/>
                <field name="environment" optional="hide"/>
                <field name="request_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="abdm_api_log_view_form" model="ir.ui.view">
        <field name="name">abdm.api.log.form</field>
        <field name="model">abdm.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="endpoint"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="method"/>
                            <field name="status_code"/>
                            <field name="state"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="environment"/>
                            <field name="request_id"/>
                            <field name="correlation_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message" class="text-danger"/>
                    <notebook>
                        <page string="Request" name="request">
                            <label for="request_headers"/>
                            <field name="request_headers" widget="code" options="{'mode': 'javascript'}"/>
                            <label for="request_body"/>
                            <field name="request_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="abdm_api_log_view_search" model="ir.ui.view">
        <field name="name">abdm.api.log.search</field>
        <field name="model">abdm.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="request_id"/>
                <field name="correlation_id"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter name="incoming" string="Incoming (callbacks)" domain="[('direction', '=', 'incoming')]"/>
                <separator/>
                <filter name="today" string="Today" date="create_date" default_period="today"/>
                <group>
                    <filter name="group_endpoint" string="Endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_abdm_api_log" model="ir.actions.act_window">
        <field name="name">API Log</field>
        <field name="res_model">abdm.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ABDM calls yet</p>
            <p>Every call to ABDM and every answer it sends back is recorded here, with secrets, OTPs and Aadhaar numbers hidden.</p>
        </field>
    </record>
</odoo>
