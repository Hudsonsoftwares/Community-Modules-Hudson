<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">

        <record id="module_category_hr_appraisal" model="ir.module.category">
            <field name="name">Appraisal</field>
            <field name="description">Helps you manage employee appraisals.</field>
            <field name="sequence">15</field>
        </record>

        
        <record id="group_hr_appraisal_user" model="res.groups">
            <field name="name">Appraisal: User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="comment">The user will be able to view their own appraisals and goals.</field>
        </record>

        <record id="group_hr_appraisal_manager" model="res.groups">
            <field name="name">Appraisal: Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_hr_appraisal_user'))]" />
            <field name="comment">The user will have access to appraisals where they are set as manager.</field>
        </record>

        <record id="group_hr_appraisal_admin" model="res.groups">
            <field name="name">Appraisal: Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_hr_appraisal_manager'))]" />
            <field name="comment">The user will have full access to all appraisals.</field>
        </record>

        
        <record id="hr_appraisal_rule_user" model="ir.access">
            <field name="name">Employee Appraisal</field>
            <field name="model_id" ref="model_hr_appraisal" />
            <field name="domain">['|', ('employee_id.user_id', '=', user.id), ('appraiser_ids.user_id', '=', user.id)]</field>
            <field name="group_id" ref="group_hr_appraisal_user" />
        <field name="operation">crud</field></record>
        
        <record id="hr_appraisal_goal_rule_user" model="ir.access">
            <field name="name">Employee Appraisal Goal</field>
            <field name="model_id" ref="model_hr_appraisal_goal" />
            <field name="domain">['|', ('employee_id.user_id', '=', user.id), ('appraisal_id.appraiser_ids.user_id', '=', user.id)]</field>
            <field name="group_id" ref="group_hr_appraisal_user" />
        <field name="operation">crud</field></record>

        <record id="hr_appraisal_rule_manager" model="ir.access">
            <field name="name">Manager Appraisal</field>
            <field name="model_id" ref="model_hr_appraisal" />
            <field name="domain">['|', '|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id), ('appraiser_ids.user_id', '=', user.id)]</field>
            <field name="group_id" ref="group_hr_appraisal_manager" />
        <field name="operation">crud</field></record>
        
        <record id="hr_appraisal_goal_rule_manager" model="ir.access">
            <field name="name">Manager Appraisal Goal</field>
            <field name="model_id" ref="model_hr_appraisal_goal" />
            <field name="domain">['|', ('employee_id.user_id', '=', user.id), ('appraisal_id.manager_id.user_id', '=', user.id)]</field>
            <field name="group_id" ref="group_hr_appraisal_manager" />
        <field name="operation">crud</field></record>

        <record id="hr_appraisal_rule_admin" model="ir.access">
            <field name="name">Admin Appraisal</field>
            <field name="model_id" ref="model_hr_appraisal" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="group_hr_appraisal_admin" />
        <field name="operation">crud</field></record>
        
        <record id="hr_appraisal_goal_rule_admin" model="ir.access">
            <field name="name">Admin Appraisal Goal</field>
            <field name="model_id" ref="model_hr_appraisal_goal" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="group_hr_appraisal_admin" />
        <field name="operation">crud</field></record>
        
    </data>
</odoo>