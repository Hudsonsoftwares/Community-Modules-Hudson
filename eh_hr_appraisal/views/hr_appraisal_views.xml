<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Appraisal Kanban View -->
    <record id="view_hr_appraisal_kanban" model="ir.ui.view">
        <field name="name">hr.appraisal.kanban</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                <header>
                    <button name="%(eh_hr_appraisal.action_appraisal_launch_wizard)d" string="Launch Campaign" type="action" display="always"/>
                </header>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="date_appraisal"/>
                <field name="state"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_appraisal_kanban">
                            
                            <widget name="web_ribbon" title="ONGOING" bg_color="bg-success" invisible="state != 'ongoing'"/>
                            <widget name="web_ribbon" title="DONE" bg_color="bg-purple" invisible="state != 'done'"/>

                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image: url('/web/image/hr.employee/#{record.employee_id.raw_value}/avatar_128')">
                            </div>
                            <div class="o_kanban_image d-md-none" t-attf-style="background-image: url('/web/image/hr.employee/#{record.employee_id.raw_value}/avatar_128')">
                            </div>

                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="employee_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.department_id.value or record.job_id.value" class="text-muted">
                                        <t t-if="record.department_id.value"><field name="department_id"/></t>
                                        <t t-if="record.department_id.value and record.job_id.value"> / </t>
                                        <t t-if="record.job_id.value"><field name="job_id"/></t>
                                    </div>
                                    <div class="mt-1 text-muted">
                                        <field name="date_appraisal"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-auto d-flex justify-content-between align-items-end">
                                    <div class="oe_kanban_bottom_left">
                                        
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <div class="o_kanban_inline_block">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                        </div>
                                        <div class="o_kanban_inline_block ml4 ms-1">
                                            <a name="%(action_hr_appraisal_goal)d" type="action" class="btn btn-sm btn-link p-0 text-muted" title="Goals">
                                                <i class="fa fa-book fa-lg" style="color: #6d4c41;"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_appraisal_form" model="ir.ui.view">
        <field name="name">hr.appraisal.form</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <form string="Appraisal">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Done" type="object" class="oe_highlight" invisible="state != 'ongoing'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'ongoing']"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ['cancel', 'done']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hr_appraisal_goal)d" type="action" class="oe_stat_button" icon="fa-bullseye" context="{'search_default_appraisal_id': id, 'default_appraisal_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Goals</span>
                            </div>
                        </button>
                    </div>
                    <field name="avatar_1920" widget="image" class="oe_avatar" readonly="1"/>
                    <div class="oe_title">
                        <label for="employee_id" string="Employee to review"/>
                        <h1>
                            <field name="employee_id" placeholder="e.g. John Doe"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="appraiser_ids" widget="many2many_tags_avatar" options="{'color_field': 'color'}"/>
                            <field name="date_appraisal"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appraisal" name="appraisal">
                            <div class="row">
                                <div class="col-6 pe-4">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h3 class="m-0">Employee's Feedback</h3>
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold" style="color: #017e84;" invisible="employee_feedback_published">Private</span>
                                            <span class="fw-bold text-muted" invisible="not employee_feedback_published">Private</span>
                                            <field name="employee_feedback_published" widget="boolean_toggle" class="mx-2" nolabel="1"/>
                                            <span class="fw-bold text-muted" invisible="employee_feedback_published">Shared to Appraisers</span>
                                            <span class="fw-bold" style="color: #017e84;" invisible="not employee_feedback_published">Shared to Appraisers</span>
                                        </div>
                                    </div>
                                    <div invisible="employee_feedback_published" class="position-relative mt-4">
                                        <div style="filter: blur(4px); opacity: 0.6; pointer-events: none; user-select: none;">
                                            <h4 class="text-muted">My work</h4>
                                            <p class="text-muted mb-4">What are my most important accomplishments this year?</p>
                                            <p class="text-muted">Describe something you are proud of...</p>
                                            <br/><br/>
                                            <p class="text-muted">What has been the most challenging aspect of my work this past year, and why?</p>
                                        </div>
                                        <div class="position-absolute w-100 text-center" style="top: 20%; left: 0;">
                                            <h4>Self Assessment will show here<br/>once published</h4>
                                        </div>
                                    </div>
                                    <field name="employee_feedback" nolabel="1" widget="html" options="{'collaborative': true}" invisible="not employee_feedback_published"/>
                                </div>
                                <div class="col-6 ps-4 bg-light pb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                                        <h3 class="m-0">Manager's Feedback</h3>
                                        <div class="d-flex align-items-center">
                                            <field name="manager_feedback_published" widget="boolean_toggle" class="me-2" nolabel="1"/>
                                        </div>
                                    </div>
                                    <div invisible="manager_feedback_published" class="position-relative mt-4">
                                        <div style="filter: blur(4px); opacity: 0.6; pointer-events: none; user-select: none;">
                                            <h4 class="text-muted">Feedback</h4>
                                            <p class="text-muted mb-4">Give one positive achievement that demonstrates the employee's value.</p>
                                            <br/><br/>
                                            <h4 class="text-muted">Evaluation</h4>
                                        </div>
                                        <div class="position-absolute w-100 text-center" style="top: 20%; left: 0;">
                                            <h4>Manager Assessment will show here<br/>once published</h4>
                                        </div>
                                    </div>
                                    <field name="manager_feedback" nolabel="1" widget="html" options="{'collaborative': true}" invisible="not manager_feedback_published"/>
                                </div>
                            </div>
                        </page>
                        <page string="Private Note" name="private_note">
                            <field name="private_note" placeholder="Private note..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hr_appraisal_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.tree</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <list string="Appraisals">
                <header>
                    <button name="%(eh_hr_appraisal.action_appraisal_launch_wizard)d" string="Launch Campaign" type="action" display="always"/>
                </header>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_appraisal"/>
                <field name="state" widget="badge" decoration-info="state == 'ongoing'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_appraisal_search" model="ir.ui.view">
        <field name="name">hr.appraisal.search</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <search string="Search Appraisals">
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ongoing" name="ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Manager" name="group_by_manager" context="{'group_by':'manager_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by':'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_hr_appraisal_pivot" model="ir.ui.view">
        <field name="name">hr.appraisal.pivot</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <pivot string="Appraisal Analysis">
                <field name="department_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    
    <!-- Graph View -->
    <record id="view_hr_appraisal_graph" model="ir.ui.view">
        <field name="name">hr.appraisal.graph</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <graph string="Appraisal Analysis">
                <field name="department_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    
    <!-- Calendar View -->
    <record id="view_hr_appraisal_calendar" model="ir.ui.view">
        <field name="name">hr.appraisal.calendar</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <calendar string="Appraisals" date_start="date_appraisal" color="state">
                <field name="employee_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    
    <!-- Activity View -->
    <record id="view_hr_appraisal_activity" model="ir.ui.view">
        <field name="name">hr.appraisal.activity</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <activity string="Appraisals">
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="employee_id"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_appraisal" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">hr.appraisal</field>
        <field name="view_mode">kanban,list,form,calendar,activity,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new appraisal!
            </p>
        </field>
    </record>
</odoo>
