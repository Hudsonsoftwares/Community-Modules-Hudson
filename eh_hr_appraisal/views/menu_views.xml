<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Menu Item -->
    <menuitem id="menu_hr_appraisal_root" name="Appraisals" sequence="90" web_icon="eh_hr_appraisal,static/description/icon.png"/>

    <!-- Appraisals Submenus -->
    <menuitem id="menu_hr_appraisal_appraisals" name="Appraisals" parent="menu_hr_appraisal_root" sequence="1"/>
    
    <!-- Appraisals Actions -->
    <menuitem id="menu_hr_appraisal_main" name="Appraisals" parent="menu_hr_appraisal_appraisals" action="action_hr_appraisal" sequence="1"/>

    <!-- Goals Menu -->
    <menuitem id="menu_hr_appraisal_goals" name="Goals" parent="menu_hr_appraisal_root" action="action_hr_appraisal_goal" sequence="2"/>

    <!-- Reporting Menu -->
    <menuitem id="menu_hr_appraisal_report" name="Reporting" parent="menu_hr_appraisal_root" sequence="90"/>
    <menuitem id="menu_hr_appraisal_analysis_report" name="Appraisal Analysis" parent="menu_hr_appraisal_report" action="action_hr_appraisal_analysis_report" sequence="10"/>
    <menuitem id="menu_hr_appraisal_skills_evolution" name="Skills Evolution" parent="menu_hr_appraisal_report" action="action_hr_appraisal_skills_evolution" sequence="20"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_hr_appraisal_config" name="Configuration" parent="menu_hr_appraisal_root" sequence="100"/>
    <menuitem id="menu_hr_appraisal_configuration_settings" name="Settings" parent="menu_hr_appraisal_config" action="action_hr_appraisal_configuration" sequence="0"/>
    <menuitem id="menu_hr_appraisal_template" name="Appraisal Templates" parent="menu_hr_appraisal_config" action="action_hr_appraisal_template" sequence="10"/>
    <menuitem id="menu_hr_appraisal_scale" name="Evaluation Scale" parent="menu_hr_appraisal_config" action="action_hr_appraisal_scale" sequence="20"/>
    <menuitem id="menu_hr_appraisal_360_feedback" name="360 Feedback" parent="menu_hr_appraisal_config" action="survey.action_survey_form" sequence="25"/>
    <menuitem id="menu_hr_appraisal_skills" name="Skills" parent="menu_hr_appraisal_config" action="hr_skills.hr_skill_type_action" sequence="30"/>
    
    <!-- Goals Configuration Menu -->
    <menuitem id="menu_hr_appraisal_goals_config" name="Goals" parent="menu_hr_appraisal_config" sequence="40"/>
    <menuitem id="menu_hr_appraisal_goal_template" name="Library" parent="menu_hr_appraisal_goals_config" action="action_hr_appraisal_goal_template" sequence="10"/>
    <menuitem id="menu_hr_appraisal_goal_tag" name="Tags" parent="menu_hr_appraisal_goals_config" action="action_hr_appraisal_goal_tag" sequence="20"/>
    
    <!-- Activities Configuration Menu -->
    <record id="action_hr_appraisal_activity_type" model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('res_model', '=', 'hr.appraisal'), ('res_model', '=', False)]</field>
        <field name="context">{'default_res_model': 'hr.appraisal'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_appraisal_mail_activity_type_view_form')})]"/>
    </record>

    <record id="action_hr_appraisal_activity_plan" model="ir.actions.act_window">
        <field name="name">Activity Plans</field>
        <field name="res_model">mail.activity.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('res_model', '=', 'hr.appraisal'), ('res_model', '=', False)]</field>
        <field name="context">{'default_res_model': 'hr.appraisal'}</field>
    </record>

    <menuitem id="menu_hr_appraisal_activities_config" name="Activities" parent="menu_hr_appraisal_config" sequence="50"/>
    <menuitem id="menu_hr_appraisal_activity_types" name="Activity Types" parent="menu_hr_appraisal_activities_config" action="action_hr_appraisal_activity_type" sequence="10"/>
    <menuitem id="menu_hr_appraisal_activity_plans" name="Activity Plans" parent="menu_hr_appraisal_activities_config" action="action_hr_appraisal_activity_plan" sequence="20"/>
    

</odoo>
