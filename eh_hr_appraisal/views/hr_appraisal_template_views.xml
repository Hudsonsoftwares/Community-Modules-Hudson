<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Appraisal Template Form View -->
    <record id="view_hr_appraisal_template_form" model="ir.ui.view">
        <field name="name">hr.appraisal.template.form</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <form string="Appraisal Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Short Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Annual Appraisal"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_ids" widget="many2many_tags" placeholder="Visible to all"/>
                        </group>
                        <group>
                            <field name="survey_id" placeholder="Every template allowed"/>
                        </group>
                    </group>
                    <div class="row mt-4">
                        <div class="col-6 pe-4">
                            <div class="mb-4">
                                <h3 class="m-0">Employee Feedback</h3>
                            </div>
                            <field name="employee_feedback_template" nolabel="1" widget="html" options="{'collaborative': true}" placeholder="Use this area to write the content that will be displayed for the Employee..."/>
                        </div>
                        <div class="col-6 ps-4 bg-light pb-4">
                            <div class="mb-4 mt-2">
                                <h3 class="m-0">Manager Feedback</h3>
                            </div>
                            <field name="manager_feedback_template" nolabel="1" widget="html" options="{'collaborative': true}" placeholder="Use this area to write the content that will be displayed for the Manager..."/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Appraisal Template Tree View -->
    <record id="view_hr_appraisal_template_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.template.tree</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <list string="Appraisal Templates">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Appraisal Template Action -->
    <record id="action_hr_appraisal_template" model="ir.actions.act_window">
        <field name="name">Appraisal Templates</field>
        <field name="res_model">hr.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
