<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tax_proofs_dms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tax.proofs.dms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hudson_payroll_dms.res_config_settings_view_form_dms"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='hds_dms_store_payslips_setting']" position="after">
                <setting id="hds_dms_store_tax_proofs_setting" string="Store Tax Proofs in Documents"
                         help="Copy the proof files of submitted tax declarations into the employee's Documents folder (Payroll / tax year / Tax Proofs). Locked once the proofs are verified.">
                    <field name="hds_dms_store_tax_proofs"/>
                    <div class="mt8" invisible="not hds_dms_store_tax_proofs">
                        <button name="action_hds_dms_store_existing_tax_proofs" type="object" icon="arrow_forward"
                                string="Store existing tax proofs" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
