<?xml version="1.0" encoding="UTF-8"?>
<!--
  Branding Remover – HR Attendance Kiosk Mode template patch
  ==========================================================
  Removes the "Powered by <Odoo logo>" text shown at the bottom of the
  HR Attendance kiosk mode screen (public_kiosk_app).

  The text appears in two branches of the same template:
    • Inside the t-if="kioskMode !== 'barcode'" branch: a <span> containing
      "Powered by <img logo>"
    • Inside the t-else (barcode-only) branch: a <div> containing
      "Powered by <img logo>"

  Both are located inside the o_hr_kiosk_mode_bottom container and are
  replaced with nothing.

  NOTE: Only the visible UI branding element is removed.
       No copyright or licence text in source files is altered.
-->
<templates xml:space="preserve">
    <t t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">
        <!--
            Remove "Powered by <Odoo logo>" from the barcode/non-barcode bottom bar.
            Both occurrences live inside .o_hr_kiosk_mode_bottom.
            We target the containing div and replace it with an empty equivalent
            (keeping only the "Identify Manually" button in the non-barcode branch).
        -->
        <xpath expr="//div[hasclass('o_hr_kiosk_mode_bottom')]" position="replace">
            <div class="o_hr_kiosk_mode_bottom d-flex flex-column flex-md-row gap-2 align-items-center justify-content-between my-5">
                <t t-if="this.props.kioskMode !== 'barcode'">
                    <button t-on-click="() =&gt; this.switchDisplay('manual')" class="btn btn-light btn-lg rounded-3">
                        <i class="fa fa-user-o me-2"/>
                        <span>Identify Manually</span>
                    </button>
                </t>
            </div>
        </xpath>
    </t>
</templates>
