<?xml version="1.0" encoding="utf-8"?>
<!--
  Branding Remover – QWeb/Server-side template overrides
  =======================================================
  Removes Odoo branding from:
    1. The "Powered by Odoo" block in portal pages and reports
       (web.brand_promotion).
    2. The "Powered by Odoo" link on the database login page footer
       (web.login_layout).
    3. The Odoo "O" logo overlaid on QR codes in PDF invoices
       (account.report_invoice_document).

  NOTE: This file intentionally does NOT touch any source-code copyright
  or licence notices. Only visible branding UI elements are overridden.
-->
<odoo>
    <!-- ================================================================
         1. Portal / Report footer – "Powered by Odoo" brand block
         ================================================================
         Override the brand_promotion template to render nothing.
         This single override stops the branding from appearing on
         portal pages, the payment confirmation page, and any report
         that calls web.brand_promotion.
    -->
    <template id="brand_promotion"
              inherit_id="web.brand_promotion"
              name="Branding Remover – Hide Powered by Odoo">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>

    <!-- ================================================================
         2. Login page footer – "Powered by Odoo" link
         ================================================================
         Remove the anchor element that reads "Powered by Odoo" from the
         footer of the login / database-selection page.
    -->
    <template id="login_layout_no_branding"
              inherit_id="web.login_layout"
              name="Branding Remover – Remove Powered by Odoo from Login">
        <!-- Replace the "Powered by Odoo" anchor with nothing (position="remove" is not valid in Odoo QWeb) -->
        <xpath expr="//a[contains(@href, 'odoo.com') and contains(., 'Powered')]"
               position="replace"/>
    </template>

    <!-- ================================================================
         3. Portal sidebar – hardcoded "Powered by Odoo" link
         ================================================================
         The portal.portal_record_sidebar template contains a hardcoded
         "Powered by Odoo" div (separate from web.brand_promotion).
         This is the branding visible on the invoice, sales order, and
         all other portal document sidebar pages.
    -->
    <template id="portal_record_sidebar_no_branding"
              inherit_id="portal.portal_record_sidebar"
              name="Branding Remover – Remove Powered by Odoo from Portal Sidebar">
        <xpath expr="//div[hasclass('d-none') and hasclass('d-lg-block') and hasclass('mt-5')]"
               position="replace"/>
    </template>

    <!-- ================================================================
         4. Invoice PDF – Remove Odoo "O" logo from QR code images
         ================================================================
         The account.report_invoice_document template places the Odoo "O"
         SVG logo on top of every QR code image (banking QR + payment link
         QR). We remove those overlay <img> elements via xpath.
    -->
    <template id="report_invoice_no_qr_odoo_logo"
              inherit_id="account.report_invoice_document"
              name="Branding Remover – Remove Odoo Logo from Invoice QR Codes">
        <!-- Replace Odoo logo overlay on QR codes with nothing -->
        <xpath expr="//img[@id='qrcode_odoo_logo']" position="replace"/>
    </template>
</odoo>
