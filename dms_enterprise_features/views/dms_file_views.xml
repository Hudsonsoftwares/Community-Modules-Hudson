    <!-- Add Trash to Search Panel -->
    <record id="search_dms_file_inherit_trash" model="ir.ui.view">
        <field name="name">dms_file.search.inherit.trash</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.search_dms_file"/>
        <field name="arch" type="xml">
            <!-- Override My Files filter to include creator, owner, assigned approver, and explicitly granted users -->
            <xpath expr="//filter[@name='filter_user']" position="attributes">
                <attribute name="domain">[('is_my_file', '=', True)]</attribute>
            </xpath>
            <!-- Add search fields for Category and Tags -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="category_id" string="Category" filter_domain="[('category_id', 'ilike', self)]"/>
                <field name="tag_ids" string="Tags" filter_domain="[('tag_ids.name', 'ilike', self)]"/>
            </xpath>
            <!-- Add a filter to the top search bar instead -->
            <xpath expr="//filter[@name='filter_active']" position="after">
                <filter string="Starred" name="filter_starred" domain="[('starred', '=', True)]" />
                <separator/>
                <filter string="Awaiting My Approval" name="filter_awaiting_my_approval" domain="[('approval_state', '=', 'in_approval'), ('current_approver_ids', 'in', [uid])]"/>
                <filter string="In Approval" name="filter_in_approval" domain="[('approval_state', '=', 'in_approval')]"/>
                <filter string="Approved" name="filter_approved" domain="[('approval_state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('approval_state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Trashed" name="filter_trashed" domain="[('active', '=', False), ('is_trashed', '=', True)]" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Category" name="groupby_category" domain="[]" context="{'group_by': 'category_id'}"/>
                <filter string="Tags" name="groupby_tags" domain="[]" context="{'group_by': 'tag_ids'}"/>
                <filter string="Approval Status" name="groupby_approval_state" domain="[]" context="{'group_by': 'approval_state'}"/>
            </xpath>
            <xpath expr="//searchpanel" position="inside">
                <field name="tag_ids" icon="fa-tags" select="multi" enable_counters="1"/>
            </xpath>
        </field>
    </record>

