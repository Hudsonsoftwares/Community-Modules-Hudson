<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_file_form_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.form.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_form"/>
        <field name="arch" type="xml">
            <!-- Disable default delete on the form -->
            <xpath expr="//form" position="attributes">
                <attribute name="delete">0</attribute>
            </xpath>
            
            <!-- Add buttons and upload to existing header -->
            <xpath expr="//header" position="inside">
                <button name="action_request_approval" string="Request Approval" type="object" class="oe_highlight" invisible="status != 'draft' or not workflow_id" groups="dms_enterprise_features.group_dms_document_controller"/>
                <button name="action_setup_signatures" string="Setup Signatures" type="object" class="oe_highlight" invisible="status != 'draft' or mimetype != 'application/pdf'" groups="dms_enterprise_features.group_dms_document_controller"/>
                <field name="content" widget="binary" filename="name" nolabel="1" class="btn btn-secondary" groups="dms_enterprise_features.group_dms_document_controller"/>
                <field name="status" widget="statusbar" statusbar_visible="draft,in_approval,approved,obsolete" groups="dms_enterprise_features.group_dms_document_controller"/>
            </xpath>
            <!-- Add locked by alert -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not is_locked" style="margin-bottom:0px;">
                    <i class="fa fa-lock me-2"/> Locked by <field name="locked_by" readonly="1" class="fw-bold"/>
                </div>
            </xpath>
            <!-- Insert document controller fields in form -->
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Document Controller" groups="dms_enterprise_features.group_dms_document_controller">
                    <group>
                        <field name="document_number" invisible="not id"/>
                        <field name="department_id"/>
                        <field name="document_owner_id"/>
                        <field name="directory_id" options="{'no_quick_create': True}"/>
                    </group>
                    <group>
                        <field name="confidentiality"/>
                        <field name="expiry_date"/>
                        <field name="notify_user_id" invisible="not expiry_date" widget="many2one_avatar_user"/>
                        <field name="notify_before_days" invisible="not expiry_date"/>
                        <field name="workflow_id"/>
                        <field name="category_id" placeholder="Internal / Human Resource" options="{'no_open': True, 'no_create': True}"/>
                        <field name="tag_ids" widget="many2many_tags" placeholder="Tags..." options="{'color_field': 'color', 'no_create_edit': True}"/>
                        <field name="signature_needed" invisible="1"/>
                    </group>
                </group>
            </xpath>
            
            <!-- Inject into existing notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Revisions" name="revisions" groups="dms_enterprise_features.group_dms_document_controller">
                    <field name="revision_ids" context="{'default_file_id': id, 'active_test': False}">
                        <list delete="0">
                            <field name="version"/>
                            <field name="upload_date"/>
                            <field name="uploader_id"/>
                            <field name="comments"/>
                            <field name="active" column_invisible="True"/>
                            <field name="file_name" column_invisible="True"/>
                            <button name="action_view_online" type="object" icon="fa-eye" title="View Online" class="btn-secondary"/>
                            <button name="action_download_online" type="object" icon="fa-download" title="Download" class="btn-secondary"/>
                            <button name="action_make_current" type="object" string="Set as Active" invisible="active" class="btn-primary"/>
                            <button name="action_delete_revision" type="object" icon="fa-trash" title="Delete Revision" invisible="active" class="btn-danger"/>
                        </list>
                    </field>
                </page>
                <page string="Access Control" name="access_control" groups="dms_enterprise_features.group_dms_document_controller">
                    <field name="access_ids"/>
                </page>
            </xpath>
            
            <!-- Hide the default Access Information tab -->
            <xpath expr="//page[@name='page_access']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Hide extension and mimetype -->
            <xpath expr="//field[@name='extension']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='mimetype']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Hide the settings group (we moved needed fields to Document Controller) -->
            <xpath expr="//group[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the original content group -->
            <xpath expr="//group[@name='content']/group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Standalone Tree view for Revisions -->
    <record id="view_dms_file_revision_tree" model="ir.ui.view">
        <field name="name">dms.file.revision.tree</field>
        <field name="model">dms.file.revision</field>
        <field name="arch" type="xml">
            <list>
                <field name="version"/>
                <field name="upload_date"/>
                <field name="uploader_id"/>
                <field name="comments"/>
                <field name="active" column_invisible="True"/>
                <field name="file_name" column_invisible="True"/>
                <field name="content" widget="binary" filename="file_name" string="View / Download"/>
                <button name="action_make_current" type="object" string="Set as Active" invisible="active" class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Standalone Tree view for Access -->
    <record id="view_dms_file_access_tree" model="ir.ui.view">
        <field name="name">dms.file.access.tree</field>
        <field name="model">dms.file.access</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="group_id"/>
                <field name="department_id"/>
                <field name="perm_view"/>
                <field name="perm_download"/>
                <field name="perm_edit"/>
                <field name="perm_delete"/>
                <field name="perm_move"/>
                <field name="perm_rename"/>
                <field name="perm_share"/>
            </list>
        </field>
    </record>

    <record id="view_dms_file_revision_form" model="ir.ui.view">
        <field name="name">dms.file.revision.form</field>
        <field name="model">dms.file.revision</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="version"/>
                            <field name="content" filename="file_name"/>
                            <field name="file_id" invisible="1"/>
                            <field name="mimetype" invisible="1"/>
                        </group>
                        <group>
                            <field name="uploader_id"/>
                            <field name="upload_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="comments"/>
                    </group>
                    <notebook>
                        <page string="Approval History" name="approvals">
                            <field name="approval_history_ids" readonly="1">
                                <list>
                                    <field name="approver_id"/>
                                    <field name="status"/>
                                    <field name="date"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature Requests" name="signatures" invisible="mimetype != 'application/pdf'">
                            <field name="signature_request_ids" context="{'default_revision_id': id}">
                                <list>
                                    <field name="recipient_id"/>
                                    <field name="state"/>
                                    <field name="signed_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_dms_file_tree_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.tree.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="document_number" optional="show" groups="dms_enterprise_features.group_dms_document_controller"/>
                <field name="status" optional="show" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'in_approval'" decoration-success="status == 'approved'" decoration-muted="status == 'obsolete'" decoration-danger="status == 'rejected'" groups="dms_enterprise_features.group_dms_document_controller"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_dms_file_kanban_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.kanban.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'in_approval'" decoration-success="status == 'approved'" decoration-muted="status == 'obsolete'" decoration-danger="status == 'rejected'" groups="dms_enterprise_features.group_dms_document_controller"/>
            </xpath>
        </field>
    </record>

    <!-- Hide Manual File Migration feature as requested -->
    <record id="dms.menu_dms_file_migration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Hide Storages menu as it is not used in enterprise -->
    <record id="dms.menu_dms_storage" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Hide tags without a category to remove the 'None' stage -->
    <record id="dms.action_dms_tag" model="ir.actions.act_window">
        <field name="domain">[('category_id', '!=', False)]</field>
    </record>

    <!-- Disable default delete on list and kanban -->
    <record id="view_dms_file_tree_inherit_trash" model="ir.ui.view">
        <field name="name">dms.file.tree.inherit.trash</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_dms_file_kanban_inherit_trash" model="ir.ui.view">
        <field name="name">dms.file.kanban.inherit.trash</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="delete">0</attribute>
            </xpath>
            <xpath expr="//field[@name='permission_unlink']" position="after">
                <field name="permission_download" />
                <field name="permission_view" />
                <field name="permission_edit" />
                <field name="permission_upload" />
                <field name="permission_delete" />
            </xpath>
            <xpath expr="//a[i[hasclass('fa-external-link')]]/.." position="replace">
                <!-- Removed redundant Open option -->
            </xpath>
            <xpath expr="//a[i[hasclass('fa-pencil')]]/.." position="replace">
                <div role="menuitem" t-if="record.permission_write and record.permission_write.raw_value">
                    <a type="object" name="action_open_form_view" class="dropdown-item">
                        <i class="fa fa-pencil" />
                        Edit
                    </a>
                </div>
            </xpath>
            <xpath expr="//a[@type='delete']" position="replace">
                <div role="menuitem" t-if="record.permission_unlink and record.permission_unlink.raw_value">
                    <a type="object" name="action_send_to_trash" class="dropdown-item">
                        <i class="fa fa-trash-o" />
                        Send to Trash
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Server Actions for Trash Options in the Action Menu (Gear Icon) -->
    <record id="action_server_dms_file_send_to_trash" model="ir.actions.server">
        <field name="name">Send to Trash</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="binding_model_id" ref="dms.model_dms_file"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_send_to_trash()
        </field>
    </record>

    <record id="action_server_dms_file_restore" model="ir.actions.server">
        <field name="name">Restore</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="binding_model_id" ref="dms.model_dms_file"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_restore()
        </field>
    </record>
    <!-- Add Trash to Search Panel -->
    <record id="search_dms_file_inherit_trash" model="ir.ui.view">
        <field name="name">dms_file.search.inherit.trash</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.search_dms_file"/>
        <field name="arch" type="xml">
            <!-- Add a filter to the top search bar instead -->
            <xpath expr="//filter[@name='filter_active']" position="after">
                <filter string="Trashed" name="filter_trashed" domain="[('active', '=', False), ('is_trashed', '=', True)]" />
            </xpath>
        </field>
    </record>
</odoo>
