<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_file_form_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.form.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_form"/>
        <field name="arch" type="xml">
            <!-- Add status bar -->
            <xpath expr="//sheet" position="before">
                <header groups="dms_enterprise_features.group_dms_document_controller">
                    <button name="action_request_approval" string="Request Approval" type="object" class="oe_highlight" invisible="status != 'draft' or not workflow_id"/>
                    <button name="action_setup_signatures" string="Setup Signatures" type="object" class="oe_highlight" invisible="status != 'draft' or not signature_needed"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_approval,approved,obsolete"/>
                </header>
            </xpath>
            
            <!-- Insert document controller fields in form -->
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Document Controller" groups="dms_enterprise_features.group_dms_document_controller">
                    <group>
                        <field name="document_number"/>
                        <field name="department_id"/>
                        <field name="document_owner_id"/>
                    </group>
                    <group>
                        <field name="confidentiality"/>
                        <field name="expiry_date"/>
                        <field name="workflow_id"/>
                        <field name="signature_needed"/>
                    </group>
                </group>
            </xpath>
            
            <xpath expr="//sheet" position="inside">
                <notebook groups="dms_enterprise_features.group_dms_document_controller">
                    <page string="Revisions" name="revisions">
                        <field name="revision_ids" context="{'default_file_id': id}"/>
                    </page>
                    <page string="Access Control" name="access_control" groups="dms_enterprise_features.group_dms_document_controller">
                        <field name="access_ids"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Standalone Tree view for Revisions -->
    <record id="view_dms_file_revision_tree" model="ir.ui.view">
        <field name="name">dms.file.revision.tree</field>
        <field name="model">dms.file.revision</field>
        <field name="arch" type="xml">
            <list>
                <field name="version"/>
                <field name="upload_date"/>
                <field name="uploader_id"/>
                <field name="comments"/>
            </list>
        </field>
    </record>

    <!-- Standalone Tree view for Access -->
    <record id="view_dms_file_access_tree" model="ir.ui.view">
        <field name="name">dms.file.access.tree</field>
        <field name="model">dms.file.access</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
                <field name="perm_unlink"/>
            </list>
        </field>
    </record>

    <record id="view_dms_file_revision_form" model="ir.ui.view">
        <field name="name">dms.file.revision.form</field>
        <field name="model">dms.file.revision</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="version"/>
                            <field name="content" filename="file_name"/>
                            <field name="file_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="uploader_id"/>
                            <field name="upload_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="comments"/>
                    </group>
                    <notebook>
                        <page string="Approval History" name="approvals">
                            <field name="approval_history_ids" readonly="1">
                                <list>
                                    <field name="approver_id"/>
                                    <field name="status"/>
                                    <field name="date"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature Requests" name="signatures">
                            <field name="signature_request_ids" context="{'default_revision_id': id}">
                                <list>
                                    <field name="recipient_id"/>
                                    <field name="state"/>
                                    <field name="signed_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_dms_file_tree_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.tree.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="document_number" optional="show" groups="dms_enterprise_features.group_dms_document_controller"/>
                <field name="status" optional="show" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'in_approval'" decoration-success="status == 'approved'" decoration-muted="status == 'obsolete'" decoration-danger="status == 'rejected'" groups="dms_enterprise_features.group_dms_document_controller"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_dms_file_kanban_inherit_document_controller" model="ir.ui.view">
        <field name="name">dms.file.kanban.inherit.document.controller</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'in_approval'" decoration-success="status == 'approved'" decoration-muted="status == 'obsolete'" decoration-danger="status == 'rejected'" groups="dms_enterprise_features.group_dms_document_controller"/>
            </xpath>
        </field>
    </record>
</odoo>
