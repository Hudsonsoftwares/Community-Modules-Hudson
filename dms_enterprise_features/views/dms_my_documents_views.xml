<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Documents Action -->
    <record id="action_dms_my_documents" model="ir.actions.act_window">
        <field name="name">My Documents</field>
        <field name="res_model">dms.file</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents found.
            </p>
            <p>
                Documents assigned to you or owned by you will appear here.
            </p>
        </field>
    </record>

    <!-- My Signature Requests Action -->
    <record id="action_dms_my_signature_requests" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">dms.file.signature.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('recipient_id', '=', uid)]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('dms_enterprise_features.view_dms_signature_request_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dms_enterprise_features.view_dms_signature_request_form')})
        ]"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_dms_my_documents_root" 
              name="Documents" 
              parent="dms.main_menu_dms" 
              sequence="5"/>

    <menuitem id="menu_dms_my_documents" 
              name="My Documents" 
              action="action_dms_my_documents" 
              parent="menu_dms_my_documents_root" 
              sequence="10"/>

    <menuitem id="menu_dms_my_signature_requests" 
              name="Signature Requests" 
              action="action_dms_my_signature_requests" 
              parent="menu_dms_my_documents_root" 
              sequence="20"/>
</odoo>
