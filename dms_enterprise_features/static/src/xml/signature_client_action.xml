<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dms_enterprise_features.SignatureClientAction" owl="1">
        <div class="o_action o_dms_sign_action h-100 w-100 d-flex flex-column" t-on-click="this.onActionClick">
            <!-- Unified Single Top Navigation Bar -->
            <div class="o_dms_sign_header d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-white shadow-sm flex-shrink-0" style="min-height: 56px; z-index: 100;">
                <!-- Left: Back Button & Document Name -->
                <div class="d-flex align-items-center" style="min-width: 260px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-3 shadow-sm d-flex align-items-center gap-1.5 px-3 py-1.5 rounded" t-on-click="this.onBack">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        <span class="fw-semibold">Back</span>
                    </button>
                    <div class="d-flex align-items-center" t-if="this.state.currentDocument">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 flex-shrink-0">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span class="fs-6 fw-bold o_dms_sign_docname text-truncate" style="max-width: 300px;" t-esc="this.state.currentDocument.name"/>
                    </div>
                </div>

                <!-- Center: Clean Zoom Controls & Page Info -->
                <div class="d-flex align-items-center gap-2 mx-auto">
                    <div class="d-flex align-items-center bg-white border rounded px-1 py-0.5 shadow-sm">
                        <button type="button" class="btn btn-xs btn-link text-secondary p-1 d-flex align-items-center text-decoration-none" t-on-click="() => this.zoomOut()" title="Zoom Out">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                        <div class="d-flex align-items-center px-1">
                            <input type="number" class="form-control form-control-sm text-center border-0 bg-transparent p-0 fw-bold text-dark" 
                                   style="width: 38px; font-size: 12px; box-shadow: none;"
                                   t-att-value="this.state.zoomLevel" 
                                   t-on-change="this.onZoomChange" 
                                   min="30" max="300" />
                            <span class="text-muted fw-semibold" style="font-size: 11px;">%</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-link text-secondary p-1 d-flex align-items-center text-decoration-none" t-on-click="() => this.zoomIn()" title="Zoom In">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                        <div class="vr my-1 mx-1 text-muted opacity-50"></div>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 fw-semibold border-0" style="font-size: 11px;" t-on-click="() => this.setZoom(100)" title="Reset Zoom">
                            100%
                        </button>
                    </div>
                    <span class="badge bg-white text-muted border shadow-sm px-2 py-1.5 d-flex align-items-center gap-1.5" t-if="this.state.pages.length" style="font-size: 11px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <span><t t-esc="this.state.pages.length"/> Page<t t-if="this.state.pages.length > 1">s</t></span>
                    </span>
                </div>

                <!-- Right: Action Buttons (Send & Sign Now) -->
                <div class="d-flex align-items-center gap-2" style="min-width: 260px; justify-content: flex-end;">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-3 py-1.5 shadow-sm d-flex align-items-center gap-2 rounded" t-on-click="() => this.openSendModal(false)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        <span>Send</span>
                    </button>
                    <button type="button" class="btn text-white fw-semibold px-3 py-1.5 shadow-sm d-flex align-items-center gap-2 rounded" style="background:#714B67; border-color:#714B67;" t-on-click="() => this.openSendModal(true)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Sign Now</span>
                    </button>
                </div>
            </div>

            <!-- Hidden File Input for Document Upload (sidebar '+ Add' button) -->
            <input type="file" t-ref="this.docUploadInputRef" class="d-none" accept="application/pdf" t-on-change="this.onDocumentUpload" />

            <!-- Main Content Area -->
            <div class="d-flex flex-grow-1 overflow-hidden">
                <!-- Left Sidebar -->
                <div class="o_dms_sign_sidebar border-end d-flex flex-column overflow-auto" style="width: 260px; flex-shrink: 0;">
                    <!-- Documents List -->
                    <div class="p-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <strong class="small text-uppercase text-muted fw-bold">Documents</strong>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" t-on-click="this.onAddDocument">+ Add</button>
                        </div>
                        <t t-foreach="this.state.documents" t-as="doc" t-key="doc.id">
                            <div t-attf-class="o_dms_sign_doc_item p-2 rounded mb-1 cursor-pointer d-flex align-items-center justify-content-between {{ this.state.currentDocIndex === doc_index ? 'active' : '' }}" 
                                 t-on-click="() => this.selectDocument(doc_index)">
                                <div class="d-flex align-items-center text-truncate me-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 flex-shrink-0">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                    <span class="small fw-semibold text-truncate" t-esc="doc.name"/>
                                </div>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#198754" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" t-if="this.state.currentDocIndex === doc_index">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                        </t>
                    </div>

                    <!-- Signers List -->
                    <div class="p-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <strong class="small text-uppercase text-muted fw-bold">Signers</strong>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" t-on-click="this.onAddRole">+ Add</button>
                        </div>
                        <t t-foreach="this.state.roles" t-as="role" t-key="role.id">
                            <div t-attf-class="o_dms_sign_role_item p-2 rounded mb-1 cursor-pointer d-flex align-items-center justify-content-between position-relative {{ this.state.currentRoleIndex === role_index ? 'active' : '' }}" 
                                 t-attf-style="{{ this.state.currentRoleIndex === role_index ? 'background-color: ' + role.color + ' !important; border: 1px solid ' + role.borderColor + ' !important;' : '' }}"
                                 t-on-click="() => this.selectRole(role_index)">
                                <div class="d-flex align-items-center text-truncate me-2">
                                    <span class="o_dms_role_dot me-2 flex-shrink-0" t-attf-style="background-color: {{ role.color }}; border: 2px solid {{ role.borderColor }};"></span>
                                    <span class="small fw-semibold text-truncate" t-attf-style="{{ this.state.currentRoleIndex === role_index ? 'color: ' + role.textColor + ' !important;' : '' }}"><t t-esc="role.name"/></span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge rounded-pill border small" t-attf-style="background-color: {{ role.color }}; border-color: {{ role.borderColor }} !important; color: {{ role.textColor }}; font-size: 11px;">
                                        <t t-esc="this.getRoleBoxCount(role.id)"/>
                                    </span>
                                    <!-- Visible 3-dots Menu Button -->
                                    <div class="position-relative" t-on-click.stop="">
                                        <button type="button" class="btn btn-sm p-1 text-muted d-flex align-items-center justify-content-center o_signer_menu_toggle"
                                                style="width: 24px; height: 24px; border-radius: 4px; background: rgba(0,0,0,0.05);"
                                                t-on-click.stop="() => this.toggleRoleDropdown(role.id)"
                                                title="Signer Options">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                <circle cx="12" cy="5" r="2.2"></circle>
                                                <circle cx="12" cy="12" r="2.2"></circle>
                                                <circle cx="12" cy="19" r="2.2"></circle>
                                            </svg>
                                        </button>
                                        <div t-if="this.state.openDropdownRoleId === role.id" 
                                             class="position-absolute end-0 bg-white shadow-lg rounded border py-1 o_signer_dropdown_menu" 
                                             style="min-width: 130px; z-index: 1060; top: 100%; margin-top: 4px;">
                                            <button type="button" class="dropdown-item small px-3 py-1.5 d-flex align-items-center gap-2 text-dark" 
                                                    t-on-click.stop="() => this.editRoleAndClose(role.id)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 20h9"></path>
                                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                </svg>
                                                <span>Edit</span>
                                            </button>
                                            <button t-if="this.state.roles.length > 1" 
                                                    type="button" class="dropdown-item small px-3 py-1.5 d-flex align-items-center gap-2 text-danger" 
                                                    t-on-click.stop="() => this.deleteRoleAndClose(role.id)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                </svg>
                                                <span>Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Tool Palette -->
                    <div class="p-2 flex-grow-1 o_dms_sign_palette">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <span class="small text-uppercase text-muted fw-bold">Fields</span>
                            <span class="badge rounded-pill text-truncate" t-attf-style="background-color: {{ this.currentRole.color }}; color: {{ this.currentRole.textColor }}; border: 1px solid {{ this.currentRole.borderColor }}; font-size: 10px; max-width: 110px;">
                                <t t-esc="this.currentRole.name"/>
                            </span>
                        </div>
                        <div class="row g-2">
                            <t t-foreach="this.state.tools" t-as="tool" t-key="tool.type">
                                <div t-attf-class="{{ tool.span ? 'col-12' : 'col-6' }}">
                                    <div class="o_dms_tool_btn btn btn-sm w-100 text-start d-flex align-items-center p-2 rounded" 
                                         t-attf-style="background-color: {{ this.currentRole.color }} !important; border: 1px solid {{ this.currentRole.borderColor }} !important; color: {{ this.currentRole.textColor }} !important; cursor: grab;"
                                         t-on-mousedown="(e) => this.startDrag(e, tool.type)">
                                        <i t-attf-class="fa {{ tool.icon }} me-2 fa-fw" t-attf-style="color: {{ this.currentRole.borderColor }} !important;"></i>
                                        <span class="small fw-semibold text-truncate"><t t-esc="tool.label"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- PDF Viewer Viewport -->
                <div class="o_dms_sign_viewport flex-grow-1 position-relative overflow-auto d-flex flex-column align-items-center p-4" t-on-click="this.onViewportClick" t-on-pointerdown="this.onViewportClick">
                    <!-- Loading state -->
                    <div t-if="this.state.isLoading" class="d-flex flex-column align-items-center justify-content-center my-auto p-5">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                        <h6 class="text-muted fw-normal">Loading PDF preview...</h6>
                    </div>

                    <!-- Error state -->
                    <div t-elif="this.state.errorMessage" class="d-flex flex-column align-items-center justify-content-center my-auto p-5 text-center" style="max-width: 480px;">
                        <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                        <h5 class="fw-bold mb-2">Unable to Preview PDF</h5>
                        <p class="text-muted small mb-3"><t t-esc="this.state.errorMessage"/></p>
                        <button class="btn btn-sm btn-primary" t-on-click="() => this.selectDocument(this.state.currentDocIndex)">
                            <i class="fa fa-refresh me-1"></i>Retry Loading
                        </button>
                    </div>

                    <!-- Pages Container -->
                    <t t-else="">
                        <t t-foreach="this.state.pages" t-as="page" t-key="page.num">
                            <div class="pdf-page o_dms_pdf_page position-relative bg-white mb-4" 
                                 t-att-data-page-num="page.num"
                                 t-attf-style="width: {{ page.width }}px; height: {{ page.height }}px;">
                                
                                <canvas t-att-id="'pdf-canvas-' + page.num" style="display: block; width: 100%; height: 100%;"></canvas>
                                
                                <!-- Render Boxes for Current Page -->
                                <t t-foreach="this.getCurrentBoxes(page.num)" t-as="box" t-key="box.id">
                                    <div class="position-absolute d-flex align-items-center justify-content-center signature-box shadow-sm" 
                                         t-attf-style="left: {{ box.x }}px; top: {{ box.y }}px; width: {{ box.width }}px; height: {{ box.height }}px; border: 2px dashed {{ this.getRoleBorderColor(box.roleId) }}; background-color: {{ this.getRoleColor(box.roleId) }}; color: {{ this.getRoleTextColor(box.roleId) }}; cursor: move; user-select: none;"
                                         t-on-mousedown="(e) => this.startBoxDrag(e, box)">
                                        
                                        <!-- Role badge indicator if multiple roles -->
                                        <t t-if="this.state.roles.length > 1">
                                            <span class="position-absolute badge rounded-pill px-1 text-white shadow-sm"
                                                  t-attf-style="{{ box.width &lt; 60 ? 'top: -16px; left: 0;' : 'top: -8px; left: 4px;' }} font-size: 9px; background-color: {{ this.getRoleBorderColor(box.roleId) }}; pointer-events: none; line-height: 1.1; white-space: nowrap; z-index: 10;">
                                                <t t-esc="this.getRole(box.roleId).name"/>
                                            </span>
                                        </t>

                                        <!-- Box Content -->
                                        <t t-if="box.type === 'checkbox' || box.type === 'radio'">
                                            <div class="d-flex align-items-center justify-content-center w-100 h-100">
                                                <t t-if="box.type === 'radio'">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" t-att-stroke="this.getRoleBorderColor(box.roleId)" stroke-width="2">
                                                        <circle cx="12" cy="12" r="9.5"></circle>
                                                        <circle cx="12" cy="12" r="4.5" t-att-fill="this.getRoleBorderColor(box.roleId)"></circle>
                                                    </svg>
                                                </t>
                                                <t t-else="">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" t-att-stroke="this.getRoleBorderColor(box.roleId)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
                                                        <polyline points="8 12 11 15 16 9"></polyline>
                                                    </svg>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="w-100 h-100 d-flex flex-column justify-content-center overflow-hidden px-1" t-attf-style="text-align: {{ box.alignment || 'left' }};">
                                                <div t-if="box.type !== 'signature' and box.type !== 'initials'" t-attf-style="color: {{ this.getRoleTextColor(box.roleId) }}; font-size: 13px; font-weight: 500; white-space: pre-wrap;"><t t-esc="box.placeholder || this.getToolLabel(box.type)"/></div>
                                                <div t-else="" class="d-flex align-items-center justify-content-center w-100 h-100">
                                                    <i t-attf-class="fa {{ this.getToolIcon(box.type) }} me-2" t-attf-style="font-size: 15px; color: {{ this.getRoleBorderColor(box.roleId) }};"></i>
                                                    <span t-attf-style="font-size: 13px; font-weight: bold; color: {{ this.getRoleTextColor(box.roleId) }};"><t t-esc="this.getToolLabel(box.type)"/></span>
                                                </div>
                                            </div>
                                        </t>
                                        
                                        <!-- Delete Handle -->
                                        <div class="position-absolute bg-danger text-white rounded-circle d-flex align-items-center justify-content-center delete-box-btn shadow"
                                             style="top: -8px; right: -8px; width: 20px; height: 20px; cursor: pointer; z-index: 20;"
                                             t-on-click.stop="() => this.deleteBox(box.id)"
                                             title="Remove Field">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display: block;">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </div>
                                        
                                        <!-- Resize Handle -->
                                        <div class="position-absolute resize-box-handle"
                                             t-attf-style="bottom: -2px; right: -2px; width: 10px; height: 10px; cursor: nwse-resize; background-color: {{ this.getRoleBorderColor(box.roleId) }};"
                                             t-on-mousedown.stop="(e) => this.startBoxResize(e, box)">
                                        </div>
                                        
                                        <!-- Properties Popover -->
                                        <t t-if="this.state.editingBoxId === box.id">
                                            <div class="position-absolute bg-white shadow-lg rounded border o_dms_box_popover" style="left: 105%; top: 0; min-width: 250px; z-index: 1050; cursor: default;" t-on-mousedown.stop="(e) => {}" t-on-pointerdown.stop="(e) => {}" t-on-click.stop="(e) => {}">
                                                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-bottom rounded-top">
                                                    <strong class="mb-0 text-dark small"><t t-esc="this.getToolLabel(box.type)"/></strong>
                                                    <button type="button" class="btn btn-sm btn-link p-0 text-muted" t-on-click.stop="() => this.closePopover()" style="line-height: 1; text-decoration: none;" title="Close">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </button>
                                                </div>
                                                <div class="p-3">
                                                    <!-- Options (Radio) -->
                                                    <t t-if="box.type === 'radio'">
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small mb-1">Options</label>
                                                            <input type="number" class="form-control form-control-sm border-0 border-bottom rounded-0 px-0" 
                                                                   t-att-value="this.getRadioGroupCount(box.radioGroupName)" 
                                                                   t-on-change="(e) => this.updateRadioGroupCount(box.radioGroupName, e.target.value)" 
                                                                   min="1" max="20" />
                                                        </div>
                                                    </t>
                                                    
                                                    <!-- Placeholder (Text fields) -->
                                                    <t t-if="['text', 'name', 'email', 'phone', 'company', 'date', 'stamp', 'multiline'].includes(box.type)">
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small mb-1">Placeholder</label>
                                                            <t t-if="box.type === 'multiline' || box.type === 'stamp'">
                                                                <textarea class="form-control form-control-sm" rows="3" t-model.proxy="box.placeholder"></textarea>
                                                            </t>
                                                            <t t-else="">
                                                                <input type="text" class="form-control form-control-sm" t-model.proxy="box.placeholder" />
                                                            </t>
                                                        </div>
                                                    </t>
                                                    
                                                    <!-- Alignment -->
                                                    <t t-if="['text', 'name', 'email', 'phone', 'company', 'date', 'stamp', 'multiline'].includes(box.type)">
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small mb-1 d-block">Alignment</label>
                                                            <div class="btn-group w-100" role="group">
                                                                <button type="button" t-attf-class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center py-1 {{ box.alignment === 'left' ? 'active' : '' }}" t-on-click="() => box.alignment = 'left'" title="Align Left">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <line x1="17" y1="10" x2="3" y2="10"></line>
                                                                        <line x1="21" y1="6" x2="3" y2="6"></line>
                                                                        <line x1="21" y1="14" x2="3" y2="14"></line>
                                                                        <line x1="17" y1="18" x2="3" y2="18"></line>
                                                                    </svg>
                                                                </button>
                                                                <button type="button" t-attf-class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center py-1 {{ box.alignment === 'center' ? 'active' : '' }}" t-on-click="() => box.alignment = 'center'" title="Align Center">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <line x1="18" y1="10" x2="6" y2="10"></line>
                                                                        <line x1="21" y1="6" x2="3" y2="6"></line>
                                                                        <line x1="21" y1="14" x2="3" y2="14"></line>
                                                                        <line x1="18" y1="18" x2="6" y2="18"></line>
                                                                    </svg>
                                                                </button>
                                                                <button type="button" t-attf-class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center py-1 {{ box.alignment === 'right' ? 'active' : '' }}" t-on-click="() => box.alignment = 'right'" title="Align Right">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <line x1="21" y1="10" x2="7" y2="10"></line>
                                                                        <line x1="21" y1="6" x2="3" y2="6"></line>
                                                                        <line x1="21" y1="14" x2="3" y2="14"></line>
                                                                        <line x1="21" y1="18" x2="7" y2="18"></line>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    
                                                    <!-- Checkboxes -->
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input" type="checkbox" t-model.proxy="box.mandatory" t-att-id="'mand_' + box.id" t-on-change="(e) => box.type === 'radio' ? this.updateRadioGroupMandatory(box.radioGroupName, e.target.checked) : null" />
                                                        <label class="form-check-label small" t-att-for="'mand_' + box.id">Mandatory field</label>
                                                    </div>
                                                    <div class="form-check mb-3" t-if="!['signature', 'initials'].includes(box.type)">
                                                        <input class="form-check-input" type="checkbox" t-model.proxy="box.readonly" t-att-id="'ro_' + box.id" />
                                                        <label class="form-check-label small" t-att-for="'ro_' + box.id">Read-only</label>
                                                    </div>
                                                    
                                                    <!-- Actions -->
                                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                                        <button class="btn btn-sm btn-primary px-3" t-on-click.stop="() => this.closePopover()">Save</button>
                                                        <div class="d-flex gap-2">
                                                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center px-2 py-1" t-on-click.stop="() => this.duplicateBox(box.id)" title="Duplicate">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                                                </svg>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center px-2 py-1" t-on-click.stop="() => this.deleteBox(box.id)" title="Delete">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
            
            <!-- Ghost element for dragging tools from sidebar -->
            <div t-if="this.state.dragType" class="position-fixed" 
                 t-attf-style="left: {{ this.state.mouseX + 10 }}px; top: {{ this.state.mouseY + 10 }}px; opacity: 0.9; pointer-events: none; z-index: 99999;">
                <div class="btn btn-sm shadow-lg d-flex align-items-center px-3 py-2 rounded"
                     t-attf-style="background-color: {{ this.currentRole.color }}; border: 2px solid {{ this.currentRole.borderColor }}; color: {{ this.currentRole.textColor }};">
                    <i t-attf-class="fa {{ this.getToolIcon(this.state.dragType) }} me-2" t-attf-style="color: {{ this.currentRole.borderColor }};"></i>
                    <span class="small fw-bold"><t t-esc="this.getToolLabel(this.state.dragType)"/></span>
                    <span class="badge ms-2" t-attf-style="background-color: {{ this.currentRole.borderColor }}; color: #ffffff; font-size: 10px;">
                        <t t-esc="this.currentRole.name"/>
                    </span>
                </div>
            </div>
        </div>
    </t>

    <t t-name="dms_enterprise_features.SignerSettingsDialog" owl="1">
        <Dialog title="'Signer Settings'">
            <div class="d-flex flex-column">
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-4 col-form-label fw-bold">Name</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" t-model.proxy="this.state.name" />
                    </div>
                </div>
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-4 col-form-label fw-bold">Color Theme</label>
                    <div class="col-sm-8 d-flex gap-2 align-items-center flex-wrap">
                        <t t-foreach="this.palette" t-as="p" t-key="p.color">
                            <span class="rounded-circle" 
                                  t-attf-style="width: 24px; height: 24px; background-color: {{ p.color }}; border: 2px solid {{ p.borderColor }}; box-shadow: {{ this.state.color === p.color ? '0 0 0 2px #000' : 'none' }}; cursor: pointer;"
                                  t-on-click="() => this.selectPalette(p)"></span>
                        </t>
                    </div>
                </div>
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-4 col-form-label fw-bold">Extra Authentication Step <i class="fa fa-question-circle text-info"></i></label>
                    <div class="col-sm-8">
                        <select class="form-select border-0 border-bottom rounded-0 px-0 text-muted" t-model.proxy="this.state.authMethod">
                            <option value="none">None</option>
                            <option value="email">By Email</option>
                            <option value="sms">By SMS</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-4 col-form-label fw-bold">Can delegate <i class="fa fa-question-circle text-info"></i></label>
                    <div class="col-sm-8">
                        <input type="checkbox" class="form-check-input" t-model.proxy="this.state.canDelegate" />
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn text-white px-4" style="background:#714B67;" t-on-click="this.onConfirm">Save</button>
                <button class="btn btn-light px-4 border" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>

    <t t-name="dms_enterprise_features.SignatureSendDialog" owl="1">
        <Dialog title="this.props.title">
            <div class="d-flex flex-column" style="min-width: 600px;">
                <!-- Roles Section -->
                <div class="mb-4">
                    <div class="row w-100 mb-2">
                        <div class="col-6">
                            <t t-foreach="this.props.rolesWithFields" t-as="roleId" t-key="roleId">
                                <t t-set="role" t-value="this.props.roles.find(r => r.id === roleId)"/>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="fw-bold me-3" style="width: 100px; display: flex; align-items: center;">
                                        <span t-if="this.state.signingOrder" class="me-2 text-muted" style="border-bottom: 1px solid #ccc; width: 16px; text-align: center;"><t t-esc="roleId_index + 1"/></span>
                                        <span t-if="!this.state.signingOrder" class="me-2" style="width: 16px;"></span>
                                        <t t-esc="role.name"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <input type="text" class="form-control border-0 border-bottom rounded-0 px-0" placeholder="Type a name or email..." t-on-change="(e) => this.onUserChange(roleId, e.target.value)" />
                                    </div>
                                </div>
                            </t>
                            <t t-if="!this.props.isSignNow and this.props.rolesWithFields.length > 1">
                                <div class="d-flex align-items-center mt-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" t-model.proxy="this.state.signingOrder" id="signingOrderSwitch"/>
                                        <label class="form-check-label fw-bold" for="signingOrderSwitch">Signing Order <i class="fa fa-question-circle text-info"></i></label>
                                    </div>
                                </div>
                            </t>
                        </div>
                        
                        <div class="col-6">
                            <t t-if="!this.props.isSignNow">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="fw-bold me-3" style="width: 100px;">Valid Until <i class="fa fa-question-circle text-info"></i></div>
                                    <div class="flex-grow-1">
                                        <input type="date" class="form-control border-0 border-bottom rounded-0 px-0" t-model.proxy="this.state.validUntil" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="remindersCheck" t-model.proxy="this.state.reminders" />
                                        <label class="form-check-label" for="remindersCheck">Reminders</label>
                                    </div>
                                    <div t-if="this.state.reminders" class="d-flex align-items-center mt-2 ms-4">
                                        <span class="text-muted me-2">Remind every</span>
                                        <input type="number" class="form-control form-control-sm text-center px-1 py-0 mx-1 border-0 border-bottom rounded-0" t-model.proxy="this.state.reminderDays" style="width: 40px; background: transparent;"/>
                                        <span class="text-muted">days</span>
                                    </div>
                                </div>
                            </t>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="hideCertCheck" t-model.proxy="this.state.hideCertificateKey" />
                                <label class="form-check-label" for="hideCertCheck">Hide certificate key on pages <i class="fa fa-question-circle text-info"></i></label>
                            </div>
                        </div>
                    </div>
                </div>
                
                <hr class="my-3"/>
                
                <!-- Email Section -->
                <div class="mb-3 d-flex align-items-center">
                    <label class="fw-bold me-3" style="width: 80px;">Subject</label>
                    <input type="text" class="form-control border-0 px-0" t-model.proxy="this.state.subject" />
                </div>
                
                <div class="mb-3 d-flex align-items-center">
                    <label class="fw-bold me-3" style="width: 80px;">CC <i class="fa fa-question-circle text-info"></i></label>
                    <input type="text" class="form-control border-0 px-0 text-muted" t-model.proxy="this.state.cc" placeholder="Write email or search contact..." />
                </div>
                
                <div class="mb-3">
                    <textarea class="form-control border-0 px-0 text-muted" t-model.proxy="this.state.message" rows="4" placeholder="Enter your message"></textarea>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn text-white px-4" style="background:#714B67;" t-on-click="this.onConfirm"><t t-esc="this.props.isSignNow ? 'Sign Now' : 'Send'"/></button>
                <button class="btn btn-light px-4 border" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
