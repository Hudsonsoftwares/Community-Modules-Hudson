<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="dms.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//tbody" position="inside">
            <style t-if="dmsDirectoriesState.data.length">
                .o_view_nocontent {
                    display: none !important;
                }
            </style>
            <!-- Go Up Row -->
            <tr t-if="dmsDirectoriesState.currentDir" class="o_data_row cursor-pointer text-muted bg-light" t-on-click="() => this.navigateUp()">
                <td t-if="hasSelectors" class="o_list_record_selector" tabindex="-1"></td>
                <td class="o_data_cell" colspan="100%">
                    <i class="fa fa-level-up fa-lg me-3 text-secondary"/>
                    <span class="fw-bold">.. Go to <t t-esc="dmsDirectoriesState.currentDir.name"/></span>
                </td>
            </tr>
            <!-- Directory Rows -->
            <t t-foreach="dmsDirectoriesState.data" t-as="directory" t-key="'dir_' + directory.id">
                <tr class="o_data_row cursor-pointer text-muted" t-on-click="() => this.openDirectory(directory.id)">
                    <td t-if="hasSelectors" class="o_list_record_selector" tabindex="-1">
                        <div class="form-check o_checkbox">
                            <input type="checkbox" class="form-check-input" t-on-click.stop="() => {}" />
                        </div>
                    </td>
                    <t t-foreach="this.columns || state.columns" t-as="column" t-key="column.id">
                        <td class="o_data_cell">
                            <t t-if="column.name === 'name'">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-folder text-warning me-3" style="font-size: 1.2em;"/>
                                    <span class="fw-bold text-dark" t-esc="directory.display_name || directory.name || 'Untitled Folder'"/>
                                </div>
                            </t>
                            <t t-elif="column.name === 'directory_id'">
                                <span t-if="dmsDirectoriesState.currentDir" t-esc="dmsDirectoriesState.currentDir.name"/>
                            </t>
                            <t t-else="">
                                <span/>
                            </t>
                        </td>
                    </t>
                </tr>
            </t>
        </xpath>
    </t>
</templates>
