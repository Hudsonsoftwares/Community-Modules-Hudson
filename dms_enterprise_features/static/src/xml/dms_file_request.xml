<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Kanban "New" menu: Upload / Folder / Request / Link -->
    <t t-inherit="dms.KanbanButtons" t-inherit-mode="extension">
        <xpath expr="//a[@t-on-click.prevent='this.uploadDocument']" position="replace">
            <a class="dropdown-item cursor-pointer" t-on-click.prevent="this.uploadDocument">
                <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>Upload
            </a>
        </xpath>
        <xpath expr="//a[@t-on-click.prevent='this.createDirectory']" position="replace">
            <a class="dropdown-item cursor-pointer" t-on-click.prevent="() => this.createDirectory()">
                <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Folder
            </a>
        </xpath>
        <xpath expr="//ul[hasclass('dropdown-menu')]" position="inside">
            <li>
                <a class="dropdown-item cursor-pointer o_dms_new_request" t-on-click.prevent="() => this.requestDocument()">
                    <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="M14 3v5h5"/><path d="M19 8v3"/><path d="M17 15h4"/><path d="M19 13v4"/></svg>Request
                </a>
            </li>
            <li>
                <a class="dropdown-item cursor-pointer o_dms_new_link" t-on-click.prevent="() => this.addDocumentUrl()">
                    <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>Link
                </a>
            </li>
        </xpath>
    </t>

    <!-- List view: same two actions next to Upload -->
    <t t-inherit="dms.ListButtons" t-inherit-mode="extension">
        <xpath expr="//input[@name='ufile']" position="before">
            <t t-if="this.canCreate">
                <button type="button" class="btn btn-secondary mx-1 o_dms_new_request" t-on-click.prevent="() => this.requestDocument()">
                    <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="M14 3v5h5"/><path d="M19 8v3"/><path d="M17 15h4"/><path d="M19 13v4"/></svg>Request
                </button>
                <button type="button" class="btn btn-secondary mx-1 o_dms_new_link" t-on-click.prevent="() => this.addDocumentUrl()">
                    <svg class="o_dms_icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>Link
                </button>
            </t>
        </xpath>
    </t>

</templates>
