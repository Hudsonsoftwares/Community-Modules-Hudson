<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Delete old restrictive rules that caused files to disappear -->
        <delete model="ir.rule" id="dms_enterprise_features.dms_file_explicit_access_read"/>
        <delete model="ir.rule" id="dms_enterprise_features.dms_file_explicit_access_write"/>
        <delete model="ir.rule" id="dms_enterprise_features.dms_file_explicit_access_unlink"/>

        <!-- Override Base DMS rules to make them non-global -->
        <record id="dms.rule_file_computed_create" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_file_computed_read" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_file_computed_write" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_file_computed_unlink" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>

        <!-- Admin Bypass Rule (Administrators see everything) -->
        <record id="dms_file_manager_bypass" model="ir.rule">
            <field name="name">DMS File Manager Bypass</field>
            <field name="model_id" ref="dms.model_dms_file"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dms.group_dms_manager'))]"/>
        </record>

        <!-- Directory rules override -->
        <record id="dms.rule_directory_computed_create" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_directory_computed_read" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_directory_computed_write" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        <record id="dms.rule_directory_computed_unlink" model="ir.rule">
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
        </record>
        
        <record id="dms_directory_manager_bypass" model="ir.rule">
            <field name="name">DMS Directory Manager Bypass</field>
            <field name="model_id" ref="dms.model_dms_directory"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dms.group_dms_manager'))]"/>
        </record>

        <!-- Global Rule to restrict access to Confidential / Restricted documents -->
        <record id="dms_file_confidentiality_rule" model="ir.rule">
            <field name="name">DMS File Confidentiality Rule</field>
            <field name="model_id" ref="dms.model_dms_file"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_user'))]"/>
            <field name="domain_force">
                ['|',
                 ('document_owner_id', '=', user.id), 
                 ('access_ids.user_id', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Portal users can only see documents they are assigned to or own -->
        <record id="dms_file_portal_visibility_rule" model="ir.rule">
            <field name="name">DMS File Portal Visibility</field>
            <field name="model_id" ref="dms.model_dms_file"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">
                ['|',
                 ('document_owner_id', '=', user.id), 
                 ('access_ids.user_id', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
