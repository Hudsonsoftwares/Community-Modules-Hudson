<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_file_request_wizard_form" model="ir.ui.view">
        <field name="name">dms.file.request.wizard.form</field>
        <field name="model">dms.file.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request a file">
                <div class="oe_title">
                    <label for="name"/>
                    <h1><field name="name" placeholder="e.g. Missing Expense"/></h1>
                </div>
                <group>
                    <group>
                        <field name="partner_id" options="{'no_quick_create': True}"
                               context="{'show_email': True}"/>
                        <label for="activity_date_deadline_range"/>
                        <div class="o_row">
                            <field name="activity_date_deadline_range"/>
                            <field name="activity_date_deadline_range_type"/>
                        </div>
                    </group>
                    <group>
                        <field name="directory_id" options="{'no_open': True, 'no_create': True}" domain="[('permission_create', '=', True)]"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                    </group>
                </group>
                <label for="message"/>
                <field name="message" placeholder="Extra comments..."/>
                <footer>
                    <button name="action_request" string="Request" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dms_file_url_wizard_form" model="ir.ui.view">
        <field name="name">dms.file.url.wizard.form</field>
        <field name="model">dms.file.url.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Url">
                <group>
                    <field name="url" widget="url" placeholder="e.g. https://www.youtube.com/watch?v=CP96yVnXNrY"/>
                    <field name="name" placeholder="Leave empty to use the page title"/>
                    <field name="directory_id" options="{'no_open': True, 'no_create': True}" domain="[('permission_create', '=', True)]"/>
                </group>
                <footer>
                    <button name="action_add" string="Add" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
