<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email layout for document requests: "Document Request:" + the
         requested name as header, company footer. -->
    <template id="mail_notification_dms_request">
<html t-att-lang="lang">
<head>
    <meta http-equiv="Content-Type" content="text/html charset=UTF-8" />
</head>
<body>
<t t-set="subtype_internal" t-value="False"/>
<t t-call="mail.notification_preview"/>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"><tr><td align="center">
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 24px; background-color: white; color: #454748; border-collapse:separate;">
<tbody>
    <tr>
        <td align="center" style="min-width: 590px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: white; padding: 0; border-collapse:separate;">
                <tr><td valign="middle">
                    <span style="font-size: 10px;">Document Request:</span>
                    <br/>
                    <span style="font-size: 20px; font-weight: bold;">
                        <t t-out="record_name or message.record_name or ''"/>
                    </span>
                </td><td valign="middle" align="right" t-if="company and not company.uses_default_logo">
                    <img t-att-src="'/logo.png?company=%s' % company.id" style="padding: 0px; margin: 0px; height: 48px;" t-att-alt="'%s' % company.name"/>
                </td></tr>
                <tr><td colspan="2" style="text-align:center;">
                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:4px 0px 24px 0px;"/>
                </td></tr>
            </table>
        </td>
    </tr>
    <tr>
        <td style="min-width: 590px;">
            <t t-out="message.body"/>
        </td>
    </tr>
    <tr>
        <td align="center" style="min-width: 590px; padding: 0 8px 0 8px; font-size:11px;">
            <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 4px 0px;"/>
            <b t-out="company.name" style="font-size:11px;"/><br/>
            <p style="color: #999999; margin-top:2px; font-size:11px;">
                <t t-out="company.phone"/>
                <t t-if="company.email and company.phone"> |</t>
                <a t-if="company.email" t-att-href="'mailto:%s' % company.email" style="text-decoration:none; color: #999999;" t-out="company.email"/>
                <t t-if="company.website and (company.phone or company.email)"> |</t>
                <a t-if="company.website" t-att-href="'%s' % company.website" style="text-decoration:none; color: #999999;" t-out="company.website"/>
            </p>
        </td>
    </tr>
</tbody>
</table>
</td></tr>
</table>
</body>
</html>
    </template>

    <data noupdate="1">
        <record id="mail_template_dms_file_request" model="mail.template">
            <field name="name">DMS: Document Request</field>
            <field name="model_id" ref="dms.model_dms_file"/>
            <field name="subject">Document Request: {{ object.name }}</field>
            <field name="email_from">{{ (object.requested_by_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.request_partner_id.id }}</field>
            <field name="description">Sent to the person a document is requested from, with a link to upload it.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.request_partner_id.name or ''">Marc</t>,
        <br/><br/>
        <t t-out="object.requested_by_id.name or user.name or ''">Mitchell Admin</t>
        <t t-if="object.requested_by_id.email or user.email">(<t t-out="object.requested_by_id.email or user.email or ''">admin@example.com</t>)</t>
        asks you to provide the following document:
    </p>
    <div style="margin: 16px 0px; text-align: center;">
        <strong t-out="object.name or ''">Missing Expense</strong>
        <t t-if="object.request_message">
            <br/><span style="color: #555555; white-space: pre-wrap;" t-out="object.request_message or ''">Extra comments</span>
        </t>
    </div>
    <div style="margin: 16px 0px 24px 0px; text-align: center;">
        <a t-att-href="object.request_upload_url"
           style="display: inline-block; background-color: #875A7B; padding: 20px 30px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;">
            Upload the requested document
        </a>
    </div>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <t t-if="object.request_date_deadline">
            Please provide us with the missing document before <t t-out="object.request_date_deadline or ''">2026-12-07</t>.
        </t>
        <t t-else="">Please provide us with the missing document at your earliest convenience.</t>
        <t t-if="object.requested_by_id.signature">
            <br/><br/>
            <t t-out="object.requested_by_id.signature or ''">--<br/>Mitchell Admin</t>
        </t>
    </p>
</div>
            </field>
            <field name="lang">{{ object.request_partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
