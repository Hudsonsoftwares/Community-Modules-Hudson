<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_article_move_wizard_form" model="ir.ui.view">
        <field name="name">knowledge.article.move.wizard.form</field>
        <field name="model">knowledge.article.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Move Article">
                <group>
                    <field name="article_id" readonly="1" options="{'no_open': True}"/>
                    <field name="target_parent_id" domain="[('id', '!=', article_id)]"/>
                    <field name="target_workspace_id" invisible="target_parent_id != False"/>
                    <field name="target_category_id" invisible="target_parent_id != False"/>
                </group>
                <p class="text-muted" invisible="target_parent_id == False">
                    The article will inherit the workspace and category of the selected parent article.
                </p>
                <footer>
                    <button name="action_move" string="Move" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_knowledge_article_move_wizard" model="ir.actions.act_window">
        <field name="name">Move Article</field>
        <field name="res_model">knowledge.article.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_article_id': active_id}</field>
    </record>
</odoo>
