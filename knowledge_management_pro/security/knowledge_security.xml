<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <record id="module_category_knowledge_management_pro" model="ir.module.category">
            <field name="name">Knowledge Management Pro</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_knowledge_management_pro" model="res.groups.privilege">
            <field name="name">Knowledge Management Pro</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_knowledge_management_pro"/>
        </record>

        <record id="group_knowledge_management_pro_user" model="res.groups">
            <field name="name">Knowledge User</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_knowledge_management_pro_editor" model="res.groups">
            <field name="name">Knowledge Editor</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
        </record>

        <record id="group_knowledge_management_pro_manager" model="res.groups">
            <field name="name">Knowledge Manager</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_editor'))]"/>
        </record>

        <record id="group_knowledge_management_pro_administrator" model="res.groups">
            <field name="name">Knowledge Administrator</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_manager'))]"/>
        </record>

    </data>
    <data noupdate="1">
        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('knowledge_management_pro.group_knowledge_management_pro_administrator'))]"/>
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('knowledge_management_pro.group_knowledge_management_pro_administrator'))]"/>
        </record>
    </data>
    <data noupdate="0">

        <record id="rule_knowledge_article_read_user" model="ir.rule">
            <field name="name">Knowledge Article Read User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), '|', '&amp;', ('is_private', '=', False), ('state', '=', 'published'), '|', ('share_ids.partner_ids', 'in', [user.partner_id.id]), ('share_ids.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_portal" model="ir.rule">
            <field name="name">Knowledge Article Portal Access</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['&amp;', ('state', '=', 'published'), '|', ('is_private', '=', False), ('share_ids.partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_write_portal" model="ir.rule">
            <field name="name">Knowledge Article Portal Write Access</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['&amp;', ('state', '=', 'published'), '&amp;', ('share_ids.partner_ids', 'in', [user.partner_id.id]), ('share_ids.access_level', '=', 'write')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_write_user" model="ir.rule">
            <field name="name">Knowledge Article Write User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), '&amp;', ('share_ids.access_level', '=', 'write'), '|', ('share_ids.partner_ids', 'in', [user.partner_id.id]), ('share_ids.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_unlink_user" model="ir.rule">
            <field name="name">Knowledge Article Unlink User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_knowledge_article_manager_all" model="ir.rule">
            <field name="name">Knowledge Article Manager All</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-Company Rules -->
        <record id="rule_knowledge_article_company" model="ir.rule">
            <field name="name">Knowledge Article Multi-Company</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_knowledge_workspace_company" model="ir.rule">
            <field name="name">Knowledge Workspace Multi-Company</field>
            <field name="model_id" ref="model_knowledge_management_workspace"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
