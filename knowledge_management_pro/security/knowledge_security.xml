<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <record id="privilege_knowledge_management_pro" model="res.groups.privilege">
            <field name="name">Knowledge Management Pro</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_knowledge_management_pro_user" model="res.groups">
            <field name="name">Knowledge User</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_knowledge_management_pro_editor" model="res.groups">
            <field name="name">Knowledge Editor</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
        </record>

        <record id="group_knowledge_management_pro_manager" model="res.groups">
            <field name="name">Knowledge Manager</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_editor'))]"/>
        </record>

        <record id="group_knowledge_management_pro_administrator" model="res.groups">
            <field name="name">Knowledge Administrator</field>
            <field name="privilege_id" ref="privilege_knowledge_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_knowledge_management_pro_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_knowledge_article_read_user" model="ir.rule">
            <field name="name">Knowledge Article Read User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('state', '=', 'published'), ('share_ids.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_write_user" model="ir.rule">
            <field name="name">Knowledge Article Write User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), '&amp;', ('share_ids.user_ids', 'in', user.id), ('share_ids.access_level', '=', 'write')]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_article_unlink_user" model="ir.rule">
            <field name="name">Knowledge Article Unlink User</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_knowledge_article_manager_all" model="ir.rule">
            <field name="name">Knowledge Article Manager All</field>
            <field name="model_id" ref="model_knowledge_management_article"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_knowledge_management_pro_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
