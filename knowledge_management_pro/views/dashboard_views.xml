<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="knowledge_management_pro_view_dashboard_pivot" model="ir.ui.view">
        <field name="name">knowledge.management.article.pivot</field>
        <field name="model">knowledge.management.article</field>
        <field name="arch" type="xml">
            <pivot string="Articles Analytics">
                <field name="workspace_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="knowledge_management_pro_view_dashboard_graph" model="ir.ui.view">
        <field name="name">knowledge.management.article.graph</field>
        <field name="model">knowledge.management.article</field>
        <field name="arch" type="xml">
            <graph string="Articles by State" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="knowledge_management_pro_action_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">knowledge.management.article</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <menuitem id="knowledge_management_pro_menu_dashboard"
              name="Dashboard"
              parent="knowledge_management_pro_menu_configuration"
              action="knowledge_management_pro_action_dashboard"
              sequence="50"/>

</odoo>
