<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="knowledge_management_pro_view_category_tree" model="ir.ui.view">
        <field name="name">knowledge.management.category.list</field>
        <field name="model">knowledge.management.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="knowledge_management_pro_view_category_form" model="ir.ui.view">
        <field name="name">knowledge.management.category.form</field>
        <field name="model">knowledge.management.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="knowledge_management_pro_action_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">knowledge.management.category</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>
