<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="knowledge_management_pro_view_article_tree" model="ir.ui.view">
        <field name="name">knowledge.management.article.list</field>
        <field name="model">knowledge.management.article</field>
        <field name="arch" type="xml">
            <list string="Articles">
                <field name="name"/>
                <field name="workspace_id"/>
                <field name="category_id"/>
                <field name="author_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="knowledge_management_pro_view_article_form" model="ir.ui.view">
        <field name="name">knowledge.management.article.form</field>
        <field name="model">knowledge.management.article</field>
        <field name="arch" type="xml">
            <form string="Article">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_publish" string="Publish" type="object" invisible="state not in ('draft', 'review')" class="oe_highlight"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state != 'published'"/>
                    <button name="%(action_knowledge_article_move_wizard)d" string="Move To" type="action" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" placeholder="📄" class="me-2 oe_inline" style="width: 1.5em;"/>
                            <field name="name" placeholder="Article Title" class="oe_inline"/>
                        </h1>
                    </div>
                    <div class="mb-3">
                        <field name="shared_partner_ids" widget="many2many_avatar" readonly="1" placeholder="Not shared yet"/>
                    </div>
                    <group>
                        <group>
                            <field name="workspace_id"/>
                            <field name="category_id"/>
                            <field name="parent_id"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="author_id"/>
                            <field name="is_private"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Settings">
                            <group>
                                <field name="expiration_date"/>
                                <field name="reviewer_id"/>
                            </group>
                        </page>
                        <page string="Sharing">
                            <field name="share_ids">
                                <list editable="bottom">
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="access_level"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="knowledge_management_pro_action_articles" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">knowledge.management.article</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="knowledge_management_pro_menu_articles_action"
              name="Articles"
              parent="knowledge_management_pro_menu_articles"
              action="knowledge_management_pro_action_articles"
              sequence="10"/>

</odoo>
