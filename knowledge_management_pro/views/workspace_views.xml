<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="knowledge_management_pro_view_workspace_tree" model="ir.ui.view">
        <field name="name">knowledge.management.workspace.list</field>
        <field name="model">knowledge.management.workspace</field>
        <field name="arch" type="xml">
            <list string="Workspaces">
                <field name="name"/>
                <field name="is_private"/>
            </list>
        </field>
    </record>

    <record id="knowledge_management_pro_view_workspace_form" model="ir.ui.view">
        <field name="name">knowledge.management.workspace.form</field>
        <field name="model">knowledge.management.workspace</field>
        <field name="arch" type="xml">
            <form string="Workspace">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Workspace Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="is_private"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="manager_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="knowledge_management_pro_action_workspaces" model="ir.actions.act_window">
        <field name="name">Workspaces</field>
        <field name="res_model">knowledge.management.workspace</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
