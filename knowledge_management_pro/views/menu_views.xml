<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Top Level Menu -->
    <menuitem id="knowledge_management_pro_menu_root"
              name="Knowledge"
              web_icon="knowledge_management_pro,static/description/icon.png"
              sequence="10"/>

    <record id="knowledge_management_pro_action_app" model="ir.actions.client">
        <field name="name">Knowledge</field>
        <field name="tag">knowledge_management_pro.app</field>
    </record>

    <menuitem id="knowledge_management_pro_menu_home"
              name="Home"
              parent="knowledge_management_pro_menu_root"
              action="knowledge_management_pro_action_app"
              sequence="10"/>

    <menuitem id="knowledge_management_pro_menu_articles"
              name="Articles"
              parent="knowledge_management_pro_menu_root"
              sequence="20"/>
              
    <menuitem id="knowledge_management_pro_menu_configuration"
              name="Configuration"
              parent="knowledge_management_pro_menu_root"
              sequence="100"
              active="False"
              groups="knowledge_management_pro.group_knowledge_management_pro_manager"/>

</odoo>
