<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="knowledge_management_pro_view_template_tree" model="ir.ui.view">
        <field name="name">knowledge.management.template.list</field>
        <field name="model">knowledge.management.template</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="knowledge_management_pro_view_template_form" model="ir.ui.view">
        <field name="name">knowledge.management.template.form</field>
        <field name="model">knowledge.management.template</field>
        <field name="arch" type="xml">
            <form string="Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="knowledge_management_pro_action_templates" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">knowledge.management.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="knowledge_management_pro_menu_templates"
              name="Templates"
              parent="knowledge_management_pro_menu_configuration"
              action="knowledge_management_pro_action_templates"
              sequence="40"/>

</odoo>
