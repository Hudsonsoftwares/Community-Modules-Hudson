<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="knowledge_management_pro_view_tag_tree" model="ir.ui.view">
        <field name="name">knowledge.management.tag.list</field>
        <field name="model">knowledge.management.tag</field>
        <field name="arch" type="xml">
            <list string="Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="knowledge_management_pro_view_tag_form" model="ir.ui.view">
        <field name="name">knowledge.management.tag.form</field>
        <field name="model">knowledge.management.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="knowledge_management_pro_action_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">knowledge.management.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="knowledge_management_pro_menu_tags"
              name="Tags"
              parent="knowledge_management_pro_menu_configuration"
              action="knowledge_management_pro_action_tags"
              sequence="30"
              active="True"/>

</odoo>
