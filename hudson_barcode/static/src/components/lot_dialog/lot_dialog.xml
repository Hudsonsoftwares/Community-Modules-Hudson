<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_barcode_scanner.LotDialog" owl="1">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
            <div class="bg-white rounded shadow-lg" style="width: 90%; max-width: 500px; color: #333;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <h5 class="mb-0 fw-bold">
                        <t t-if="props.product.tracking === 'serial'">Enter Serial Number</t>
                        <t t-else="">Enter Lot Number</t>
                    </h5>
                    <button class="btn border-0 text-dark shadow-none" t-on-click="props.onCancel">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <!-- Body -->
                <div class="p-4">
                    <div class="mb-3 text-muted small">
                        Product: <span class="fw-bold text-dark" t-out="props.product.display_name"/>
                    </div>
                    <div class="mb-3">
                        <label class="small mb-1 fw-bold text-muted">
                            <t t-if="props.product.tracking === 'serial'">Serial Number</t>
                            <t t-else="">Lot Number</t>
                        </label>
                        <input type="text" class="form-control shadow-none bg-transparent text-dark border-0 border-bottom border-secondary rounded-0 px-0" 
                            t-att-value="state.lotName" t-on-input="(e) => state.lotName = e.target.value" t-ref="lotInput" placeholder="Scan or type..." autofocus="1"/>
                    </div>
                </div>
                <!-- Footer -->
                <div class="p-3 d-flex gap-2">
                    <button class="btn text-white fw-bold shadow-none flex-grow-1" style="background-color: #017e84;" t-on-click="onApply">Apply</button>
                    <button class="btn btn-secondary fw-bold shadow-none" t-on-click="props.onCancel">Cancel</button>
                </div>
            </div>
        </div>
    </t>
</templates>
