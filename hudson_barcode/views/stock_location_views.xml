<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the barcode field to the location form view in Community Edition -->
    <record id="view_location_form_barcode_visible" model="ir.ui.view">
        <field name="name">stock.location.form.barcode</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='name']" position="before">
                <div class="oe_avatar" invisible="not barcode">
                    <field name="barcode_html" widget="html" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='usage']" position="after">
                <field name="barcode"/>
            </xpath>
        </field>
    </record>
</odoo>
