<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hudson_report_export_knowledge_wizard_form" model="ir.ui.view">
        <field name="name">hudson.report.export.knowledge.wizard.form</field>
        <field name="model">hudson.report.export.knowledge.wizard</field>
        <field name="arch" type="xml">
            <form string="Select an article">
                <group>
                    <field name="article_id" options="{'no_create_edit': True, 'no_open': True}"
                           placeholder="Search an article or type a name to create one..."/>
                </group>
                <p class="text-muted mb-0">
                    The report, as currently displayed, is added at the end of the article.
                </p>
                <field name="name" invisible="1"/>
                <field name="report_data" invisible="1"/>
                <footer>
                    <button name="action_insert" string="Insert" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
