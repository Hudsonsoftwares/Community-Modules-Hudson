<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- PRIVILEGE / GROUP HIERARCHY                                    -->
    <!-- ============================================================ -->

    <record model="res.groups.privilege" id="res_groups_privilege_field_service">
        <field name="name">Field Service</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_field_service_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: Can view and manage their own field service orders.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_field_service"/>
    </record>

    <record id="group_field_service_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: Full access to all field service orders, configuration, and reports.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_field_service"/>
        <field name="implied_ids" eval="[(4, ref('hudson_field_service.group_field_service_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- RECORD RULES                                                  -->
    <!-- ============================================================ -->

    <data noupdate="1">

        <!-- Multi-company rule -->
        <record model="ir.rule" id="field_service_order_comp_rule">
            <field name="name">Field Service Order: multi-company</field>
            <field name="model_id" ref="model_field_service_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Manager: see all orders -->
        <record model="ir.rule" id="field_service_order_manager_rule">
            <field name="name">Field Service Order: manager sees all</field>
            <field name="model_id" ref="model_field_service_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hudson_field_service.group_field_service_manager'))]"/>
        </record>

        <!-- User: see own assigned orders + unassigned orders (only if published) -->
        <record model="ir.rule" id="field_service_order_user_rule">
            <field name="name">Field Service Order: user sees own (published)</field>
            <field name="model_id" ref="model_field_service_order"/>
            <field name="domain_force">['&amp;', ('is_published', '=', True), '|', '|', ('employee_id.user_id', '=', user.id), ('extra_employee_ids.user_id', 'in', [user.id]), ('employee_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('hudson_field_service.group_field_service_user'))]"/>
        </record>

        <!-- Portal User: see own assigned orders OR orders where they are the customer -->
        <record model="ir.rule" id="field_service_order_portal_technician_rule">
            <field name="name">Field Service Order: portal user sees own</field>
            <field name="model_id" ref="model_field_service_order"/>
            <field name="domain_force">['|', '|', ('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('employee_id.user_id', '=', user.id), ('extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Timesheet multi-company -->
        <record model="ir.rule" id="field_service_timesheet_comp_rule">
            <field name="name">Field Service Timesheet: multi-company</field>
            <field name="model_id" ref="model_field_service_timesheet"/>
            <field name="domain_force">[('order_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Product Line multi-company -->
        <record model="ir.rule" id="field_service_product_line_comp_rule">
            <field name="name">Field Service Product Line: multi-company</field>
            <field name="model_id" ref="model_field_service_product_line"/>
            <field name="domain_force">[('order_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Portal User: Product Lines (linked to their orders) -->
        <record model="ir.rule" id="field_service_product_line_portal_rule">
            <field name="name">Field Service Product Line: portal user sees own</field>
            <field name="model_id" ref="model_field_service_product_line"/>
            <field name="domain_force">['|', '|', ('order_id.message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('order_id.employee_id.user_id', '=', user.id), ('order_id.extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Portal User: Images (linked to their orders) -->
        <record model="ir.rule" id="field_service_image_portal_rule">
            <field name="name">Field Service Image: portal user sees own</field>
            <field name="model_id" ref="model_field_service_image"/>
            <field name="domain_force">['|', '|', ('order_id.message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('order_id.employee_id.user_id', '=', user.id), ('order_id.extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>

</odoo>
