<?xml version='1.0' encoding='utf-8'?>
<odoo>

    
    
    

    <record model="res.groups.privilege" id="res_groups_privilege_field_service">
        <field name="name">Field Service</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_services" />
    </record>

    <record id="group_field_service_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: Can view and manage their own field service orders.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="privilege_id" ref="res_groups_privilege_field_service" />
    </record>

    <record id="group_field_service_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: Full access to all field service orders, configuration, and reports.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_field_service" />
        <field name="implied_ids" eval="[(4, ref('hudson_field_service.group_field_service_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    
    
    

    <data noupdate="1">

        
        <record model="ir.access" id="field_service_order_comp_rule">
            <field name="name">Field Service Order: multi-company</field>
            <field name="model_id" ref="model_field_service_order" />
            <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="fs_planning_slot_comp_rule">
            <field name="name">Field Service Planning Slot: multi-company</field>
            <field name="model_id" ref="hudson_planning.model_fs_planning_slot" />
            <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_order_manager_rule">
            <field name="name">Field Service Order: manager sees all</field>
            <field name="model_id" ref="model_field_service_order" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="hudson_field_service.group_field_service_manager" />
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_order_user_rule">
            <field name="name">Field Service Order: user sees own (published)</field>
            <field name="model_id" ref="model_field_service_order" />
            <field name="domain">['&amp;', ('is_published', '=', True), '|', '|', ('employee_id.user_id', '=', user.id), ('extra_employee_ids.user_id', 'in', [user.id]), ('employee_id', '=', False)]</field>
            <field name="group_id" ref="hudson_field_service.group_field_service_user" />
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_order_portal_technician_rule">
            <field name="name">Field Service Order: portal user sees own</field>
            <field name="model_id" ref="model_field_service_order" />
            <field name="domain">['|', '|', ('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('employee_id.user_id', '=', user.id), ('extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="group_id" ref="base.group_portal" />
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_timesheet_comp_rule">
            <field name="name">Field Service Timesheet: multi-company</field>
            <field name="model_id" ref="model_field_service_timesheet" />
            <field name="domain">[('order_id.company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_product_line_comp_rule">
            <field name="name">Field Service Product Line: multi-company</field>
            <field name="model_id" ref="model_field_service_product_line" />
            <field name="domain">[('order_id.company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_product_line_portal_rule">
            <field name="name">Field Service Product Line: portal user sees own</field>
            <field name="model_id" ref="model_field_service_product_line" />
            <field name="domain">['|', '|', ('order_id.message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('order_id.employee_id.user_id', '=', user.id), ('order_id.extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="group_id" ref="base.group_portal" />
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="field_service_image_portal_rule">
            <field name="name">Field Service Image: portal user sees own</field>
            <field name="model_id" ref="model_field_service_image" />
            <field name="domain">['|', '|', ('order_id.message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('order_id.employee_id.user_id', '=', user.id), ('order_id.extra_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="group_id" ref="base.group_portal" />
        <field name="operation">crud</field></record>

    </data>

</odoo>