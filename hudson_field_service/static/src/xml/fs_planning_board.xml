<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================
         Field Service Planning Board — OWL Template
         ============================================================ -->
    <t t-name="hudson_field_service.FsPlanningBoard">
        <div class="fs-planning-board">

            <!-- ── TOOLBAR ──────────────────────────────────────── -->
            <div class="fs-board-toolbar">
                <div class="fs-board-toolbar-title">
                    <i class="fa fa-calendar-check-o"/>
                    Planning Board
                </div>

                <!-- Date navigation -->
                <div class="fs-board-nav">
                    <button class="fs-board-btn btn-icon" t-on-click="prevPeriod" title="Previous">
                        <i class="fa fa-chevron-left"/>
                    </button>

                    <span class="fs-board-date-label">
                        <t t-esc="state.dateLabel"/>
                    </span>

                    <button class="fs-board-btn btn-icon" t-on-click="nextPeriod" title="Next">
                        <i class="fa fa-chevron-right"/>
                    </button>

                    <button class="fs-board-btn" t-on-click="goToday">
                        <i class="fa fa-dot-circle-o"/> Today
                    </button>
                </div>

                <!-- Mode toggle: Day / Week -->
                <div class="fs-board-mode-toggle">
                    <button class="fs-board-btn"
                            t-att-class="state.mode === 'day' ? 'active' : ''"
                            t-on-click="() => this.setMode('day')">
                        Day
                    </button>
                    <button class="fs-board-btn"
                            t-att-class="state.mode === 'week' ? 'active' : ''"
                            t-on-click="() => this.setMode('week')">
                        Week
                    </button>
                </div>

                <!-- Publish / New Order -->
                <div class="fs-board-actions d-flex gap-2">
                    <button class="fs-board-btn btn-warning" t-if="hasUnpublishedDrafts" t-on-click="publishDrafts">
                        <i class="fa fa-send"/> Publish Drafts
                    </button>
                    <button class="fs-board-btn btn-primary-action" t-on-click="openNewOrder">
                        <i class="fa fa-plus"/> New Order
                    </button>
                </div>
            </div>

            <!-- ── LOADING STATE ────────────────────────────────── -->
            <div t-if="state.loading" class="fs-board-loading">
                <div class="spinner"/>
                <span>Loading planning board...</span>
            </div>

            <!-- ── EMPTY STATE ──────────────────────────────────── -->
            <div t-elif="state.employees.length === 0 and !state.loading" class="fs-board-empty">
                <i class="fa fa-users"/>
                <p>No employees found. Add employees in the HR module to use the planning board.</p>
            </div>

            <!-- ── MAIN GRID ─────────────────────────────────────── -->
            <div t-else="" class="fs-board-grid-wrapper" t-ref="gridWrapper">
                <div class="fs-board-grid"
                     t-attf-style="grid-template-columns: {{gridTemplateColumns}}">

                    <!-- HEADER ROW -->
                    <div class="fs-board-header-corner">
                        <i class="fa fa-users me-1"/> Technicians
                    </div>

                    <!-- Time / Day column headers -->
                    <t t-foreach="state.slots" t-as="slot" t-key="slot.key">
                        <div class="fs-board-time-header"
                             t-att-class="slot.cssClass">
                            <t t-esc="slot.label"/>
                        </div>
                    </t>

                    <!-- DATA ROWS — one per employee + unassigned -->
                    <t t-foreach="state.employees" t-as="emp" t-key="emp.id">

                        <!-- Employee label cell (sticky left) -->
                        <div class="fs-board-employee-cell"
                             t-att-class="emp.id === 0 ? 'unassigned' : ''">
                            <t t-if="emp.avatar">
                                <img class="fs-board-employee-avatar"
                                     t-att-src="emp.avatar"
                                     t-att-alt="emp.name"
                                     loading="lazy"/>
                            </t>
                            <t t-else="">
                                <div class="fs-board-employee-avatar-placeholder"
                                     t-att-style="'background:' + emp.color">
                                    <t t-esc="emp.initials"/>
                                </div>
                            </t>
                            <div>
                                <div class="fs-board-employee-name" t-esc="emp.name"/>
                            </div>
                        </div>

                        <!-- One slot cell per time column -->
                        <t t-foreach="state.slots" t-as="slot" t-key="slot.key">
                            <div class="fs-board-slot-cell"
                                 t-att-class="slot.cssClass + (isSlotSelected(emp, slot) ? ' fs-slot-selected' : '')"
                                 t-on-mousedown="(ev) => this.onDragStart(ev, emp, slot)"
                                 t-on-mouseenter="(ev) => this.onDragEnter(ev, emp, slot)"
                                 t-on-mouseup="(ev) => this.onDragEnd(ev, emp, slot)"
                                 t-on-click="(ev) => this.onClickSlot(ev, emp, slot)">

                                <!-- Order cards that fall in this slot -->
                                <t t-foreach="getOrdersForSlot(emp.employeeId, slot)" t-as="order" t-key="order.id">
                                    <div class="fs-board-order-card"
                                         t-att-class="'state-' + order.state + (order.isPublished ? ' is-published' : ' is-draft')"
                                         t-att-style="getCardStyle(order, slot)"
                                         t-on-click.stop="(ev) => this.openOrder(ev, order.id)"
                                         t-att-title="order.title + (order.partner ? ' — ' + order.partner : '')">
                                        
                                        <div class="card-title">
                                            <i t-if="!order.isPublished" class="fa fa-eye-slash me-1" title="Draft (Unpublished)"/>
                                            <t t-esc="order.name + ' – ' + order.title"/>
                                        </div>
                                        <div t-if="order.partner" class="card-sub">
                                            <i class="fa fa-map-marker me-1"/>
                                            <t t-esc="order.partner"/>
                                        </div>
                                    </div>
                                </t>

                            </div>
                        </t>

                    </t>
                </div>
            </div>

        </div>
    </t>

</templates>
