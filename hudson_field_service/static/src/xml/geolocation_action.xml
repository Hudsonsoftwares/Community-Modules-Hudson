<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Timer Widget: renders Start/Resume/Pause/Stop buttons with auto-geolocation -->
    <t t-name="hudson_field_service.FieldServiceTimerWidget">
        <div class="d-inline-flex gap-1">
            <!-- Start Button -->
            <button t-if="showStart"
                    class="btn btn-primary"
                    t-on-click="onClickStart"
                    t-att-disabled="state.loading">
                <t t-if="state.loadingAction === 'start'">
                    <i class="fa fa-spinner fa-spin"/> Starting...
                </t>
                <t t-else="">
                    <i class="fa fa-play"/> Start
                </t>
            </button>

            <!-- Resume Button -->
            <button t-if="showResume"
                    class="btn btn-primary"
                    t-on-click="onClickResume"
                    t-att-disabled="state.loading">
                <t t-if="state.loadingAction === 'resume'">
                    <i class="fa fa-spinner fa-spin"/> Resuming...
                </t>
                <t t-else="">
                    <i class="fa fa-play"/> Resume
                </t>
            </button>

            <!-- Pause Button -->
            <button t-if="showPause"
                    class="btn btn-warning"
                    t-on-click="onClickPause"
                    t-att-disabled="state.loading">
                <t t-if="state.loadingAction === 'pause'">
                    <i class="fa fa-spinner fa-spin"/> Pausing...
                </t>
                <t t-else="">
                    <i class="fa fa-pause"/> Pause
                </t>
            </button>

            <!-- Stop Button -->
            <button t-if="showStop"
                    class="btn btn-success"
                    t-on-click="onClickStop"
                    t-att-disabled="state.loading">
                <t t-if="state.loadingAction === 'stop'">
                    <i class="fa fa-spinner fa-spin"/> Stopping...
                </t>
                <t t-else="">
                    <i class="fa fa-stop"/> Stop and Complete
                </t>
            </button>
        </div>
    </t>

</templates>
