        <!-- ============================================================
             Root Menu — Social Marketing
        ============================================================ -->
        <menuitem
            id="menu_hudson_social_root"
            name="Social Marketing"
            web_icon="hudson_social_marketing,static/description/icon.png"
            sequence="45"/>

        <!-- ============================================================
             Dashboard
        ============================================================ -->
        <menuitem
            id="menu_hudson_social_dashboard"
            name="Dashboard"
            parent="menu_hudson_social_root"
