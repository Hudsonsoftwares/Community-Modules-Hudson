<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Groups (Odoo 19: res.groups no longer has category_id)
        ============================================================ -->
        <record id="group_social_user" model="res.groups">
            <field name="name">Social Marketing / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_social_manager" model="res.groups">
            <field name="name">Social Marketing / Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_social_user'))]"/>
        </record>

    </data>
</odoo>
