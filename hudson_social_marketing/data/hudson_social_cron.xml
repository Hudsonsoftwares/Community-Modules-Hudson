<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Auto-sync scheduled action — runs every 5 minutes -->
        <record id="ir_cron_hudson_social_sync" model="ir.cron">
            <field name="name">Hudson Social Marketing: Auto Sync</field>
            <field name="model_id" ref="model_hudson_social_post"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_all()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
