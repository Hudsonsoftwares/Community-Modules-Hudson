<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hudson_shopfloor.ShopFloorApp" owl="1">
        <div class="o_hudson_shopfloor w-100 h-100 d-flex flex-column text-dark position-relative">

            <!-- =========================================================== -->
            <!-- Navbar                                                        -->
            <!-- =========================================================== -->
            <div class="sf-navbar d-flex justify-content-between align-items-center px-4 py-3 border-bottom shadow-sm">
                <div class="d-flex align-items-center">
                    <t t-foreach="this.state.workcenters" t-as="wc" t-key="wc.id">
                        <div t-attf-class="sf-nav-item me-4 fw-bold fs-5 cursor-pointer pb-2 d-flex align-items-center {{ this.state.selectedWorkcenter === wc.id ? 'border-bottom border-3 border-success text-success' : 'text-dark opacity-75' }}"
                             t-on-click="() => this.selectWorkcenter(wc.id)">
                            <t t-out="wc.name"/>
                            <span class="badge rounded-pill ms-2"
                                  t-attf-class="{{ this.state.selectedWorkcenter === wc.id ? 'bg-success text-white' : 'bg-secondary text-white' }}"
                                  style="font-size: 0.75rem;">
                                <t t-out="wc.count"/>
                            </span>
                        </div>
                    </t>
                </div>
                <div t-if="this.state.activeEmployee" class="d-flex align-items-center">
                    <span class="fw-bold me-3 text-success">Logged in: <t t-out="this.state.activeEmployee.name"/></span>
                    <button class="btn btn-outline-danger btn-sm rounded-pill" t-on-click="() => this.logoutEmployee()">Sign Out</button>
                </div>
            </div>

            <div class="d-flex flex-grow-1 overflow-hidden">
                <!-- Left Sidebar (Operators) -->
                <div class="sf-sidebar border-end p-3 bg-light overflow-auto" style="width: 250px; min-width: 250px;">
                    <h5 class="fw-bold mb-4 text-secondary text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">Operators</h5>
                    <t t-foreach="this.state.employees" t-as="emp" t-key="emp.id">
                        <div t-attf-class="d-flex align-items-center mb-3 p-2 rounded cursor-pointer sf-hover-btn {{ this.state.activeEmployee and this.state.activeEmployee.id === emp.id ? 'bg-success text-white shadow-sm' : 'bg-white border' }}"
                             t-on-click="() => this.clickEmployee(emp)">
                            <div t-attf-class="rounded-circle me-3 d-flex align-items-center justify-content-center {{ this.state.activeEmployee and this.state.activeEmployee.id === emp.id ? 'bg-white text-success' : 'bg-secondary text-white' }}" style="width: 36px; height: 36px;">
                                <i class="fa fa-user"></i>
                            </div>
                            <div class="fw-bold"><t t-out="emp.name"/></div>
                        </div>
                    </t>
                    <div t-if="this.state.employees.length === 0" class="text-muted small">
                        No employees linked to a system User.
                    </div>
                </div>

                <!-- Main Content -->
                <div class="sf-main flex-grow-1 p-4 overflow-auto d-flex flex-wrap align-items-start align-content-start gap-4" style="background-color: #f8f9fa;">
                    <t t-foreach="this.state.mos" t-as="mo" t-key="mo.id">
                        <div class="sf-wo-card border rounded shadow-sm d-flex flex-column bg-white" style="width: 400px;">

                            <!-- LIST VIEW -->
                            <t t-if="!this.isMoActive(mo)">
                                <div class="p-4 bg-white border-bottom border-secondary-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="mb-0 fw-bold"><t t-out="mo.name"/></h4>
                                        <span class="badge bg-warning rounded-pill text-dark" t-if="this.isMoInProgress(mo)">In Progress</span>
                                    </div>
                                    <div class="d-flex justify-content-between fs-5">
                                        <span class="text-secondary"><t t-out="mo.product_id[1]"/></span>
                                        <span class="fw-bold"><t t-out="mo.qty_producing"/> / <t t-out="mo.qty_production"/> Units</span>
                                    </div>
                                </div>
                                <div class="px-4 py-2 bg-white">
                                    <t t-foreach="mo.workorders" t-as="wo" t-key="wo.id">
                                        <div t-attf-class="sf-operation-row d-flex justify-content-between align-items-center {{ wo.state === 'ready' ? 'active-clickable' : '' }}"
                                             t-on-click="() => wo.state === 'ready' ? this.actionStartWorkorder(wo.id) : null">
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-secondary-subtle text-secondary me-2 p-2" t-if="wo.state !== 'done'"><t t-out="wo.workcenter_id[1]"/></span>
                                                <span t-attf-class="fs-6 {{ wo.state === 'done' ? 'text-muted text-decoration-line-through' : '' }}"><t t-out="wo.name"/></span>
                                            </div>
                                            <div>
                                                <i class="fa fa-check text-success ms-2" t-if="wo.state === 'done'"></i>
                                                <i class="fa fa-chevron-right text-secondary ms-2" t-if="wo.state === 'ready' or wo.state === 'progress'"></i>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                <div class="p-3 bg-light border-top border-secondary-subtle d-flex justify-content-between align-items-center mt-auto">
                                    <button class="btn btn-secondary px-3" t-on-click="() => this.actionCloseProduction(mo.workorders[0].id)">Close Production</button>
                                    <button class="btn btn-outline-secondary px-3 sf-hover-btn" title="Options"
                                            t-on-click="() => this.openOptionsModal(mo.id, mo.workorders[0].id)">
                                        <i class="fa fa-ellipsis-v"></i>
                                    </button>
                                </div>
                            </t>

                            <!-- ACTIVE WORKORDER VIEW -->
                            <t t-if="this.isMoActive(mo)">
                                <div class="p-4 bg-white flex-grow-1 d-flex flex-column h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="mb-0 fw-bold text-dark"><t t-out="mo.name"/></h4>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-5 fw-bold text-success font-monospace" t-if="this.activeWo.state === 'progress'">
                                                <t t-out="this.formatDuration(this.activeWo.date_start, this.activeWo.duration)"/>
                                            </span>
                                            <div class="bg-primary rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="fa fa-user"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-1 fs-5 fw-bold text-dark"><t t-out="this.activeWo.name"/></div>
                                    <div class="d-flex justify-content-between fs-5 text-secondary">
                                        <span><t t-out="mo.product_id[1]"/></span>
                                        <span class="fw-bold text-dark"><t t-out="mo.qty_producing"/> Units</span>
                                    </div>
                                </div>
                                <div class="p-3 bg-light border-top border-secondary-subtle d-flex justify-content-between align-items-center mt-auto">
                                    <button class="btn btn-success px-4 fw-bold shadow-sm sf-hover-btn" t-on-click="() => this.actionCloseProduction(this.activeWo.id)">Mark as Done</button>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-secondary px-3 sf-hover-btn" title="Options"
                                                t-on-click="() => this.openOptionsModal(mo.id, this.activeWo.id)">
                                            <i class="fa fa-ellipsis-v"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary px-3 sf-hover-btn" t-on-click="() => this.closeOperation()">Back</button>
                                    </div>
                                </div>
                            </t>

                        </div>
                    </t>

                    <div t-if="this.state.mos.length === 0" class="text-muted w-100 text-center mt-5 fs-4">
                        <t t-if="this.state.activeEmployee">
                            No manufacturing orders assigned to <t t-out="this.state.activeEmployee.name"/> for this work center.
                        </t>
                        <t t-else="">
                            Please select an operator to view assigned manufacturing orders.
                        </t>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- OPTIONS MODAL (Enterprise-style 2×3 grid)                   -->
            <!-- =========================================================== -->
            <div t-if="this.state.showOptionsModal"
                 class="sf-overlay position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                 style="z-index: 3000; background: rgba(0,0,0,0.45);"
                 t-on-click.self="() => this.closeOptionsModal()">
                <div class="bg-white rounded-3 shadow-lg sf-options-modal" style="width: 560px; max-width: 95vw;">
                    <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-2">
                        <span class="fw-bold fs-5">Options</span>
                        <button class="btn btn-link text-dark p-0" t-on-click="() => this.closeOptionsModal()">
                            <i class="fa fa-times fs-5"></i>
                        </button>
                    </div>
                    <div class="p-4 pt-2">
                        <div class="row g-3">
                            <div class="col-6">
                                <button class="sf-option-btn w-100 py-4 border rounded-3 bg-light sf-hover-btn d-flex flex-column align-items-center gap-2"
                                        t-on-click="() => this.openRegisterQtyModal(this.state.optionsMoId, this.state.optionsWoId)">
                                    <i class="fa fa-plus fs-4"></i>
                                    <span class="fw-semibold text-center">Register Quantity / Lot</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="sf-option-btn w-100 py-4 border rounded-3 bg-light sf-hover-btn d-flex flex-column align-items-center gap-2"
                                        t-on-click="() => this.actionScrap(this.state.optionsWoId)">
                                    <i class="fa fa-random fs-4"></i>
                                    <span class="fw-semibold">Scrap</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="sf-option-btn w-100 py-4 border rounded-3 bg-light sf-hover-btn d-flex flex-column align-items-center gap-2"
                                        t-on-click="() => this.openAddWorkOrderModal(this.state.optionsMoId)">
                                    <i class="fa fa-plus fs-4"></i>
                                    <span class="fw-semibold">Add Work Order</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="sf-option-btn w-100 py-4 border rounded-3 bg-light sf-hover-btn d-flex flex-column align-items-center gap-2"
                                        t-on-click="() => this.openCatalogModal(this.state.optionsMoId)">
                                    <i class="fa fa-plus fs-4"></i>
                                    <span class="fw-semibold">Add Component</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="sf-option-btn w-100 py-4 border rounded-3 bg-light sf-hover-btn d-flex flex-column align-items-center gap-2"
                                        t-on-click="() => this.openLogNoteModal(this.state.optionsMoId)">
                                    <i class="fa fa-sticky-note-o fs-4"></i>
                                    <span class="fw-semibold">Log Note</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- REGISTER QUANTITY / LOT MODAL                               -->
            <!-- =========================================================== -->
            <div t-if="this.state.showRegisterQtyModal"
                 class="sf-overlay position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                 style="z-index: 3100; background: rgba(0,0,0,0.45);">
                <div class="bg-white rounded-3 shadow-lg" style="width: 460px; max-width: 95vw;">
                    <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-2">
                        <span class="fw-bold fs-5">Register Quantity / Lot</span>
                        <button class="btn btn-link text-dark p-0" t-on-click="() => this.closeRegisterQtyModal()">
                            <i class="fa fa-times fs-5"></i>
                        </button>
                    </div>
                    <div class="p-4 pt-2">
                        <div class="mb-3" t-if="this.state.registerProducts.length > 0">
                            <label class="form-label fw-semibold">Component</label>
                            <select class="form-select" t-on-change="this.onRegisterMoveChange">
                                <t t-foreach="this.state.registerProducts" t-as="mv" t-key="mv.id">
                                    <option t-att-value="mv.id" t-att-selected="mv.id === this.state.registerSelectedMoveId">
                                        <t t-out="mv.product_id[1]"/> (Planned: <t t-out="mv.product_uom_qty"/>)
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Quantity Done</label>
                            <input type="number" class="form-control" min="0" step="0.01"
                                   t-att-value="this.state.registerQtyValue"
                                   t-on-input="(ev) => this.state.registerQtyValue = ev.target.value"/>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Lot / Serial Number <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" class="form-control" placeholder="Enter lot or serial number..."
                                   t-att-value="this.state.registerLotName"
                                   t-on-input="(ev) => this.state.registerLotName = ev.target.value"/>
                        </div>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-outline-secondary" t-on-click="() => this.closeRegisterQtyModal()">Cancel</button>
                            <button class="btn btn-success px-4 fw-bold" t-on-click="() => this.submitRegisterQty()">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- PRODUCT CATALOG MODAL (Add Component)                       -->
            <!-- Enterprise-style full product picker                        -->
            <!-- =========================================================== -->
            <div t-if="this.state.showCatalogModal"
                 class="sf-catalog-overlay position-fixed top-0 start-0 w-100 h-100"
                 style="z-index: 3200; background: #fff;">
                <div class="d-flex flex-column h-100">

                    <!-- Catalog Header -->
                    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-bottom bg-white">
                        <span class="fw-bold fs-5">Products</span>
                        <button class="btn btn-link text-dark p-0" t-on-click="() => this.closeCatalogModal()">
                            <i class="fa fa-times fs-4"></i>
                        </button>
                    </div>

                    <!-- Catalog Body -->
                    <div class="d-flex flex-grow-1 overflow-hidden">

                        <!-- LEFT SIDEBAR: Categories + Tags -->
                        <div class="sf-catalog-sidebar border-end overflow-auto p-3" style="width: 210px; min-width: 210px; background: #fff;">

                            <!-- Categories -->
                            <div class="sf-catalog-section-title mb-2">
                                <i class="fa fa-th-list me-1"></i> CATEGORIES
                            </div>
                            <!-- All -->
                            <div t-attf-class="sf-cat-item {{ !this.state.catalogSelectedCat and !this.state.catalogSelectedTag ? 'sf-cat-item-active' : '' }}"
                                 t-on-click="() => this.catalogSelectCategory(null)">All</div>
                            <!-- Individual categories -->
                            <t t-foreach="this.state.catalogCategories" t-as="cat" t-key="cat.id">
                                <div t-attf-class="sf-cat-item {{ this.state.catalogSelectedCat === cat.id ? 'sf-cat-item-active' : '' }}"
                                     t-on-click="() => this.catalogSelectCategory(cat.id)">
                                    <t t-out="cat.name"/>
                                </div>
                            </t>

                            <!-- Tags (if any) -->
                            <div t-if="this.state.catalogTags.length > 0" class="sf-catalog-section-title mt-4 mb-2">
                                <i class="fa fa-tags me-1"></i> TAGS
                            </div>
                            <t t-foreach="this.state.catalogTags" t-as="tag" t-key="tag.id">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div t-attf-class="sf-cat-item flex-grow-1 {{ this.state.catalogSelectedTag === tag.id ? 'sf-cat-item-active' : '' }}"
                                         t-on-click="() => this.catalogSelectTag(tag.id)">
                                        <t t-out="tag.name"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- RIGHT CONTENT: Search + Product Grid -->
                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">

                            <!-- Search bar + pagination -->
                            <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom bg-white">
                                <div class="sf-catalog-search-wrap d-flex align-items-center flex-grow-1" style="max-width: 420px;">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #ced4da;">
                                            <i class="fa fa-search"></i>
                                        </span>
                                        <input type="text" class="form-control border-start-0 ps-0"
                                               placeholder="Search..."
                                               style="border-color: #ced4da;"
                                               t-att-value="this.state.catalogSearch"
                                               t-on-input="(ev) => this.onCatalogSearchInput(ev)"/>
                                        <!-- dropdown arrow to match enterprise look -->
                                        <span class="input-group-text bg-white text-muted" style="border-color: #ced4da; cursor: pointer;">
                                            <i class="fa fa-caret-down"></i>
                                        </span>
                                    </div>
                                </div>
                                <!-- Pagination info + arrows -->
                                <div class="d-flex align-items-center gap-2 ms-auto text-muted" style="white-space: nowrap; font-size: 0.9rem;">
                                    <span t-if="this.state.catalogTotalCount &gt; 0">
                                        <t t-out="this.catalogPageStart"/>-<t t-out="this.catalogPageEnd"/> / <t t-out="this.state.catalogTotalCount"/>
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary sf-page-btn" t-on-click="() => this.catalogPrevPage()"
                                            t-att-disabled="this.state.catalogPage &lt;= 1">
                                        <i class="fa fa-chevron-left"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary sf-page-btn" t-on-click="() => this.catalogNextPage()"
                                            t-att-disabled="this.state.catalogPage * 40 &gt;= this.state.catalogTotalCount">
                                        <i class="fa fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Product Grid -->
                            <div class="flex-grow-1 overflow-auto p-3" style="background: #f8f9fa;">
                                <!-- Loading spinner -->
                                <div t-if="this.state.catalogLoading" class="d-flex justify-content-center align-items-center h-100">
                                    <div class="spinner-border text-secondary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>

                                <div t-if="!this.state.catalogLoading" class="row g-3">
                                    <t t-foreach="this.state.catalogProducts" t-as="prod" t-key="prod.id">
                                        <div class="col-6">
                                            <div t-attf-class="sf-product-card h-100 bg-white border rounded p-3 d-flex flex-column {{ this.catalogIsInCart(prod.id) ? 'sf-product-card-selected' : '' }}">
                                                <!-- Top: text info + image -->
                                                <div class="d-flex gap-3 flex-grow-1">
                                                    <div class="flex-grow-1 min-w-0">
                                                        <div class="fw-bold text-dark sf-product-name"><t t-out="prod.name"/></div>
                                                        <div class="text-muted small mt-1" t-if="prod.default_code">
                                                            <t t-out="prod.default_code"/>
                                                        </div>
                                                        <!-- Stock availability -->
                                                        <div class="text-muted small mt-1">
                                                            <t t-if="prod.virtual_available and prod.virtual_available != prod.qty_available">
                                                                <t t-out="prod.virtual_available"/> Available / <t t-out="prod.qty_available"/> On Hand
                                                            </t>
                                                            <t t-else="">
                                                                <t t-out="prod.qty_available"/> On Hand
                                                            </t>
                                                        </div>
                                                    </div>
                                                    <!-- Product image -->
                                                    <div class="sf-product-img-wrap flex-shrink-0">
                                                        <img t-attf-src="/web/image/product.product/{{ prod.id }}/image_128"
                                                             class="sf-product-img"
                                                             t-att-alt="prod.name"/>
                                                    </div>
                                                </div>

                                                <!-- Bottom action area -->
                                                <div class="mt-3 d-flex justify-content-end align-items-center">
                                                    <!-- Not in cart: show Add button -->
                                                    <t t-if="!this.catalogIsInCart(prod.id)">
                                                        <button class="btn btn-outline-secondary btn-sm sf-add-btn"
                                                                t-on-click="() => this.catalogAddToCart(prod)">
                                                            <i class="fa fa-shopping-cart me-1"></i> Add
                                                        </button>
                                                    </t>
                                                    <!-- In cart: show qty stepper + Remove -->
                                                    <t t-else="">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <button class="sf-qty-btn" t-on-click="() => this.catalogDecreaseQty(prod.id)">−</button>
                                                            <input type="number" class="sf-qty-input text-center"
                                                                   t-att-value="this.catalogGetQty(prod.id)"
                                                                   t-on-change="(ev) => this.catalogSetQty(prod.id, ev)"
                                                                   min="1"/>
                                                            <span class="text-muted small"><t t-out="this.catalogGetUom(prod.id)"/></span>
                                                            <button class="sf-qty-btn" t-on-click="() => this.catalogIncreaseQty(prod.id)">+</button>
                                                            <button class="btn btn-sm btn-outline-danger sf-remove-btn"
                                                                    t-on-click="() => this.catalogRemoveFromCart(prod.id)">
                                                                <i class="fa fa-trash me-1"></i> Remove
                                                            </button>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>

                                    <div t-if="this.state.catalogProducts.length === 0 and !this.state.catalogLoading"
                                         class="col-12 text-center text-muted py-5 fs-5">
                                        No products found.
                                    </div>
                                </div>
                            </div>

                            <!-- Catalog Footer -->
                            <div class="px-4 py-3 bg-white border-top d-flex align-items-center gap-3">
                                <button class="btn sf-back-btn fw-bold px-4"
                                        t-on-click="() => this.closeCatalogModal()">
                                    Back to ShopFloor
                                </button>
                                <t t-if="this.catalogCartCount > 0">
                                    <button class="btn btn-success px-4 fw-bold"
                                            t-on-click="() => this.submitCatalog()">
                                        Add <t t-out="this.catalogCartCount"/> Component(s)
                                    </button>
                                </t>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- ADD WORK ORDER MODAL (Enterprise-style form)                -->
            <!-- =========================================================== -->
            <div t-if="this.state.showAddWorkOrderModal"
                 class="sf-overlay position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                 style="z-index: 3100; background: rgba(0,0,0,0.45);">
                <div class="bg-white rounded-3 shadow-lg" style="width: 580px; max-width: 95vw;">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                        <span class="fw-bold fs-5">Add Work Order</span>
                        <button class="btn btn-link text-dark p-0" t-on-click="() => this.closeAddWorkOrderModal()">
                            <i class="fa fa-times fs-5"></i>
                        </button>
                    </div>
                    <!-- Form body -->
                    <div class="p-4">
                        <!-- Insert after operation -->
                        <div class="sf-wo-form-row">
                            <label class="sf-wo-label">Insert after operation</label>
                            <div class="sf-wo-field">
                                <select class="form-select sf-wo-select" t-on-change="this.onAddWorkOrderInsertAfterChange">
                                    <option value="">-- Beginning --</option>
                                    <t t-foreach="this.state.addWorkOrderOperations" t-as="op" t-key="op.id">
                                        <option t-att-value="op.id"
                                                t-att-selected="this.state.addWorkOrderInsertAfterId === op.id">
                                            <t t-out="op.production_id ? op.production_id[1] + ' - ' + op.name : op.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- Title -->
                        <div class="sf-wo-form-row">
                            <label class="sf-wo-label">Title</label>
                            <div class="sf-wo-field">
                                <input type="text" class="form-control sf-wo-input"
                                       t-att-value="this.state.addWorkOrderTitle"
                                       t-on-input="(ev) => this.state.addWorkOrderTitle = ev.target.value"/>
                            </div>
                        </div>

                        <!-- Work Center -->
                        <div class="sf-wo-form-row">
                            <label class="sf-wo-label">Work Center</label>
                            <div class="sf-wo-field">
                                <select class="form-select sf-wo-select" t-on-change="this.onAddWorkOrderWcChange">
                                    <option value="">-- Select --</option>
                                    <t t-foreach="this.state.addWorkOrderWorkcentersList" t-as="wc" t-key="wc.id">
                                        <option t-att-value="wc.id"
                                                t-att-selected="this.state.addWorkOrderWorkcenterId === wc.id">
                                            <t t-out="wc.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- Expected Duration -->
                        <div class="sf-wo-form-row">
                            <label class="sf-wo-label">Expected Duration</label>
                            <div class="sf-wo-field d-flex align-items-center gap-2">
                                <span class="text-muted" t-if="!this.state.addWorkOrderDurationMin">0m 0s</span>
                                <input type="number" class="form-control sf-wo-input" style="max-width: 100px;"
                                       placeholder="Minutes" min="0"
                                       t-att-value="this.state.addWorkOrderDurationMin"
                                       t-on-input="(ev) => this.state.addWorkOrderDurationMin = ev.target.value"/>
                                <span class="text-muted small">min</span>
                            </div>
                        </div>

                        <!-- Date Start -->
                        <div class="sf-wo-form-row">
                            <label class="sf-wo-label">Date Start</label>
                            <div class="sf-wo-field">
                                <input type="datetime-local" class="form-control sf-wo-input"
                                       t-att-value="this.state.addWorkOrderDateStart"
                                       t-on-change="(ev) => this.state.addWorkOrderDateStart = ev.target.value"/>
                            </div>
                        </div>

                        <!-- Employee -->
                        <div class="sf-wo-form-row mb-4">
                            <label class="sf-wo-label">Employee</label>
                            <div class="sf-wo-field">
                                <select class="form-select sf-wo-select" t-on-change="this.onAddWorkOrderEmpChange">
                                    <option value="">-- Select --</option>
                                    <t t-foreach="this.state.addWorkOrderEmployeesList" t-as="emp" t-key="emp.id">
                                        <option t-att-value="emp.id"
                                                t-att-selected="this.state.addWorkOrderEmployeeId === emp.id">
                                            <t t-out="emp.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-3 pt-2 border-top">
                            <button class="btn sf-submit-btn fw-bold px-4" t-on-click="() => this.submitAddWorkOrder()">
                                Add Work Order
                            </button>
                            <button class="btn btn-outline-secondary px-4" t-on-click="() => this.closeAddWorkOrderModal()">
                                Discard
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- LOG NOTE MODAL                                              -->
            <!-- =========================================================== -->
            <div t-if="this.state.showLogNoteModal"
                 class="sf-overlay position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                 style="z-index: 3100; background: rgba(0,0,0,0.45);">
                <div class="bg-white rounded-3 shadow-lg" style="width: 460px; max-width: 95vw;">
                    <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-2">
                        <span class="fw-bold fs-5">Log Note</span>
                        <button class="btn btn-link text-dark p-0" t-on-click="() => this.closeLogNoteModal()">
                            <i class="fa fa-times fs-5"></i>
                        </button>
                    </div>
                    <div class="p-4 pt-2">
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Note</label>
                            <textarea class="form-control" rows="4" placeholder="Enter your note here..."
                                      t-att-value="this.state.logNoteText"
                                      t-on-input="(ev) => this.state.logNoteText = ev.target.value"></textarea>
                        </div>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-outline-secondary" t-on-click="() => this.closeLogNoteModal()">Cancel</button>
                            <button class="btn btn-success px-4 fw-bold" t-on-click="() => this.submitLogNote()">Add Note</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================== -->
            <!-- PIN Modal Overlay                                           -->
            <!-- =========================================================== -->
            <div t-if="this.state.showPinModal"
                 class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center"
                 style="z-index: 4000;">
                <div class="bg-white rounded p-4 shadow-lg text-center" style="width: 350px;">
                    <h4 class="fw-bold mb-3">Sign in</h4>
                    <p class="text-secondary mb-4">Enter PIN for <strong class="text-dark"><t t-out="this.state.pendingEmployee.name"/></strong></p>
                    <div class="mb-4 d-flex justify-content-center w-100 p-3 border rounded bg-light" style="min-height: 60px;">
                        <span class="fs-1 fw-bold text-dark" style="letter-spacing: 0.5rem; line-height: 1;">
                            <t t-out="'•'.repeat(this.state.pinInput.length)"/>
                        </span>
                    </div>
                    <div t-if="this.state.pinError" class="text-danger small fw-bold mb-3">
                        Incorrect PIN. Please try again.
                    </div>
                    <div class="row g-2 mb-3">
                        <t t-foreach="[1,2,3,4,5,6,7,8,9]" t-as="num" t-key="num">
                            <div class="col-4">
                                <button class="btn btn-light border w-100 py-2 fs-4 fw-bold sf-hover-btn"
                                        t-on-click="() => this.addPinDigit(num)"><t t-out="num"/></button>
                            </div>
                        </t>
                        <div class="col-4">
                            <button class="btn btn-danger w-100 py-2 fs-5 fw-bold sf-hover-btn text-white"
                                    t-on-click="() => this.clearPin()">C</button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-light border w-100 py-2 fs-4 fw-bold sf-hover-btn"
                                    t-on-click="() => this.addPinDigit(0)">0</button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-success w-100 py-2 fs-5 fw-bold sf-hover-btn text-white"
                                    t-on-click="() => this.submitPin()">OK</button>
                        </div>
                    </div>
                    <button class="btn btn-link text-secondary text-decoration-none mt-2"
                            t-on-click="() => this.closePinModal()">Cancel</button>
                </div>
            </div>

        </div>
    </t>
</templates>
