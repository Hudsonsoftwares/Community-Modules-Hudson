<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Rental Order Report -->
        <record id="action_report_rental_order" model="ir.actions.report">
            <field name="name">Rental Order</field>
            <field name="model">rental.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hudson_rental.report_rental_order_document</field>
            <field name="report_file">hudson_rental.report_rental_order_document</field>
            <field name="binding_model_id" ref="model_rental_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Rental Order Document Template -->
        <template id="report_rental_order_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            
                            <h2>
                                <span>Rental Order #</span>
                                <span t-field="o.name"/>
                            </h2>
                            
                            <div class="row mt32 mb32">
                                <div class="col-6">
                                    <strong>Customer:</strong><br/>
                                    <div t-field="o.partner_id" 
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                                </div>
                                <div class="col-6">
                                    <strong>Order Date:</strong> <span t-field="o.date_order" t-options="{'widget': 'date'}"/><br/>
                                    <strong>Pickup Date:</strong> <span t-field="o.pickup_date" t-options="{'widget': 'datetime'}"/><br/>
                                    <strong>Return Date:</strong> <span t-field="o.return_date" t-options="{'widget': 'datetime'}"/><br/>
                                    <t t-if="o.actual_return_date">
                                        <strong>Actual Return:</strong> <span t-field="o.actual_return_date" t-options="{'widget': 'datetime'}"/><br/>
                                    </t>
                                    <strong>Status:</strong> <span t-field="o.state"/><br/>
                                </div>
                            </div>
                            
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th class="text-start">Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Duration (Days)</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Taxes</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.order_line_ids" t-as="line">
                                        <tr>
                                            <td><span t-field="line.product_id"/></td>
                                            <td class="text-end"><span t-field="line.quantity"/></td>
                                            <td class="text-end"><t t-esc="round(line.duration_days, 1)"/></td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit" 
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="', '.join(map(lambda x: x.name, line.tax_id))"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_total" 
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            
                            <div class="clearfix">
                                <div class="row">
                                    <div class="col-6"/>
                                    <div class="col-6">
                                        <table class="table table-sm">
                                            <tr class="border-black">
                                                <td><strong>Subtotal</strong></td>
                                                <td class="text-end">
                                                    <span t-field="o.amount_untaxed" 
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Taxes</td>
                                                <td class="text-end">
                                                    <span t-field="o.amount_tax" 
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr class="border-black o_total">
                                                <td><strong>Total</strong></td>
                                                <td class="text-end">
                                                    <span t-field="o.amount_total" 
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <t t-if="o.amount_deposit > 0">
                                                <tr>
                                                    <td>Security Deposit</td>
                                                    <td class="text-end">
                                                        <span t-field="o.amount_deposit" 
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.amount_late_fee > 0">
                                                <tr>
                                                    <td>Late Fees</td>
                                                    <td class="text-end">
                                                        <span t-field="o.amount_late_fee" 
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            
                            <p t-if="o.note">
                                <strong>Terms and Conditions:</strong><br/>
                                <span t-field="o.note"/>
                            </p>
                            
                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
