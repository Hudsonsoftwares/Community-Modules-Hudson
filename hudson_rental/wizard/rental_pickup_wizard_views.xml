<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Rental Pickup Wizard Form -->
        <record id="rental_pickup_wizard_view_form" model="ir.ui.view">
            <field name="name">rental.pickup.wizard.form</field>
            <field name="model">rental.pickup.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Pickup">
                    <group>
                        <field name="order_id" column_invisible="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="pickup_date"/>
                        <field name="note"/>
                    </group>
                    <group string="Items to Pickup">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="picked_quantity"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_confirm_pickup" string="Confirm Pickup" 
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
