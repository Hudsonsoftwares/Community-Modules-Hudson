<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Rental Extend Wizard Form -->
        <record id="rental_extend_wizard_view_form" model="ir.ui.view">
            <field name="name">rental.extend.wizard.form</field>
            <field name="model">rental.extend.wizard</field>
            <field name="arch" type="xml">
                <form string="Extend Rental">
                    <group>
                        <field name="order_id" column_invisible="1"/>
                        <field name="current_return_date" readonly="1"/>
                        <field name="new_return_date"/>
                        <field name="extension_days" readonly="1"/>
                        <field name="extension_cost" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="note" placeholder="Reason for extension..."/>
                    </group>
                    <footer>
                        <button name="action_extend_rental" string="Extend Rental" 
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
