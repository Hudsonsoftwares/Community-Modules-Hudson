<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Rental User Group -->
        <record id="group_rental_user" model="res.groups">
            <field name="name">Rental User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rental Manager Group -->
        <record id="group_rental_manager" model="res.groups">
            <field name="name">Rental Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-company Rules -->
        <record id="rental_order_company_rule" model="ir.rule">
            <field name="name">Rental Order: multi-company</field>
            <field name="model_id" ref="model_rental_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Portal Access Rules -->
        <record id="rental_order_portal_rule" model="ir.rule">
            <field name="name">Rental Order: portal users</field>
            <field name="model_id" ref="model_rental_order"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
