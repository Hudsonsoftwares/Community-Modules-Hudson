<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        
        
        <record id="group_rental_user" model="res.groups">
            <field name="name">Rental User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        
        <record id="group_rental_manager" model="res.groups">
            <field name="name">Rental Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_user'))]" />
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>

        
        <record id="rental_order_company_rule" model="ir.access">
            <field name="name">Rental Order: multi-company</field>
            <field name="model_id" ref="model_rental_order" />
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field></record>

        
        <record id="rental_order_portal_rule" model="ir.access">
            <field name="name">Rental Order: portal users</field>
            <field name="model_id" ref="model_rental_order" />
            <field name="domain">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="group_id" ref="base.group_portal" />
            <field name="operation">r</field></record>

    </data>
</odoo>