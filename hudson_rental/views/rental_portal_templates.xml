<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Portal Home - Rental Entry -->
        <template id="portal_my_home_menu_rental" name="Portal My Home: Rental Entries" inherit_id="portal.portal_my_home" customize_show="True" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Rentals</t>
                    <t t-set="url" t-value="'/my/rentals'"/>
                    <t t-set="placeholder_count" t-value="'rental_count'"/>
                </t>
            </xpath>
        </template>

        <!-- Portal My Rentals List -->
        <template id="portal_my_rentals" name="My Rentals">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Rentals</t>
                </t>
                
                <t t-if="not rentals">
                    <p class="alert alert-warning">There are currently no rental orders for your account.</p>
                </t>
                <t t-if="rentals" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Reference</th>
                            <th class="text-end">Pickup Date</th>
                            <th class="text-end">Return Date</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rentals" t-as="rental">
                            <tr>
                                <td><a t-attf-href="/my/rentals/#{rental.id}"><t t-esc="rental.name"/></a></td>
                                <td class="text-end"><span t-field="rental.pickup_date" t-options="{'widget': 'datetime'}"/></td>
                                <td class="text-end"><span t-field="rental.return_date" t-options="{'widget': 'datetime'}"/></td>
                                <td class="text-end"><span t-field="rental.amount_total"/></td>
                                <td class="text-center">
                                    <span t-attf-class="badge rounded-pill 
                                        #{'bg-info' if rental.state == 'draft' else 
                                          'bg-primary' if rental.state == 'confirmed' else 
                                          'bg-warning' if rental.state in ['reserved', 'picked_up'] else 
                                          'bg-success' if rental.state == 'done' else 'bg-secondary'}">
                                        <t t-esc="dict(rental._fields['state'].selection).get(rental.state)"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>

        <!-- Portal Rental Order Detail -->
        <template id="portal_rental_order" name="Rental Order Portal">
            <t t-call="portal.portal_layout">
                <t t-set="o_portal_fullwidth_alert" groups="hudson_rental.group_rental_user">
                    <t t-call="portal.portal_back_in_edit_mode">
                        <t t-set="backend_url" t-value="'/web#model=rental.order&amp;id=%s&amp;view_type=form' % order.id"/>
                    </t>
                </t>
                
                <div class="container">
                    <div class="row mt-4">
                        <div class="col-12">
                            <h3>Rental Order <span t-field="order.name"/></h3>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <strong>Customer:</strong> <span t-field="order.partner_id"/><br/>
                            <strong>Order Date:</strong> <span t-field="order.date_order" t-options="{'widget': 'date'}"/><br/>
                            <strong>Status:</strong> <span t-field="order.state"/>
                        </div>
                        <div class="col-md-6">
                            <strong>Pickup Date:</strong> <span t-field="order.pickup_date" t-options="{'widget': 'datetime'}"/><br/>
                            <strong>Return Date:</strong> <span t-field="order.return_date" t-options="{'widget': 'datetime'}"/><br/>
                            <t t-if="order.actual_return_date">
                                <strong>Actual Return:</strong> <span t-field="order.actual_return_date" t-options="{'widget': 'datetime'}"/><br/>
                            </t>
                        </div>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Rental Items</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Duration</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.order_line_ids" t-as="line">
                                        <tr>
                                            <td><span t-field="line.product_id"/></td>
                                            <td class="text-end"><span t-field="line.quantity"/></td>
                                            <td class="text-end"><t t-esc="round(line.duration_days, 1)"/> days</td>
                                            <td class="text-end"><span t-field="line.price_unit"/></td>
                                            <td class="text-end"><span t-field="line.price_total"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Subtotal:</strong></td>
                                    <td class="text-end"><span t-field="order.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Taxes:</strong></td>
                                    <td class="text-end"><span t-field="order.amount_tax"/></td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong>Total:</strong></td>
                                    <td class="text-end"><strong><span t-field="order.amount_total"/></strong></td>
                                </tr>
                                <t t-if="order.amount_deposit > 0">
                                    <tr>
                                        <td>Security Deposit:</td>
                                        <td class="text-end"><span t-field="order.amount_deposit"/></td>
                                    </tr>
                                </t>
                                <t t-if="order.amount_late_fee > 0">
                                    <tr>
                                        <td>Late Fees:</td>
                                        <td class="text-end"><span t-field="order.amount_late_fee"/></td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
