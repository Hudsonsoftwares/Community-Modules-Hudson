<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Rental Order Form View -->
        <record id="rental_order_view_form" model="ir.ui.view">
            <field name="name">rental.order.form</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <form string="Rental Order">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" 
                                invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_reserve" string="Reserve Stock" type="object" 
                                invisible="state != 'confirmed'" class="oe_highlight"/>
                        <button name="action_pickup" string="Pickup" type="object" 
                                invisible="state != 'reserved'" class="oe_highlight"/>
                        <button name="action_return" string="Return" type="object" 
                                invisible="state != 'picked_up'" class="oe_highlight"/>
                        <button name="action_done" string="Done" type="object" 
                                invisible="state != 'returned'" class="oe_highlight"/>
                        <button name="action_extend" string="Extend" type="object" 
                                invisible="state != 'picked_up'"/>
                        <button name="action_create_invoice" string="Create Invoice" type="object" 
                                invisible="state != 'returned'"/>
                        <button name="action_cancel" string="Cancel" type="object" 
                                invisible="state not in ('draft', 'confirmed')"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,confirmed,reserved,picked_up,returned,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" 
                                    class="oe_stat_button" icon="fa-pencil-square-o" 
                                    invisible="invoice_count == 0">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                            <button name="action_view_delivery" type="object" 
                                    class="oe_stat_button" icon="fa-truck" 
                                    invisible="delivery_count == 0">
                                <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" required="1"/>
                                <field name="date_order"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="pickup_date" required="1"/>
                                <field name="return_date" required="1"/>
                                <field name="actual_return_date" invisible="not actual_return_date"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Rental Lines">
                                <field name="order_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id" domain="[('is_rental', '=', True)]"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="product_uom" groups="uom.group_uom"/>
                                        <field name="duration_days"/>
                                        <field name="price_unit"/>
                                        <field name="tax_id" widget="many2many_tags"/>
                                        <field name="price_subtotal"/>
                                        <field name="rental_status"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                    <field name="amount_deposit" invisible="amount_deposit == 0"/>
                                    <field name="amount_late_fee" invisible="amount_late_fee == 0"/>
                                </group>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <group>
                                        <field name="sale_order_id" readonly="1"/>
                                        <field name="invoice_status"/>
                                    </group>
                                    <group>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                </group>
                                <field name="note" placeholder="Terms and conditions..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Rental Order Tree View -->
        <record id="rental_order_view_tree" model="ir.ui.view">
            <field name="name">rental.order.tree</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <list string="Rental Orders" decoration-info="state=='draft'" 
                      decoration-muted="state=='cancel'" decoration-success="state=='done'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date_order"/>
                    <field name="pickup_date"/>
                    <field name="return_date"/>
                    <field name="amount_total" sum="Total"/>
                    <field name="state" widget="badge" 
                           decoration-info="state in ('draft', 'confirmed')"
                           decoration-warning="state in ('reserved', 'picked_up')"
                           decoration-success="state == 'done'"/>
                    <field name="invoice_status" optional="hide"/>
                    <field name="user_id" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Rental Order Search View -->
        <record id="rental_order_view_search" model="ir.ui.view">
            <field name="name">rental.order.search</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <search string="Search Rental Orders">
                    <field name="name" string="Order"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <filter string="Quotations" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                    <filter string="In Progress" name="picked_up" domain="[('state', '=', 'picked_up')]"/>
                    <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                    <separator/>
                    <filter string="To Invoice" name="to_invoice" domain="[('invoice_status', '=', 'to_invoice')]"/>
                    <separator/>
                    <filter string="Pickup Date" name="filter_pickup_date" date="pickup_date"/>
                    <filter string="Return Date" name="filter_return_date" date="return_date"/>
                    <group>
                        <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                        <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'user_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                        <filter string="Pickup Date" name="group_pickup_date" context="{'group_by': 'pickup_date'}"/>
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Rental Order Kanban View -->
        <record id="rental_order_view_kanban" model="ir.ui.view">
            <field name="name">rental.order.kanban</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                    <field name="pickup_date"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="row g-0">
                                <div class="col-6">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-6 text-end">
                                    <strong><field name="amount_total" widget="monetary"/></strong>
                                </div>
                                <div class="col-12">
                                    <field name="partner_id"/>
                                </div>
                                <div class="col-8">
                                    <i class="fa fa-clock-o"/> <field name="pickup_date" widget="date"/>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Rental Order Action -->
        <record id="action_rental_order" model="ir.actions.act_window">
            <field name="name">Rental Orders</field>
            <field name="res_model">rental.order</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="rental_order_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new rental order
                </p>
                <p>
                    Rent products to customers and manage the full rental lifecycle.
                </p>
            </field>
        </record>

    </data>
</odoo>
