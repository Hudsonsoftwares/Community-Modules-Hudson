<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hudson_report_export_dms_wizard_form" model="ir.ui.view">
        <field name="name">hudson.report.export.dms.wizard.form</field>
        <field name="model">hudson.report.export.dms.wizard</field>
        <field name="arch" type="xml">
            <form string="Export">
                <group>
                    <field name="export_format" widget="radio" options="{'horizontal': true}"/>
                </group>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="directory_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                </group>
                <field name="report_data" invisible="1"/>
                <footer>
                    <button name="action_export" string="Export" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
