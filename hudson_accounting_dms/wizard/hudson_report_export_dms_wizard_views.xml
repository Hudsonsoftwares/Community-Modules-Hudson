<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hudson_report_export_dms_wizard_form" model="ir.ui.view">
        <field name="name">hudson.report.export.dms.wizard.form</field>
        <field name="model">hudson.report.export.dms.wizard</field>
        <field name="arch" type="xml">
            <form string="Export to Documents">
                <sheet>
                    <group>
                        <group>
                            <field name="export_format" widget="radio" options="{'horizontal': true}"/>
                            <field name="name"/>
                            <field name="report_data" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="wizard_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="directory_id" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export" string="Export" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
