<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Gateway clients ──────────────────────────────────────────────── -->
    <record id="view_hudson_ai_client_list" model="ir.ui.view">
        <field name="name">hudson.ai.client.list</field>
        <field name="model">hudson.ai.client</field>
        <field name="arch" type="xml">
            <list string="Gateway Clients">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="key_hint"/>
                <field name="tokens_this_month"/>
                <field name="monthly_token_limit"/>
                <field name="token_usage_percent" widget="progressbar"/>
                <field name="requests_today"/>
                <field name="daily_request_limit"/>
                <field name="last_used" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hudson_ai_client_form" model="ir.ui.view">
        <field name="name">hudson.ai.client.form</field>
        <field name="model">hudson.ai.client</field>
        <field name="arch" type="xml">
            <form string="Gateway Client">
                <header>
                    <button name="action_generate_key" type="object" string="Generate Key" class="btn-primary"
                            invisible="key_hint"/>
                    <button name="action_generate_key" type="object" string="Replace Key"
                            invisible="not key_hint"
                            confirm="The current key will stop working immediately. Continue?"/>
                    <button name="action_revoke_key" type="object" string="Revoke Key"
                            invisible="not key_hint"
                            confirm="The client will no longer be able to use the AI. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="monitoring">
                            <field name="tokens_this_month" widget="statinfo" string="Tokens this month"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Acme Ltd"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id"/>
                            <field name="key_hint" invisible="not key_hint"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Limits" help="0 means unlimited.">
                            <field name="monthly_token_limit"/>
                            <field name="token_usage_percent" widget="progressbar"/>
                            <field name="daily_request_limit"/>
                            <field name="requests_today"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hudson_ai_client_search" model="ir.ui.view">
        <field name="name">hudson.ai.client.search</field>
        <field name="model">hudson.ai.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hudson_ai_client" model="ir.actions.act_window">
        <field name="name">Gateway Clients</field>
        <field name="res_model">hudson.ai.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a client database</p>
            <p>Each client gets its own key and limits, and uses this database's AI provider.
               In the client's Odoo, choose the provider "Hudson AI Gateway" and paste the key.</p>
        </field>
    </record>

    <!-- One-time key display -->
    <record id="view_hudson_ai_client_key_form" model="ir.ui.view">
        <field name="name">hudson.ai.client.key.form</field>
        <field name="model">hudson.ai.client.key</field>
        <field name="arch" type="xml">
            <form string="New API Key">
                <div class="alert alert-warning" role="alert">
                    Copy this key now: it is shown only once. Enter these values in the client's
                    Odoo under Settings &gt; Hudson AI with provider "Hudson AI Gateway".
                </div>
                <group>
                    <field name="client_id"/>
                    <field name="gateway_url" string="Server URL" widget="CopyClipboardChar"/>
                    <field name="database" string="Gateway Database" widget="CopyClipboardChar"/>
                    <field name="key" string="API Key" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button name="action_done" type="object" string="Done" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Usage ─────────────────────────────────────────────────────────── -->
    <record id="view_hudson_ai_usage_list" model="ir.ui.view">
        <field name="name">hudson.ai.usage.list</field>
        <field name="model">hudson.ai.usage</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_id" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="feature"/>
                <field name="model" optional="hide"/>
                <field name="prompt_tokens" optional="hide" sum="Total"/>
                <field name="completion_tokens" optional="hide" sum="Total"/>
                <field name="total_tokens" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_hudson_ai_usage_pivot" model="ir.ui.view">
        <field name="name">hudson.ai.usage.pivot</field>
        <field name="model">hudson.ai.usage</field>
        <field name="arch" type="xml">
            <pivot string="AI Usage">
                <field name="date" interval="month" type="col"/>
                <field name="client_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="total_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hudson_ai_usage_graph" model="ir.ui.view">
        <field name="name">hudson.ai.usage.graph</field>
        <field name="model">hudson.ai.usage</field>
        <field name="arch" type="xml">
            <graph string="AI Usage" type="bar" stacked="1">
                <field name="date" interval="day"/>
                <field name="feature"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hudson_ai_usage_search" model="ir.ui.view">
        <field name="name">hudson.ai.usage.search</field>
        <field name="model">hudson.ai.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="client_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="today" string="Today"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="local" string="This Database" domain="[('client_id', '=', False)]"/>
                <filter name="gateway" string="Gateway Clients" domain="[('client_id', '!=', False)]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_feature" string="Feature" context="{'group_by': 'feature'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hudson_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">hudson.ai.usage</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>

    <!-- ── Access rules ──────────────────────────────────────────────────── -->
    <record id="view_hudson_ai_access_rule_list" model="ir.ui.view">
        <field name="name">hudson.ai.access.rule.list</field>
        <field name="model">hudson.ai.access.rule</field>
        <field name="arch" type="xml">
            <list string="AI Access Rules" editable="bottom">
                <field name="mode" widget="badge" decoration-danger="mode == 'block'" decoration-success="mode == 'allow'"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="group_ids" widget="many2many_tags" placeholder="Everybody"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_hudson_ai_access_rule" model="ir.actions.act_window">
        <field name="name">AI Access Rules</field>
        <field name="res_model">hudson.ai.access.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No extra rule</p>
            <p>By default each user can only ask the AI about data of the apps they can open.
               Add a <b>Block</b> rule to hide a model from some groups even if they can open it,
               or an <b>Allow</b> rule to let groups query a model without a menu.
               Odoo access rights always apply.</p>
        </field>
    </record>

</odoo>
