<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hudson_ai.Systray">
        <div class="o_hudson_ai_systray d-flex align-items-center">
            <button type="button" class="o_hudson_ai_systray_btn" title="Ask Hudson AI"
                    t-on-click="() => this.onClick()">
                <span class="o_ai_spark">✦</span>
                <span class="d-none d-md-inline">Ask AI</span>
            </button>
        </div>
    </t>

    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="this.state.thread.id" class="o_hudson_ai_chatter_btn btn btn-secondary text-nowrap"
                    title="Ask Hudson AI about this record" t-on-click="() => this.onClickHudsonAI()">
                <span class="o_ai_spark">✦</span> AI
            </button>
        </xpath>
    </t>

</templates>
