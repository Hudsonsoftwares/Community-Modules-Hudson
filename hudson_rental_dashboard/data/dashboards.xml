<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The file is built from the Sales dashboard by tools/build_dashboard.py. -->
    <record id="spreadsheet_dashboard_rental" model="spreadsheet.dashboard">
        <field name="name">Rental</field>
        <field name="spreadsheet_binary_data" type="bytes" file="hudson_rental_dashboard/data/files/rental_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('sale.model_sale_order')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.set([ref('hudson_rental.group_rental_manager'), ref('sales_team.group_sale_manager')])]"/>
        <field name="sequence">300</field>
        <field name="is_published">True</field>
    </record>

</odoo>
